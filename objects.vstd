_data_citation.py","sha256":"sha256:062b90e5764905e745e996012574631b413cefc96622e33ab1edf2f6f5c18bb2"},{"path":"src/verifier/domains/contracts/model_data_lineage.py","sha256":"sha256:eb59369693ce9bcd6f338eacb880580f93b922276619a65179c73b695a7adf4a"},{"path":"src/verifier/domains/contracts/model_hardware_observation.py","sha256":"sha256:10b569f2098caf2d89abe2b882b6243275b89ec587630f2f73e583e293e0f97b"},{"path":"src/verifier/domains/contracts/model_quantization.py","sha256":"sha256:da17938ca763368bb31046c3d97272fb1ccc3f592804b7f3265f5bbf5080925a"},{"path":"src/verifier/domains/contracts/model_train_citation.py","sha256":"sha256:14c25e1ded33ac0a481f02a91478f4402196296f02ac408f1adfad2962c60796"},{"path":"src/verifier/domains/model.py","sha256":"sha256:82ed1aaa4825001af5e10aaf9cf4edafce5c6998ae044879b3fb0226043c5d99"}],"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256":[{"path":"src/verifier/domains/model.py","sha256":"sha256:82ed1aaa4825001af5e10aaf9cf4edafce5c6998ae044879b3fb0226043c5d99"}],"sha256:f892a0750c04315455f7f587133b61a418ee5a9e6a441212cc0bea074315cbe8":[{"path":"src/verifier/domains/model.py","sha256":"sha256:82ed1aaa4825001af5e10aaf9cf4edafce5c6998ae044879b3fb0226043c5d99"},{"path":"src/verifier/domains/contracts/model_checks.py","sha256":"sha256:832c411794f580e69626c88a71c0c1b4a451ea87c0429a3ffcad6ca1616c8e03"},{"path":"src/verifier/domains/contracts/model_hardware_observation.py","sha256":"sha256:10b569f2098caf2d89abe2b882b6243275b89ec587630f2f73e583e293e0f97b"}]},"kind":"MODEL","object_id":"vstd-model","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"Explicit local checker invocation plus operating-system process permissions authorize only the fixed worker and selected limits; no authority over external systems or model deployment is inferred.","commands":"Create the fixed installed CPython worker, assign it to the owned Windows Job Object, apply the selected committed-memory cap and time/output bounds, resume it, and supply the exact canonical workload.","effect_domains":"SOFTWARE_PROCESS_ONLY: local process creation, scheduling, committed-memory enforcement, pipe input/output, termination, and cleanup on the selected Windows host.","targets":"The owned local child process and its Job Object only; the command does not target a physical actuator, external model service, user workload, or arbitrary caller-supplied code."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 commands a fixed local child process and Job Object under selected caps. Its effect domain is the owned software process only, not a physical actuator or deployed model endpoint. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"Caps, payload and certificate bytes, operations, trials, wall time, output, evidence objects and composition work are finite and selected under installed ceilings.","response":"The parent observes applied limits before resume, timeout/output flags, child exit, stdout/stderr, owned-job cleanup, and either a bounded RESOURCE_EXHAUSTED or exact PASS record.","saturation":"Lower-cap memory saturation must appear as the exact bounded RESOURCE_EXHAUSTED record; upper-cap saturation, ambiguous failure, or any other status cannot be interpreted as success.","units_and_frames":"Committed-memory limits are bytes, wall bounds are seconds, operations and trials are dimensionless, and all effects are framed to the owned Job Object and exact child process."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 commands a fixed local child process and Job Object under selected caps. Its effect domain is the owned software process only, not a physical actuator or deployed model endpoint. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.3-feedback-and-interlocks":{"declaration":{"effect_feedback":"Parent-side backend metadata, exit state and captured streams report the selected process effect boundary; they do not observe physical hardware state or undeclared operating-system effects.","failure_states":"Launch or enforcement unavailable, timeout, output exhaustion, nonzero exit, stderr, malformed response, wrong output, cap mismatch, remaining owned process, or cleanup ambiguity yields UNKNOWN or FAIL.","interlocks":"The child remains suspended until Job Object ownership and limits are verified; fixed source, isolated interpreter flags, bounded pipes, timeout, expected output and empty owned job are required.","recovery":"The backend attempts bounded ownership and cleanup; no external rollback is claimed, and another observation requires a fresh process under a freshly validated selection."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 commands a fixed local child process and Job Object under selected caps. Its effect domain is the owned software process only, not a physical actuator or deployed model endpoint. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"NOT_ESTABLISHED","precision":"NOT_ESTABLISHED","rights":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-asset-vstd-model-76de55dca99a; fulfillment NOT_ESTABLISHED."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"NOT_ESTABLISHED","issuance_authority":"NOT_ESTABLISHED","redemption":"NOT_ESTABLISHED","supply_changes":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e