ve-time checks precede vote counting; valid veto or denial prevents approval, quorum is necessary, and current revocation or consumption status is authoritative within the selected root.","scope":"GovernancePolicy applies to exact object names, operations, jurisdictions, effective interval, principals, quorum, veto actors, status root, and selected invocation binding."},"evidence_set_digest":"sha256:18398fb1d9b855036e93f246b0ebf3027f7045d5b7cef9c15d9eb227d74ab08e","reason":"Governance evaluation implements scoped rules, effective intervals, principal authority, quorum, veto, revocation, consumption, and fail-closed verdicts. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"The policy is active only inside its effective interval and for the exact caller-selected binding and current signed status.","authority":"The trusted caller selects policy, principal keys, status key, time, and jurisdiction; signatures bind records but do not prove personhood, legal authority, or jurisdictional truth.","exceptions":"Only exact policy-scoped principals, veto terms, and retained status exceptions are recognized; undeclared actors and scopes are not admitted.","revisions":"Policy revision and digest change with retained terms; changed principals, scopes, keys, quorum, veto, interval require a distinct evaluation coordinate."},"evidence_set_digest":"sha256:18398fb1d9b855036e93f246b0ebf3027f7045d5b7cef9c15d9eb227d74ab08e","reason":"Governance evaluation implements scoped rules, effective intervals, principal authority, quorum, veto, revocation, consumption, and fail-closed verdicts. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Out-of-scope, unsigned, unknown-key, expired, revoked, consumed, duplicate, denied, vetoed, or insufficient-quorum records cannot produce approval.","decision_evidence":"GovernanceEvaluation retains checks, captured binding, time, policy identity/revision/digest, approvals, vetoes, and status facts.","enforcement_points":"evaluate_governance and recheck_governance return bounded verdicts to cooperating callers; they do not execute, permit, or block the downstream operation themselves.","unavailable_behavior":"Unavailable trusted policy, evaluation time, status, keys, or adequate valid decisions leaves governance approval unestablished."},"evidence_set_digest":"sha256:18398fb1d9b855036e93f246b0ebf3027f7045d5b7cef9c15d9eb227d74ab08e","reason":"Governance evaluation implements scoped rules, effective intervals, principal authority, quorum, veto, revocation, consumption, and fail-closed verdicts. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18398fb1d9b855036e93f246b0ebf3027f7045d5b7cef9c15d9eb227d74ab08e","reason":"reasons.vstd:tier0-protocol-vstd-governance-policy-b7037c22b856; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18398fb1d9b855036e93f246b0ebf3027f7045d5b7cef9c15d9eb227d74ab08e","reason":"reasons.vstd:tier0-protocol-vstd-governance-policy-b7037c22b856; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18398fb1d9b855036e93f246b0ebf3027f7045d5b7cef9c15d9eb227d74ab08e"