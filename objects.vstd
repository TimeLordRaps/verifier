},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-market-vstd-sim-resource-measurement-329b55447181; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-market-vstd-sim-resource-measurement-329b55447181; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-market-vstd-sim-resource-measurement-329b55447181; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"A fresh source-loaded worker validates the trajectory, starts tracemalloc, brackets the actual transition with time.thread_time_ns, reads traced peak allocation, and stops tracing for every selected step.","observation_vs_estimate":"thread_cpu_ns and traced_peak_bytes are direct software-instrument observations for the selected interval. They are not estimates of wall time, process-wide memory, device use, energy, or physical resource consumption.","phenomenon":"Per selected simulated transition, the observed phenomena are CPython current-thread CPU elapsed time and peak Python allocation traced during that transition.","source":"The source is the current invocation's fresh CPython worker and the exact loaded SIM transition and resource-measurement source manifests; retained readings and native specimens are not accepted."},"evidence_set_digest":"sha256:ad1031f3bce390de6dbb32c29f3784023952a67e0bae5f26ffd4674ac72f79f5","reason":"The route directly observes bounded current-thread CPU time and peak traced Python allocation for every selected SIM transition, so measurement meaning, units, correspondence, missingness, freshness, and provenance must be declared. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"The parent receives the complete bounded worker response after the fresh subprocess exits; internal pipe and scheduler latency are not separately measured.","observation_time":"The CPU clock is sampled immediately before and after each actual transition. No UTC or historical occurrence time is claimed.","reference_frame":"Every row is relative to one fresh run_id and process_id, its exact workload digest, ordered step index, and input/output state digests on the selected CPython version.","uncertainty":"CPython clock and tracer semantics, interpreter overhead, scheduling, allocator behavior, and the host operating system remain trusted and unquantified; no physical calibration or statistical interval is asserted.","units":"thread_cpu_ns is a nonnegative integer number of nanoseconds; traced_peak_bytes is a nonnegative integer number of bytes. Both are bounded at 2^63-1."},"evidence_set_digest":"sha256:ad1031f3bce390de6dbb32c29f3784023952a67e0bae5f26ffd4674ac72f79f5","reason":"The route directly observes bounded current-thread CPU time and peak traced Python allocation for every selected SIM transition, so measurement meaning, units, correspondence, missingness, freshness, and provenance must be declared. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"Two independent acquisitions must use distinct fresh challenges and run identifiers. Each observation is current only for its invocation and cannot be replayed as a later measurement.","missingness":"Unavailable or timed-out transport, acquisition exceptions, malformed or missing steps, invalid metrics, and source drift yield no successful capture or an explicit refusal; missing observations are never replaced with zero.","provenance":"Each result binds selected and loaded source manifests, bootstrap digest, challenge, workload digest, method, CPython target, run/process identity, step indexes, and state digests.","validity":"Validity requires current selected and loaded source manifests, fresh challenge and run identity, exact workload and state correspondence, complete ordered step coverage, correct types, and bounded nonnegative values."},"evidence_set_digest":"sha256:ad1031f3bce390de6dbb32c29f3784023952a67e0bae5f26ffd4674ac72f79f5","reason":"The route directly observes bounded current-thread CPU time and peak traced Python allocation for every selected SIM transition, so measurement meaning, units, correspondence, missingness, freshness, and provenance must be declared. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"NOT_ESTABLISHED","defaults":"NOT_ESTABLISHED","precedence":"NOT_ESTABLISHED","scope":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:sim-resource-measurement-policy-applies; fulfillment NOT_ESTABLISHED."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"NOT_ESTABLISHED","authority":"NOT_ESTABLISHED","exceptions":"NOT_ESTABLISHED","revisions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:sim-resource-measurement-policy-applies; fulfillment NOT_ESTABLISHED."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"NOT_ESTABLISHED","decision_evidence":"NOT_ESTABLISHED","enforcement_points":"NOT_ESTABLISHED","unavailable_behavior":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:sim-resource-measurement-policy-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-protocol-vstd-sim-resource-measurement-f29cbbb8ae99; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-protocol-vstd-sim-resource-measurement-f29cbbb8ae99; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-protocol-vstd-sim-resource-measurement-f29cbbb8ae99; fulfillment NOT_ESTABLISHED."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-robot-vstd-sim-resource-measurement-57df7127a2c6; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-robot-vstd-sim-resource-measurement-57df7127a2c6; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-robot-vstd-sim-resource-measurement-57df7127a2c6; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"A fresh isolated Python worker directly calls time.thread_time_ns and tracemalloc around actual source-loaded SIM transitions and returns a bounded typed response.","deployment":"Deployment is the newly launched local CPython worker selected by the current Verifier invocation; it is not a physical sensor, device monitor, hostile-host attestor, or sandbox.","measurements":"Measurements are complete ordered step rows bound to exact input/output state digests, with nonnegative integer thread_cpu_ns and traced_peak_bytes values.","phenomena":"The acquired software phenomena are current-thread CPU elapsed nanoseconds and peak traced Python allocation bytes for each selected transition interval."},"evidence_set_digest":"sha256:ad1031f3bce390de6dbb32c29f3784023952a67e0bae5f26ffd4674ac72f79f5","reason":"The fresh worker actively acquires those observations through CPython clock and tracer interfaces, so acquisition, applicability of calibration, sampling, drift, latency, fault, and cleanup boundaries are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"Physical calibration is inapplicable to this software-only route. Applicability is limited to the pinned semantics of CPython's thread CPU clock and allocation tracer.","calibration_evidence":"Exact controlled clocks and tracers check interval arithmetic, peak selection, cleanup, and typing, but do not constitute physical calibration or operating-system accuracy evidence.","drift":"Interpreter version and source bytes are recaptured and compared. Scheduler, operating-system, allocator, clock, and tracer behavioral drift are not quantified.","operating_range":"The accepted range is a finite selected trajectory with complete steps and integer metrics from zero through 2^63-1 under the current CPython target and bounded worker response."},"evidence_set_digest":"sha256:ad1031f3bce390de6dbb32c29f3784023952a67e0bae5f26ffd4674ac72f79f5","reason":"The fresh worker actively acquires those observations through CPython clock and tracer interfaces, so acquisition, applicability of calibration, sampling, drift, latency, fault, and cleanup boundaries are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"Injected clock-start, clock-end, transition, allocation-read, invalid-trajectory, malformed-record, source-drift, unavailable, and timeout cases must refuse rather than return a complete observation.","latency":"The parent bounds the fresh subprocess by the selected timeout, but makes no guarantee about scheduler latency, internal sampling delay, or real-time response.","recovery":"Tracing is stopped in a finally boundary after acquisition faults. Recovery requires a separate fresh source-bound run; an unavailable reading remains unknown and cached values are not promoted.","sampling":"For each validated step the route performs start tracer, sample CPU clock, execute transition, sample CPU clock, read peak allocation, and stop tracer; validation occurs outside the measured interval."},"evidence_set_digest":"sha256:ad1031f3bce390de6dbb32c29f3784023952a67e0bae5f26ffd4674ac72f79f5","reason":"The fresh worker actively acquires those observations through CPython clock and tracer interfaces, so acquisition, applicability of calibration, sampling, drift, latency, fault, and cleanup boundaries are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"NOT_ESTABLISHED","effects":"NOT_ESTABLISHED","preconditions":"NOT_ESTABLISHED","resources":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-transaction-vstd-sim-resource-measurement-9b2d7b66851b; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"NOT_ESTABLISHED","commit":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","partial_failure":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-transaction-vstd-sim-resource-measurement-9b2d7b66851b; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"NOT_ESTABLISHED","idempotency":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED","retry_limits":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:517c261e19098940b2baeb9f272f3ec191847eabdd5d5cd9639913c9927cdd56","reason":"reasons.vstd:tier0-transaction-vstd-sim-resource-measurement-9b2d7b66851b; fulfillment NOT_ESTABLISHED."}},"operands":{},"payload":{"representation_role":"Source-bound fresh acquisition and independent checks for selected SIM transition CPU-time and traced-allocation observations."},"reason":"The shipped route directly acquires bounded software resource observations and exercises missingness and instrument-fault behavior, which generic VERIFIER ownership cannot express. Boundary: Observations are CPython thread CPU nanoseconds and tracemalloc peak bytes for fixed selected SIM transitions only; no physical calibration, device accounting, whole-SIM fidelity, actuation, availability or confinement claim is made.","specializations":["SENSOR"],"surfaces":["file:src/verifier/runtime/resource_measurement_execution.py","python:src/verifier/runtime/resource_measurement_execution.py:<module>","python:src/verifier/runtime/resource_measurement_execution.py:catalog","python:src/verifier/runtime/resource_measurement_execution.py:_claim_scope","python:src/verifier/runtime/resource_measurement_execution.py:_equal","python:src/verifier/runtime/resource_measurement_execution.py:_strip","python:src/verifier/runtime/resource_measurement_execution.py:_sensor_digest","python:src/verifier/runtime/resource_measurement_execution.py:_workload_digest","python:src/verifier/runtime/resource_measurement_execution.py:_frame_fields","python:src/verifier/runtime/resource_measurement_execution.py:_step_binding","python:src/verifier/runtime/resource_measurement_execution.py:_sampling_binding","python:src/verifier/runtime/resource_measurement_execution.py:_interval_ok","python:src/verifier/runtime/resource_measurement_execution.py:_capture_shape","python:src/verifier/runtime/resource_measurement_execution.py:_timing_ordered","python:src/verifier/runtime/resource_measurement_execution.py:_arrival_distinct","python:src/verifier/runtime/resource_measurement_execution.py:_latency_bounded","python:src/verifier/runtime/resource_measurement_execution.py:_capture_bound","python:src/verifier/runtime/resource_measurement_execution.py:_captures","python:src/verifier/runtime/resource_measurement_execution.py:_faults","python:src/verifier/runtime/resource