-time-and-uncertainty":{"declaration":{"arrival_time":"NOT_ESTABLISHED","observation_time":"NOT_ESTABLISHED","reference_frame":"NOT_ESTABLISHED","uncertainty":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"reasons.vstd:tier0-measurement-vstd-release-source-binding-44a0bd4b6ffb; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"NOT_ESTABLISHED","missingness":"NOT_ESTABLISHED","provenance":"NOT_ESTABLISHED","validity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"reasons.vstd:tier0-measurement-vstd-release-source-binding-44a0bd4b6ffb; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"One exact selection record, supplied bytes for every selected source/release/inventory/harness path, installed mechanism source, and optional cancellation flag.","defaults":"Missing input remains UNKNOWN, mismatch FAILS, unsupported script grammar or exhausted capacity remains explicit, and no absent inventory member can be inferred.","precedence":"Selection schema and path references precede byte lookup; all role/source/inventory/harness commitments are checked before aggregate binding status and bounded report size.","scope":"Compare one externally selected subject, five-artifact release tuple, full selected source inventory, public/applicability inventories, console aliases, and harness records to supplied exact bytes."},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"The release-source byte-binding policy applies as POLICY. Its rule selection, authority boundary, defaults, exceptions, and enforcement points determine the bounded result. Reviewed boundary: Equality to selected commitments proves no source/public inventory completeness, selector authority, native replay, loaded execution, human acceptance, polished admission, publication, or release permission. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"Selected, paths normalized/unique, files matched/missing/mismatched, aliases assessed/unassessed, cancelled/exhausted, binding PASS/FAIL/UNKNOWN, and report returned.","authority":"The selector and commitments are external inputs; equality to them does not establish selector authority, inventory completeness, loaded execution, human acceptance, release permission, or application-profile adoption.","exceptions":"Selection/file/report bytes, file/node/depth counts, fixed five release roles, exact digests, canonical relative paths, and supported scripts grammar are bounded.","revisions":"Strict-decode a finite selection, enforce portable NFC path uniqueness, hash bounded supplied bytes, parse only a literal project.scripts grammar, and report exact commitment equality."},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"The release-source byte-binding policy applies as POLICY. Its rule selection, authority boundary, defaults, exceptions, and enforcement points determine the bounded result. Reviewed boundary: Equality to selected commitments proves no source/public inventory completeness, selector authority, native replay, loaded execution, human acceptance, polished admission, publication, or release permission. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Selection/file/report bytes, file/node/depth counts, fixed five release roles, exact digests, canonical relative paths, and supported scripts grammar are bounded.","decision_evidence":"Supplied exact bytes, selected path/digest references, literal console aliases, harness records, and equality/missingness findings only.","enforcement_points":"Strict-decode a finite selection, enforce portable NFC path uniqueness, hash bounded supplied bytes, parse only a literal project.scripts grammar, and report exact commitment equality.","unavailable_behavior":"Missing input remains UNKNOWN, mismatch FAILS, unsupported script grammar or exhausted capacity remains explicit, and no absent inventory member can be inferred."},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"The release-source byte-binding policy applies as POLICY. Its rule selection, authority boundary, defaults, exceptions, and enforcement points determine the bounded result. Reviewed boundary: Equality to selected commitments proves no source/public inventory completeness, selector authority, native replay, loaded execution, human acceptance, polished admission, publication, or release permission. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"reasons.vstd:tier0-protocol-vstd-release-source-binding-e02970ac12c8; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:7c64d3e35b356124898d7a8c0a46ff2516f0566748479ff35eebd0c94a93c751","reason":"reasons.vstd:tier0-protocol-vstd-release-source-binding-e02970ac12c8; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":