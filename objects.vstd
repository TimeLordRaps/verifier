its":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:3f104e027addeafafb181569009023864a079b9de2c9c6f95da5d113c89304b4","reason":"reasons.vstd:tier0-transaction-vstd-dataset-provenance-policy-7233a0c5134c; fulfillment NOT_ESTABLISHED."}},"operands":{},"payload":{"representation_role":"Formal SAT-backed policy decisions over dataset and computational provenance graphs."},"reason":"Provenance acceptance needs explicit rule grounding and decision correspondence rather than an undifferentiated DATA label. Boundary: A checked decision is not proof that every producer or consumer enforced the selected policy.","specializations":[],"surfaces":["file:src/verifier/data/policy.py","python:src/verifier/data/policy.py:<module>","python:src/verifier/data/policy.py:PolicyEncodingError","python:src/verifier/data/policy.py:PolicyEncodingError.__init__","python:src/verifier/data/policy.py:_policy_subjects","python:src/verifier/data/policy.py:ground_policy_cnf","python:src/verifier/data/policy.py:_require_every_variable_bound","python:src/verifier/data/policy.py:_policy_binding","python:src/verifier/data/policy.py:certify_policy_cnf","python:src/verifier/data/policy.py:_str_int_mapping","python:src/verifier/data/policy.py:_str_str_mapping","python:src/verifier/data/policy.py:PolicyDecisionEvidence","python:src/verifier/data/policy.py:PolicyDecisionEvidence.to_dict","python:src/verifier/data/policy.py:PolicyDecisionEvidence.from_dict","python:src/verifier/data/policy.py:check_policy_decision","python:src/verifier/data/policy.py:PolicyEvaluationResult","python:src/verifier/data/policy.py:PolicyEvaluationResult.decision_evidence","python:src/verifier/data/policy.py:PolicyEvaluationResult.to_dict","python:src/verifier/data/policy.py:_refuse_undecidable","python:src/verifier/data/policy.py:_indeterminate","python:src/verifier/data/policy.py:ProvenancePolicyVerifier","python:src/verifier/data/policy.py:ProvenancePolicyVerifier.verify_no_revoked_ancestors","python:src/verifier/data/policy.p