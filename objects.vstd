et_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-sensor-vstd-precommitment-ledger-e964bc350b44; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-sensor-vstd-precommitment-ledger-e964bc350b44; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The direct caller selects and records the envelope; declarant strings and optional anchor signatures are retained assertions, not authenticated external authority here.","effects":"PrecommitmentLedger.record inserts one validated immutable envelope into the local in-memory envelope map.","preconditions":"The envelope id must be new or bound to exactly equal content, and any separately checked anchor must match its digest; record() does not run the required-degree validator (layer4/precommit.py:334-339).","resources":"Resources are one ledger map, one bounded typed envelope and its commitment tuple, and any independently selected AnchorProvider result."},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"Recording an envelope is a fork-checked local map assignment with exact duplicate idempotency, fork abort, local finality, and a separate-anchor boundary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Same-id forks with differing content raise PrecommitmentError before the differing envelope can replace retained state (layer4/precommit.py:336-337).","commit":"Commit is the single map assignment after the fork check; a returned envelope is present in the current process ledger.","finality":"The same envelope_id is immutable inside that ledger instance; durable, globally witnessed, or externally enforced precommitment finality is not established.","partial_failure":"The local record mutation is one map assignment with no declared external effect; optional anchoring is a separate operation and is not atomically committed with this map."},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"Recording an envelope is a fork-checked local map assignment with exact duplicate idempotency, fork abort, local finality, and a separate-anchor boundary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"An existing envelope_id is compared for exact equality; equal replay returns the argument and differing replay is rejected as a fork (layer4/precommit.py:339).","idempotency":"Recording the exact same envelope is idempotent within one retained ledger instance.","replay":"Replay must preserve exact envelope id and content; audit replay compares selections without executing the committed evaluation or disclosure policy.","retry_limits":"No automatic retry is performed; callers may repeat only the exact same envelope after inspecting any separate anchor outcome."},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"Recording an envelope is a fork-checked local map assignment with exact duplicate idempotency, fork abort, local finality, and a separate-anchor boundary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Append-only precommitment selections, degrees of freedom and violation audit history."},"reason":"A declared evaluation envelope needs authoritative ordering and retained deviations to prevent post-result rewriting. Recording an envelope is a fork-checked local map assignment with exact duplicate idempotency, fork abort, local finality, and a separate-anchor boundary. Boundary: Precommitment history is not an asset, market or real-money ledger.","specializations":["TRANSACTION"],"surfaces":["file:src/verifier/layer4/precommit.py","python:src/verifier/layer4/precommit.py:<module>","python:src/verifier/layer4/precommit.py:PrecommitmentError","python:src/verifier/layer4/precommit.py:DegreeOfFreedom","python:src/verifier/layer4/precommit.py:Commitment","python:src/verifier/layer4/precommit.py:Commitment.to_dict","python:src/verifier/layer4/precommit.py:EnvelopeCheck","python:src/verifier/layer4/precommit.py:EnvelopeCheck.to_dict","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.to_dict","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.digest","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.content_digest","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.anchor","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.verify_anchor","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.value_of","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.committed_at","python:src/verifier/layer4/precommit.py:PrecommitmentEnvelope.validate","python:src/verifier/layer4/precommit.py:ObservedSelection","python:src/verifier/layer4/precommit.py:ObservedSelection.to_dict","python:src/verifier/layer4/precommit.py:PrecommitmentViolation","python:src/verifier/layer4/precommit.py:PrecommitmentViolation.to_dict","python:src/verifier/layer4/precommit.py:PrecommitmentAudit","python:src/verifier/layer4/precommit.py:PrecommitmentAudit.to_dict","python:src/verifier/layer4/precommit.py:audit_selections","python:src/verifier/layer4/precommit.py:PrecommitmentLedger","python:src/verifier/layer4/precommit.py:PrecommitmentLedger.__init__","python:src/verifier/layer4/precommit.py:PrecommitmentLedger.record","python:src/verifier/layer4/precommit.py:PrecommitmentLedger.get","python:src/verifier/layer4/precommit.py:PrecommitmentLedger.__len__"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:83a54adec8356655cf1fd14f4123c16b595e13e5308434033111c3ad44d4ca76","reason":"vstd-privacy-certificate-verifier is explicitly DOES_NOT_APPLY for ACTUATOR after a current-source audit. Exact owned source denominator: src/verifier/domains/contracts/privacy_checks.py. Representation boundary: Source-bound disclosure and privacy-certificate verification. Necessity boundary: The verifier observes selected disclosure records and applies explicit privacy policy. Consequence boundary: A complete selected record is not privacy-law compliance, external authority, or enforcement. Kind-specific defining-mechanism refutation: the owned bytes submit no command, callback, write, process, network request, or other bounded effect outside pure representation or computation. Fixed operands: none.","status":"DOES_NOT_APPLY"},"AGENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ARCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ASSET":{"evidence_set_digest":"sha256:83a54adec8356655cf1fd14f4123c16b595e13e5308434033111c3ad44d4ca76","reason":"vstd-privacy-certificate-verifier is explicitly DOES_NOT_APPLY for ASSET after a current-source audit. Exact owned source denominator: src/verifier/domains/contracts/privacy_checks.py. Representation boundary: Source-bound disclosure and privacy-certificate verification. Necessity boundary: The verifi