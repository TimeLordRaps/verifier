local BytesIO sink and counters on shared host memory."},"evidence_set_digest":"sha256:4f8dcfff4d3d55a30fa529971fd3f3b3157254b0d366b81add791d44ccb41a7e","reason":"The software one-way-diode emulator applies as ACTUATOR. It accepts a command and changes the named local target while keeping downstream, physical, and external effects explicitly separate. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"The object accepts bytes while open, always refuses reverse reads, and forces software-emulation, invalid-hardware-attestation, and TIER_1_LOCAL receipt markers.","response":"Returned write length, counters, closed-state refusals, test-only sink contents, and the degraded receipt are process-local observations.","saturation":"Closed pushes and all read/recv/peek attempts raise explicit containment errors; receipt fields that imply hardware or a higher tier are rejected.","units_and_frames":"Units are bytes written and discrete push messages in one process-local emulator instance."},"evidence_set_digest":"sha256:4f8dcfff4d3d55a30fa529971fd3f3b3157254b0d366b81add791d44ccb41a7e","reason":"The software one-way-diode emulator applies as ACTUATOR. It accepts a command and changes the named local target while keeping downstream, physical, and external effects explicitly separate. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.3-feedback-and-interlocks":{"declaration":{"effect_feedback":"Returned write length, counters, closed-state refusals, test-only sink contents, and the degraded receipt are process-local observations.","failure_states":"Closed pushes and all read/recv/peek attempts raise explicit containment errors; receipt fields that imply hardware or a higher tier are rejected.","interlocks":"Accepted pushes append in call order; close prevents later pushes; every reverse-channel method refuses unconditionally.","recovery":"Create or explicitly manage a fresh emulator and resend selected bytes; no external delivery, isolation, or hardware recovery is represented."},"evidence_set_digest":"sha256:4f8dcfff4d3d55a30fa529971fd3f3b3157254b0d366b81add791d44ccb41a7e","reason":"The software one-way-diode emulator applies as ACTUATOR. It accepts a command and changes the named local target while keeping downstream, physical, and external effects explicitly separate. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"NOT_ESTABLISHED","precision":"NOT_ESTABLISHED","rights":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4f8dcfff4d3d55a30fa529971fd3f3b3157254b0d366b81add791d44ccb41a7e","reason":"reasons.vstd:tier0-asset-vstd-software-diode-effect-5b77f2342edc; fulfillment NOT_ESTABLISHED."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"NOT_ESTABLISHED","issuance_authority":"NOT_ESTABLISHED","redemption":"NOT_ESTABLISHED","supply_changes":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4f8dcfff4d3d55a30fa529971fd3f3b3157254b0d366b81add791d44ccb41a7e","reason":"reasons.vstd:tier0-asset-vstd-software-diode-effect-5b77f2342edc; fulfillment NOT_ESTABLISHED."},"ASSET-0.3-custody-and-encumbrance":{"declaration":{"control":"NOT_ESTABLISHED","custody":"NOT_ESTABLISHED","encumbrances":"NOT_ESTABLISHED","reconciliation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4f8dcfff4d3d55a30fa529971fd3f3b3157254b0d366b81add791d44ccb41a7e","reason":"reasons.vstd:tier0-asset-vstd-software-diode-effect-5b77f2342edc; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.1-feedback-and-authority":{"declaration":{"authority":"NOT_ESTABLISHED","commands":"NOT_ESTABLISHED","feedback":"NOT_ESTABLISHED","objectives":"NOT_ESTABLISHED"},"evidence_set_digest":"