"reasons.vstd:tier0-controller-vstd-precommitment-ledger-64b6b9615805; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.2-timing-and-stability":{"declaration":{"operating_envelope":"NOT_ESTABLISHED","saturation":"NOT_ESTABLISHED","stability_assumptions":"NOT_ESTABLISHED","timing":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-controller-vstd-precommitment-ledger-64b6b9615805; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"NOT_ESTABLISHED","failure_behavior":"NOT_ESTABLISHED","feedback_loss":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-controller-vstd-precommitment-ledger-64b6b9615805; fulfillment NOT_ESTABLISHED."},"FINBOT-0.1-agent-and-financial-authority":{"declaration":{"agent":"NOT_ESTABLISHED","decision_scope":"NOT_ESTABLISHED","financial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-finbot-vstd-precommitment-ledger-255c6bddfcff; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-finbot-vstd-precommitment-ledger-255c6bddfcff; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-finbot-vstd-precommitment-ledger-255c6bddfcff; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"The declarant and caller supply commitments and times; an optional selected AnchorProvider binds content but does not establish external identity or honest clocks.","history":"PrecommitmentLedger owns one immutable envelope per envelope_id, each committing the verdict-material degrees of freedom before selected evidence is observed.","ordering":"Each commitment carries committed_at; audit compares selection and commitment times to evidence_observed_at, while same-id envelopes cannot fork.","state":"State is the exact retained PrecommitmentEnvelope, its commitments, content digest, and optional continuity anchor; audit selections are supplied per call and are not retained by the ledger."},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"PrecommitmentLedger is the authoritative local immutable map of verdict-material envelopes, with fork rejection and deterministic audit reconciliation. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"Same-id content is immutable and anchors bind the content digest; the required-degree check runs in audit_selections, not in record(), which admits any envelope whose id is new (layer4/precommit.py:334-339), and used selections must match timely commitments.","rounding":"Values, digests, and timestamp strings are compared exactly; no floating-point or monetary rounding is involved.","sources_and_sinks":"Validated envelopes enter through record and remain in the in-memory map; there is no deletion, replacement, or compaction method.","units":"Units are discrete envelope ids, degree-of-freedom names, canonical values, timestamps, digests, and violation records; no monetary balance exists."},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"PrecommitmentLedger is the authoritative local immutable map of verdict-material envelopes, with fork rejection and deterministic audit reconciliation. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"A retained envelope cannot be corrected in place. A changed commitment needs a different envelope identity and remains distinguishable from the earlier record.","reconciliation":"Envelope content reconciles against all required degrees, selected values/times, evidence observation times, and the optional exact anchor digest.","recovery":"Recovery requires externally retaining and re-recording the complete envelope and anchor; this in-memory map provides no durable persistence or distributed recovery.","replay":"The same envelope and observed selections reproduce validation and audit violations, subject to the same exact timestamps and optional anchor record."},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"PrecommitmentLedger is the authoritative local immutable map of verdict-material envelopes, with fork rejection and deterministic audit reconciliation. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c93d9f1050f445db3c6fa66e3410fe68db1d12e8b00e2e1000c7c9e36ecb258e","reason":"reasons.vstd:tier0-market-vstd-precommitment-ledger-7badf0a570ce; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaratio