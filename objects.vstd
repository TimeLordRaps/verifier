6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-finbot-vstd-challenge-record-ledger-70384144e008; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-finbot-vstd-challenge-record-ledger-70384144e008; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-finbot-vstd-challenge-record-ledger-70384144e008; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"The local ledger enforces shape and transition rules while retaining challenger and adjudicator identifiers; it does not authenticate those actors or confer external enforcement authority.","history":"ChallengeLedger owns one append-only sequence of filed challenge and final adjudication records for claim identifiers.","ordering":"Record sequence is append order, challenge identity is unique, a challenge must precede its adjudication, and each challenge has at most one final adjudication.","state":"ClaimStatus is derived from the complete applicable record set; status is never a mutable field sealed into an earlier record."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"The source owns append-only filing and adjudication history from which current claim status is derived without rewriting prior records. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"Duplicate challenge ids, missing challenges, and second adjudications are rejected; inadmissible filings are recorded as REFUSED (layer4/challenge.py:239-243), and claim status is the most degraded derived status.","rounding":"No rounding occurs; identifiers, enumerated outcomes, digests, timestamps, and statuses are compared exactly.","sources_and_sinks":"Records enter through file or adjudicate and are never edited or removed; projections consume the full retained prefix without deleting history.","units":"Units are discrete challenges, adjudications, claims, surfaces, exclusions, and artifact-status values; there are no financial balances."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"The source owns append-only filing and adjudication history from which current claim status is derived without rewriting prior records. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"A final adjudication cannot be overwritten. A genuinely different issue requires a separately identified challenge and remains visible in history.","reconciliation":"records and status reconcile by recomputing each claim from its filed and adjudicated entries; external sanctions or claim publication are outside scope.","recovery":"Recovery requires the complete valid append-only record set; this in-memory implementation provides no durable store, backup, or concurrent-writer recovery.","replay":"Serializing and replaying the same ordered record set reproduces derived claim status when the same refutation surface is selected."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"The source owns append-only filing and adjudication history from which current claim status is derived without rewriting prior records. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-market-vstd-challenge-record-ledger-6be98920cb16; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-market-vstd-challenge-record-ledger-6be98920cb16; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-market-vstd-challenge-record-ledger-6be98920cb16; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"NOT_ESTABLISHED","observation_vs_estimate":"NOT_ESTABLISHED","phenomenon":"NOT_ESTABLISHED","source":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-measurement-vstd-challenge-record-ledger-de017a25b976; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"NOT_ESTABLISHED","observation_time":"NOT_ESTABLISHED","reference_frame":"NOT_ESTABLISHED","uncertainty":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-measurement-vstd-challenge-record-ledger-de017a25b976; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"NOT_ESTABLISHED","missingness":"NOT_ESTABLISHED","provenance":"NOT_ESTABLISHED","validity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-measurement-vstd-challenge-record-ledger-de017a25b976; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"Inputs are challenge kind and target, surface categories and exclusions with reasons, filed records, terminal adjudications, and current artifact statuses.","defaults":"A category outside the admitted surface or explicitly excluded is refused; missing adjudication remains an unresolved filed challenge rather than an invented favorable result.","precedence":"Explicit surface exclusions refuse filing; otherwise supported categories admit it, and the most degraded applicable derived status governs the claim projection.","scope":"Policy covers whether a challenge is admissible against a selected claim refutation surface and how terminal outcomes degrade derived claim status."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"admissibility, exact exclusions, terminal outcome interpretation, and most-degraded status projection are explicit local decision rules. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"The selected surface governs filing at call time and appended records affect local derived status immediately; no external policy deployment is claimed.","authority":"The caller supplies the surface and adjudication records; the module records no declarant or adjudicator identity (layer4/challenge.py:69-80, 99-104).","exceptions":"Only exact documented RefutationSurface exclusions with their reasons are honored; no implicit exception or generic label escape is inferred.","revisions":"A changed surface, exclusion set, challenge record, or adjudication is different retained input; earlier records are not revised in place."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"admissibility, exact exclusions, terminal outcome interpretation, and most-degraded status projection are explicit local decision rules. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Direct mutation is not exposed; excluded filings are recorded as REFUSED, and conflicting terminal records raise rather than silently entering current state.","decision_evidence":"Admission details, complete append-only records, typed outcomes, actor assertions, and derived ClaimStatus provide the local decision trace.","enforcement_points":"admissibility refuses excluded filings, file enforces admission and uniqueness, adjudicate enforces terminality, and status applies degradation rules.","unavailable_behavior":"Missing surfaces, missing predecessor records, malformed values, or absent adjudication cannot be promoted into a favorable terminal claim."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"admissibility, exact exclusions, terminal outcome interpretation, and most-degraded status projection are explicit local decision rules. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:challenge-record-ledger-protocol-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:challenge-record-ledger-protocol-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:challenge-record-ledger-protocol-applies; fulfillment NOT_ESTABLISHED."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-robot-vstd-challenge-record-ledger-af7c63adae0a; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-robot-vstd-challenge-record-ledger-af7c63adae0a; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-robot-vstd-challenge-record-ledger-af7c63adae0a; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"NOT_ESTABLISHED","deployment":"NOT_ESTABLISHED","measurements":"NOT_ESTABLISHED","phenomena":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-sensor-vstd-challenge-record-ledger-373c51f41f86; fulfillment NOT_ESTABLISHED."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"NOT_ESTABLISHED","calibration_evidence":"NOT_ESTABLISHED","drift":"NOT_ESTABLISHED","operating_range":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-sensor-vstd-challenge-record-ledger-373c51f41f86; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"reasons.vstd:tier0-sensor-vstd-challenge-record-ledger-373c51f41f86; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The direct caller supplies challenger and adjudicator identifiers; the ledger records them but performs no identity authentication or external authorization check.","effects":"file and adjudicate append one ChallengeRecord to local ledger state and thereby change the derived current claim status.","preconditions":"Filing requires admissibility against the selected refutation surface; adjudication requires an existing filed challenge and no prior final adjudication.","resources":"Resources are the in-memory record list, challenge-id index implied by that list, one selected refutation surface, and typed input records."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"Filing and final adjudication are validated local state mutations with duplicate, abort, commit, finality, and retry semantics. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Duplicate ids, absent challenges, and repeated adjudications raise ChallengeError before a new record is appended; inadmissible filings are recorded as REFUSED rather than raised (layer4/challenge.py:232-244).","commit":"Commit is an in-process list append; two dict writes precede it (layer4/challenge.py:237-238), and derived status observes the new complete prefix immediately afterward.","finality":"An adjudication is final inside this retained record set; no appeal execution, external enforcement, persistence, or distributed finality is claimed.","partial_failure":"Each mutation performs validation before one list append and has no declared external effect, but process interruption and caller effects are outside its atomic boundary."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"Filing and final adjudication are validated local state mutations with duplicate, abort, commit, finality, and retry semantics. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"Challenge ids detect repeated filing and the existing adjudication record detects repeated finalization.","idempotency":"A repeated successful filing or adjudication is rejected rather than returned as an idempotent success; callers must inspect current records before retry.","replay":"Replay must preserve exact record order and identities; it reconstructs local status but does not replay any external remedy or sanction.","retry_limits":"No retry loop is supplied; the caller must stop or issue a distinct valid challenge after a deterministic rejection."},"evidence_set_digest":"sha256:c829e26eb420066721931f6c6006a86cd858aca262fdd9c0c07bf6ce3cac6e40","reason":"Filing and final adjudication are validated local state mutations with duplicate, abort, commit, finality, and retry semantics. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Append-only challenge, adjudication and claim-status record history."},"reason":"Final adjudication and retained challenges require explicit duplicate, correction and replay treatment. Admissibility, exact exclusions, terminal outcome interpretation, and most-degraded status projection are explicit local decision rules. Filing and final adjudication are validated local state mutations with duplicate, abort, commit, finality, and retry semantics. Boundary: Challenge records establish no financial balance, asset custody or external enforcement by themselves.","specializations":["POLICY","TRANSACTION"],"surfaces":["file:src/verifier/layer4/challenge.py","python:src/verifier/layer4/challenge.py:<module>","python:src/verifier/layer4/challenge.py:ChallengeError","python:src/verifier/layer4/challenge.py:ChallengeOutcome","python:src/verifier/layer4/challenge.py:Challenge","python:src/verifier/layer4/challenge.py:Challenge.to_dict","python:src/verifier/layer4/challenge.py:Challenge.digest","python:src/verifier/layer4/challenge.py:Adjudication","python:src/verifier/layer4/challenge.py:Adjudication.to_dict","python:src/verifier/layer4/challenge.py:Admission","python:src/verifier/layer4/challenge.py:Admission.to_dict","python:src/verifier/layer4/challenge.py:ChallengeRecord","python:src/verifier/layer4/challenge.py:ChallengeRecord.to_dict","python:src/verifier/layer4/challenge.py:ClaimStatus","python:src/verifier/layer4/challenge.py:ClaimStatus.to_dict","python:src/verifier/layer4/challenge.py:admissibility","python:src/verifier/layer4/challenge.py:most_degraded","python:src/verifier/layer4/challenge.py:ChallengeLedger","python:src/verifier/layer4/challenge.py:ChallengeLedger.__init__","python:src/verifier/layer4/challenge.py:ChallengeLedger.file","python:src/verifier/layer4/challenge.py:ChallengeLedger.adjudicate","python:src/verifier/layer4/challenge.py:ChallengeLedger._append","python:src/verifier/layer4/challenge.py:ChallengeLedger.records","python:src/verifier/layer4/challenge.py:ChallengeLedger.status","python:src/verifier/layer4/challenge.py:ChallengeLedger.__len__"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"AGENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ARCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ASSET":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not apply as ASSET. It represents no right, quantity, issuance/redemption, custody, or backing claim; bytes and quota counts are not assets. Reviewed boundary: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility.","status":"DOES_NOT_APPLY"},"BENCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"COLLECTIVE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"CONTROLLER":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not apply as CONTROLLER. It does not use observed feedback to select commands for a represented target; validation or message handling alone is not control. Reviewed boundary: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility.","status":"DOES_NOT_APPLY"},"DATA":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ENV":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"EVENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"FINBOT":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not itself represent an agent responsible for a real-money decision/effect path or a declared financial endpoint. Its reviewed consequence boundary is: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility. This decision does not infer absence of downstream financial effects: any real financial endpoint must be a separately represented FINBOT with its accumulated roles.","status":"DOES_NOT_APPLY"},"GRAPH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HARDWARE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HARNESS":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HUMAN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HYPER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"IDENTITY":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"LEDGER":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not apply as LEDGER. Any response, event, or digest it retains is evidence for the named role, not a separately owned authoritative accounting/history state. Reviewed boundary: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility.","status":"DOES_NOT_APPLY"},"MARKET":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not apply as MARKET. It provides no participant trading access, order lifecycle, matching, allocation, price formation, or settlement mechanism. Reviewed boundary: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility.","status":"DOES_NOT_APPLY"},"MEASUREMENT":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not apply as MEASUREMENT. Its outputs are commands, decisions, declarations, or lifecycle records, not a separately owned observation of a phenomenon with uncertainty. Reviewed boundary: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility.","status":"DOES_NOT_APPLY"},"MODEL":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"OWNER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"POLICY":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"PROTOCOL":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle applies as PROTOCOL. Its participants exchange ordered requests/responses across a process or remote boundary with explicit compatibility and failure states.","status":"APPLIES"},"RECEIPT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ROBOT":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not itself represent an agent-to-physical-actuator path or a declared physical endpoint. Its reviewed consequence boundary is: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility. This decision does not infer confinement or absence of downstream effects: any external physical endpoint must be a separately represented ROBOT with its accumulated roles.","status":"DOES_NOT_APPLY"},"ROLE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SENSOR":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle does not apply as SENSOR. It has no separately owned acquisition producer with calibration/range semantics; reading supplied bytes or callback state is not enough. Reviewed boundary: Path-level phases are compound; bounded remote storage or PENDING_REVIEW does not establish publication, moderation, real-money transfer, or FINBOT responsibility.","status":"DOES_NOT_APPLY"},"SIM":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SPACE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TIME":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TOKEN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRAIN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRANSACTION":{"evidence_set_digest":"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd2","reason":"Claim Garden lifecycle applies as TRANSACTION. Its named changes, response-dependent finality, duplicate handling, and partial-failure state require an explicit transaction boundary.","status":"APPLIES"},"VERIFIER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"}},"evidence_sets":{"sha256:2eeae4eff8ed693b3c87cb63f1a0bc37ca5e7ea1058dd130f21311e96dd98dd