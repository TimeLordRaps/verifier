on":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-market-vstd-asset-tier0-execution-verifier-4ba94cc86006; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-market-vstd-asset-tier0-execution-verifier-4ba94cc86006; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-market-vstd-asset-tier0-execution-verifier-4ba94cc86006; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"NOT_ESTABLISHED","observation_vs_estimate":"NOT_ESTABLISHED","phenomenon":"NOT_ESTABLISHED","source":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-measurement-vstd-asset-tier0-execution-verifier-1abaddf66e36; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"NOT_ESTABLISHED","observation_time":"NOT_ESTABLISHED","reference_frame":"NOT_ESTABLISHED","uncertainty":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-measurement-vstd-asset-tier0-execution-verifier-1abaddf66e36; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"NOT_ESTABLISHED","missingness":"NOT_ESTABLISHED","provenance":"NOT_ESTABLISHED","validity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-measurement-vstd-asset-tier0-execution-verifier-1abaddf66e36; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"The installed field catalog and specimen constants; closed claim, instrument, backing, rights, grant, operation, account, and unit records; caller-supplied route-catalog rows; or one caller-supplied observation for strict comparison with a fresh report.","defaults":"Malformed records and forbidden operations raise stable typed refusals; expected-outcome drift returns FAIL; malformed or incomplete reconciliation input remains UNKNOWN or exact diagnostics; route drift is reported; a stale, forged, reordered, aliased, or altered observation is refused and never promoted to route PASS.","precedence":"Validate identifiers, units, quantities, grants, control, available balance, and operation identity before staging mutation; commit a complete batch only after every staged operation succeeds; build route correspondence after all fixed rows run; strict fresh-report equality precedes observation acceptance.","scope":"Evaluate one fixed finite specimen for the twelve ASSET-0.1, ASSET-0.2, and ASSET-0.3 declaration fields, expose their exact source-owned field statuses, compare supplied route metadata with pinned correspondence, and accept an observation only when it strictly equals a fresh evaluation. The checker is not an ASSET subject or instance and owns no ASSET route."},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"ASSET Tier-0 in-memory policy verifier applies as POLICY. Its rule selection, authority, defaults, and enforcement points decide whether a consequential operation may proceed. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"Typed-record admitted/refused, grant active/revoked/exhausted, operation new/duplicate/conflicting, batch staged/committed/refused, encumbrance active/released, reconciliation PASS/FAIL/UNKNOWN, in-model reproduced/unreproduced, route NOT_ESTABLISHED, and observation accepted/refused remain distinct.","authority":"Only installed checker code selects the finite rules and expected outcomes. AuthorityGrant and custodian/controller identifiers are specimen data, not authenticated issuer, legal, custody, redemption, financial, route, release, or deployment authority; no real instrument is issued or redeemed.","exceptions":"The fixed specimen uses closed identifiers, rights, operation kinds and units, non-boolean integers from zero through 2**63-1, and a finite scenario catalog. Caller-supplied route sequences and observation structures have no explicit byte, row, or nesting ceiling before comparison, so resource exhaustion is not converted into PASS.","revisions":"Standard-library dataclasses and closed vocabularies enforce typed integer quantities, authority-grant lookup, idempotent operation identifiers, atomic batch staging, custody/control and encumbrance rules, reconciliation, strict same-type equality, canonical JSON SHA-256 digests, and a digest of this module's own current bytes."},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"ASSET Tier-0 in-memory policy verifier applies as POLICY. Its rule selection, authority, defaults, and enforcement points decide whether a consequential operation may proceed. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"The fixed specimen uses closed identifiers, rights, operation kinds and units, non-boolean integers from zero through 2**63-1, and a finite scenario catalog. Caller-supplied route sequences and observation structures have no explicit byte, row, or nesting ceiling before comparison, so resource exhaustion is not converted into PASS.","decision_evidence":"Exact operation outcomes, journal height, balances, issued/redeemed totals, recorded backing, state/source/specimen digests, field statuses and reasons, reconciliation diagnostics, route correspondence, and strict equality with fresh output; external truth is not observed.","enforcement_points":"Standard-library dataclasses and closed vocabularies enforce typed integer quantities, authority-grant lookup, idempotent operation identifiers, atomic batch staging, custody/control and encumbrance rules, reconciliation, strict same-type equality, canonical JSON SHA-256 digests, and a digest of this module's own current bytes.","unavailable_behavior":"Malformed records and forbidden operations raise stable typed refusals; expected-outcome drift returns FAIL; malformed or incomplete reconciliation input remains UNKNOWN or exact diagnostics; route drift is reported; a stale, forged, reordered, aliased, or altered observation is refused and never promoted to route PASS."},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"ASSET Tier-0 in-memory policy verifier applies as POLICY. Its rule selection, authority, defaults, and enforcement points decide whether a consequential operation may proceed. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:211c41d0d5ac2005459a845a26d34d4a6fdfd63f30e335309d13ae546eb8780a","reason":"reasons.vstd:tier0-protocol-vstd-asset-tier0-ex