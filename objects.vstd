tion is authorized.","ordering":"Each language is parsed under its own pinned mechanism and response rows preserve submitted file order.","replay":"A repeat parse is a new current-byte check; prior parser output cannot cover changed sources or unresolved expansions."},"evidence_set_digest":"sha256:be407edc5c827abc177f6aebe5c758c17d13c4e94f9c7a4677e96c6b7b82a730","reason":"Rust/Bash parser exchange applies as PROTOCOL. Its participants exchange ordered requests/responses across a process or remote boundary with explicit compatibility and failure states. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"Unavailable grammar, syntax error, macro/module/export gap, dialect ambiguity, or dynamic shell dispatch remains explicit.","liveness":"The parent enforces a finite worker timeout; no subject runtime progress is involved.","recovery":"Install the pinned grammar or bind missing source/expansion/dialect evidence and rerun without executing subject code.","safety":"Input/output bytes, nodes, paths, fields, parser versions, languages, and syntax rows are finite and exact."},"evidence_set_digest":"sha256:be407edc5c827abc177f6aebe5c758c17d13c4e94f9c7a4677e96c6b7b82a730","reason":"Rust/Bash parser exchange applies as PROTOCOL. Its participants exchange ordered requests/responses across a process or remote boundary with explicit compatibility and failure states. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:3c5463f205dbf9265cf799d6ef5a6a40578057f4effd78392f2ddd1a56d7eb17","reason":"reasons.vstd:tier0-robot-vstd-systems-parser-protocol-0687ce85f