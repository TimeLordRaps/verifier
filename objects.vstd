f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-market-vstd-nvidia-live-sensor-cdcbfd94fb7b; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"Launch one read-only nvidia-smi --query-gpu CSV query (hardware/adapters/nvidia.py:61-71) through subprocess.run with timeout=_DISCOVERY_TIMEOUT_SECONDS and stdout written to a tempfile.TemporaryFile (hardware/adapters/nvidia.py:59-80), parse its rows (hardware/adapters/nvidia.py:88-94), and normalize the returned identity and version fields into AdapterResult records (hardware/adapters/nvidia.py:104-122).","observation_vs_estimate":"Values are host-interface observations. Physical identity, available capacity under load, performance, and completeness are not inferred or estimated.","phenomenon":"Host-visible NVIDIA device identity, namely UUID, name, and PCI bus id, plus driver and VBIOS version strings returned by nvidia-smi --query-gpu (hardware/adapters/nvidia.py:61-71, 94-108).","source":"The current host's nvidia-smi executable and its file-captured stdout (hardware/adapters/nvidia.py:59-80) and return code (hardware/adapters/nvidia.py:81-87); stderr is discarded to DEVNULL (hardware/adapters/nvidia.py:68), and the adapter observation timestamp is recorded after parsing (hardware/adapters/nvidia.py:118)."},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"The NVIDIA adapter normalizes live host-visible accelerator observations with explicit timestamps, units, missingness, and source diagnostics; this does not establish physical truth. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"Arrival is the parent process's receipt of the completed vendor response; transport and device-internal latency are not measured.","observation_time":"The adapter records a UTC time after the query; it does not claim a hardware sampling instant for every returned field.","reference_frame":"Each observation is relative to the host-visible NVIDIA device identifier and the vendor tool's current namespace.","uncertainty":"No physical calibration, accuracy interval, drift bound, device authenticity, or inventory completeness is established; those uncertainties remain explicit.","units":"Identifiers, names, PCI bus identifiers, and version strings remain typed strings; no memory, power, thermal, or health quantity is normalized (hardware/adapters/nvidia.py:94-108)."},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"The NVIDIA adapter normalizes live host-visible accelerator observations with explicit timestamps, units, missingness, and source diagnostics; this does not establish physical truth. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"Freshness is bounded to this invocation and its recorded UTC time; no claim is made about state before or after the query.","missingness":"Unavailable tools, failed queries, malformed rows, and absent fields remain failures or explicit missing observations; they are never silently replaced with zero.","provenance":"The result records the adapter, selected nvidia-smi --query-gpu route, raw diagnostics, and observation time; it does not authenticate the physical device.","validity":"Success requires an available executable, accepted response shape, successful return code, bounded parsing, and supported value normalization."},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"The NVIDIA adapter normalizes live host-visible accelerator observations with explicit timestamps, units, missingness, and source diagnostics; this does not establish physical truth. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"NOT_ESTABLISHED","defaults":"NOT_ESTABLISHED","precedence":"NOT_ESTABLISHED","scope":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-policy-vstd-nvidia-live-sensor-54c4a976e4fb; fulfillment NOT_ESTABLISHED."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"NOT_ESTABLISHED","authority":"NOT_ESTABLISHED","exceptions":"NOT_ESTABLISHED","revisions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-policy-vstd-nvidia-live-sensor-54c4a976e4fb; fulfillment NOT_ESTABLISHED."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"NOT_ESTABLISHED","decision_evidence":"NOT_ESTABLISHED","enforcement_points":"NOT_ESTABLISHED","unavailable_behavior":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-policy-vstd-nvidia-live-sensor-54c4a976e4fb; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-protocol-vstd-nvidia-live-sensor-c913bd98caf7; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-protocol-vstd-nvidia-live-sensor-c913bd98caf7; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-protocol-vstd-nvidia-live-sensor-c913bd98caf7; fulfillment NOT_ESTABLISHED."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-robot-vstd-nvidia-live-sensor-3112a039cb6e; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-robot-vstd-nvidia-live-sensor-3112a039cb6e; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-robot-vstd-nvidia-live-sensor-3112a039cb6e; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"The adapter directly launches nvidia-smi --query-gpu and captures the current host-visible response without commanding accelerator work.","deployment":"Deployment is the local host process with the vendor management executable available; container, permission, virtualization, and device mapping affect visibility.","measurements":"Normalized AdapterResult observations retain explicit success, failure, raw evidence, values, and observation time.","phenomena":"Phenomena are the device identity and version fields named in the query (hardware/adapters/nvidia.py:64), not memory, power, thermal, or health readings."},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"The NVIDIA adapter actively acquires nvidia-smi --query-gpu output from the current host, so acquisition, calibration-applicability, sampling, latency, and fault declarations are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"Physical calibration is not performed. Applicability is limited to vendor-interface metadata acquisition and software normalization.","calibration_evidence":"No calibration certificate or traceable physical reference is present; parser fixtures and vendor output are not calibration evidence.","drift":"Driver, firmware, vendor-tool, virtualization, and parser-format drift are not quantified and can invalidate or reduce observations.","operating_range":"The supported range is the bounded response and field formats accepted by this adapter on a host where the vendor query completes."},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"The NVIDIA adapter actively acquires nvidia-smi --query-gpu output from the current host, so acquisition, calibration-applicability, sampling, latency, and fault declarations are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"Missing executables, nonzero exits, malformed payloads, unsupported values, and parsing exceptions are reported as bounded acquisition failures.","latency":"The nvidia-smi subprocess.run call is bounded by timeout=_DISCOVERY_TIMEOUT_SECONDS, 30 seconds (hardware/adapters/nvidia.py:24, hardware/adapters/nvidia.py:70), over the call at hardware/adapters/nvidia.py:61-71; expiry returns an unsupported result (hardware/adapters/nvidia.py:72-78). This declaration claims no stronger termination guarantee for helper processes, and device-internal observation latency is not measured.","recovery":"Recovery is a later fresh query after the operator fixes availability or compatibility; cached values are not promoted as current observations.","sampling":"One adapter call performs one vendor query; it defines no periodic cadence, aggregation window, or cross-call synchronization."},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"The NVIDIA adapter actively acquires nvidia-smi --query-gpu output from the current host, so acquisition, calibration-applicability, sampling, latency, and fault declarations are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"NOT_ESTABLISHED","effects":"NOT_ESTABLISHED","preconditions":"NOT_ESTABLISHED","resources":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-transaction-vstd-nvidia-live-sensor-199ce47ea3dd; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"NOT_ESTABLISHED","commit":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","partial_failure":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-transaction-vstd-nvidia-live-sensor-199ce47ea3dd; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"NOT_ESTABLISHED","idempotency":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED","retry_limits":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:1363ad16a35e187692f944e9eba16112774f3e0998dd9805f1a84a6699dbcbc2","reason":"reasons.vstd:tier0-transaction-vstd-nvidia-live-sensor-199ce47ea3dd; fulfillment NOT_ESTABLISHED."}},"operands":{},"payload":{"representation_role":"Live NVML/nvidia-smi host discovery and normalization of observed accelerator state."},"reason":"Live vendor acquisition has calibration, freshness and failure questions that generic package ownership cannot express. Boundary: Reads live host state but commands no device; identity, calibration and physical completeness remain unestablished.","specializations":["MEASUREMENT"],"surfaces":["file:src/verifier/hardware/adapters/nvidia.py","python:src/verifier/hardware/adapters/nvidia.py:<module>","python:src/verifier/hardware/adapters/nvidia.py:_profile_for_model","python:src/verifier/hardware/adapters/nvidia.py:NvidiaAdapter","python:src/verifier/hardware/adapters/nvidia.py:NvidiaAdapter.discover","python:src/verifier/hardware/adapters/nvidia.py:NvidiaAdapter._from_fixture","python:src/verifier/hardware/adapters/nvidia.py:NvidiaAdapter._normalize_payload","python:src/verifier/hardware/adapters/nvidia.py:_InMemoryGenericAdapter","python:src/verifier/hardware/adapters/nvidia.py:_InMemoryGenericAdapter.__init__","python:src/verifier/hardware/adapters/nvidia.py:_InMemoryGenericAdapter.discover"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:82ef21f538bda43ada525254ceae41a602a23f6d3325b9945e5e9dd2397a1847","reason":"vstd-object-address-closure-verifier is explicitly DOES_NOT_APPLY for ACTUATOR after a current-source audit. Exact owned source denominator: src/verifier/domains/contracts/object_address_closu