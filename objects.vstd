og() names the exact checking mechanism identity.","status":"APPLIES"}},"evidence_sets":{"sha256:08a11df297c367fb3660f621ba2cb234b60d283f13d26e79fdd9fd7d4a84779f":[{"path":"src/verifier/runtime/namespace_cli.py","sha256":"sha256:70319f32d64fbe25a2a0d49bb46a285d476cd339af632394d2e35325fe0cb7db"},{"path":"src/verifier/runtime/manifest_write_execution.py","sha256":"sha256:360bb109e60c349a9e3bc4064c08b6a1157d0e3bb25474b3c5fd86cf6df4e0c7"},{"path":"src/verifier/runtime/manifest_write_worker.py","sha256":"sha256:f35b0af2432af8ce488b9e21f294269c1e1013765ef2be0f292f152ca48e69ff"}],"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945":[],"sha256:644f166d1d278264f7b317d1a1cc7eb36e27304eeff3696fb743ab646091e6a4":[{"path":"src/verifier/runtime/namespace_cli.py","sha256":"sha256:70319f32d64fbe25a2a0d49bb46a285d476cd339af632394d2e35325fe0cb7db"}],"sha256:925e9afa3dac5e78435d6678efac64d4793ffc168985f9e09f4ef15f2ac63895":[{"path":"src/verifier/runtime/manifest_write_execution.py","sha256":"sha256:360bb109e60c349a9e3bc4064c08b6a1157d0e3bb25474b3c5fd86cf6df4e0c7"},{"path":"src/verifier/runtime/manifest_write_worker.py","sha256":"sha256:f35b0af2432af8ce488b9e21f294269c1e1013765ef2be0f292f152ca48e69ff"}],"sha256:ae2d8488330244519a8b0b07e4e0810e97b193fe93656512f7deb07553e0f5e8":[{"path":"src/verifier/runtime/manifest_write_execution.py","sha256":"sha256:360bb109e60c349a9e3bc4064c08b6a1157d0e3bb25474b3c5fd86cf6df4e0c7"},{"path":"src/verifier/runtime/manifest_write_worker.py","sha256":"sha256:f35b0af2432af8ce488b9e21f294269c1e1013765ef2be0f292f152ca48e69ff"},{"path":"src/verifier/runtime/namespace_cli.py","sha256":"sha256:70319f32d64fbe25a2a0d49bb46a285d476cd339af632394d2e35325fe0cb7db"}]},"kind":"TRANSACTION","object_id":"vstd-manifest-write","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"NOT_ESTABLISHED","commands":"NOT_ESTABLISHED","effect_domains":"NOT_ESTABLISHED","targets":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:644f166d1d27