r-vstd-assurance-event-ledger-0733e1c05f17; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"NOT_ESTABLISHED","failure_behavior":"NOT_ESTABLISHED","feedback_loss":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"reasons.vstd:tier0-controller-vstd-assurance-event-ledger-0733e1c05f17; fulfillment NOT_ESTABLISHED."},"FINBOT-0.1-agent-and-financial-authority":{"declaration":{"agent":"NOT_ESTABLISHED","decision_scope":"NOT_ESTABLISHED","financial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"reasons.vstd:tier0-finbot-vstd-assurance-event-ledger-1eb9a60a9fbd; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"reasons.vstd:tier0-finbot-vstd-assurance-event-ledger-1eb9a60a9fbd; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"reasons.vstd:tier0-finbot-vstd-assurance-event-ledger-1eb9a60a9fbd; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"Authority is local to the selected AssuranceLedger instance, immutable graph, and caller-supplied mechanisms and recorded evidence; external adjudicative authority is not established.","history":"AssuranceLedger owns an append-only sequence of assurance events plus retained conflict resolutions over one immutable provenance graph coordinate.","ordering":"Each event carries a sequence, previous digest, and canonical digest; projections and grouped guilt components preserve explicit prerequisite order.","state":"Current artifact, transformation, trust, applicability, violation, and diagnostic state is derived from the exact retained event prefix; responsibility and guilt are not materialized into the current graph (data/assurance.py:658-677)."},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"AssuranceLedger is the authoritative local append-only event and conflict-resolution history from which current assurance graph state is derived. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"Hash-chain continuity, immutable historical graph identity, admissible conflict resolution, prerequisite closure, and additive current-state rules are enforced.","rounding":"Event identity and status are exact; no numeric ratio is computed, so no rounding applies and no balance, payment, or precision guarantee is created.","sources_and_sinks":"Events enter only through typed record methods and are never edited or removed; current state is a projection rather than a destructive sink.","units":"Units are discrete events, artifacts, transformations, conflicts, obligations, and graph relations; counts are diagnostic and nonmonetary."},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"AssuranceLedger is the authoritative local append-only event and conflict-resolution history from which current assurance graph state is derived. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"Contradictions remain retained and can receive explicit conflict resolutions or later additive events; historical events are not rewritten.","reconciliation":"Serialized history is reconciled against the exact immutable provenance graph and recomputed current-state materialization, not an external execution system.","recovery":"Recovery is deterministic reconstruction from a complete valid serialized log and the matching graph; durability, backup, and concurrent-writer recovery are external.","replay":"recheck_assurance_log reconstructs typed events, validates their chain and graph coordinate, and compares the recomputed current state."},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"AssuranceLedger is the authoritative local append-only event and conflict-resolution history from which current assurance graph state is derived. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"reasons.vstd:tier0-market-vstd-assurance-event-ledger-e8dd5e5c4e44; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:591caa2f4c39292054446f2405f2b5961b6285c0655a9e4f586416c15dab807d","reason":"reasons.vstd:tier0-market-vstd-assurance-event-ledger-e8dd5e5c4e44; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED