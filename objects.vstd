ancial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-finbot-vstd-privacy-emission-policy-c0c5004f303a; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-finbot-vstd-privacy-emission-policy-c0c5004f303a; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-finbot-vstd-privacy-emission-policy-c0c5004f303a; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"Only caller-supplied policy, consent, observer, governance, and in-memory budget configuration authorizes a local decision; the receipt is not its own authority.","history":"One DifferentialPrivacyBudget instance retains only current cumulative epsilon, delta, and successful-emission count; it retains no per-entry journal or durable history.","ordering":"Input capture precedes evaluation; composition and field checks precede emission; budget consumption advances cumulative epsilon, delta, and count in call order.","state":"States include uncaptured, captured, admitted, refused, budget available/exhausted, receipt emitted, and replay matched or rejected."},"evidence_set_digest":"sha256:028d7c5ef4491121015c9c94becfd3bad128b9ef3ae95f3549c0b3977faa5a44","reason":"The bounded privacy-emission evaluator applies as LEDGER. Its mutable cumulative epsilon, delta, and count state needs explicit accounting and recovery semantics even though it retains no journal, is not durable, and is not concurrency-safe. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"Every value must be finite and nonnegative, delta must remain within [0, 1], prior state must already be valid, and a consume call may not raise either cumulative value above its configured maximum.","rounding":"The implementation uses Python floating-point addition and max; it defines no decimal rounding, tolerance, or cross-runtime exactness.","sources_and_sinks":"A successful consume call adds caller-supplied epsilon and delta and increments the count. There is no decrement, redemption, transfer, or correction operation on the instance.","units":"Disclosure accounting uses dimensionless epsilon and delta plus discrete emission and byte/field counts; it does not establish that a mechanism is differentially private."},"evidence_set_digest":"sha256:028d7c5ef4491121015c9c94becfd3bad128b9ef3ae95f3549c0b3977faa5a44","reason":"The bounded privacy-emission evaluator applies as LEDGER. Its mutable cumulative epsilon, delta, and count state needs explicit accounting and recovery semantics even though it retains no journal, is not durable, and is not concurrency-safe. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"No correction history exists. Replacing or resetting a mutable budget is caller action and cannot be represented as a reconciled correction.","reconciliation":"Returned remaining values are recomputed from current counters and configured maxima; no durable or concurrent external record is reconciled.","recovery":"Recovery requires corrected current inputs or an explicitly coordinated fresh budget/evaluation; callers may not treat a reset mutable object as reconciled history.","replay":"A repeated call is a new evaluation and may consume a mutable budget again; callers must coordinate shared state and cannot infer idempotency from matching inputs."},"evidence_set_digest":"sha256:028d7c5ef4491121015c9c94becfd3bad128b9ef3ae95f3549c0b3977faa5a44","reason":"The bounded privacy-emission evaluator applies as LEDGER. Its mutable cumulative epsilon, delta, and count state needs explicit accounting and recovery semantics even though it retains no journal, is not durable, and is not concurrency-safe. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-market-vstd-privacy-emission-policy-35f73e2031d6; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-market-vstd-privacy-emission-policy-35f73e2031d6; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-market-vstd-privacy-emission-policy-35f73e2031d6; fulfillment NOT_ESTABLIS