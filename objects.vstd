a40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance does not apply as ASSET. It represents no right, quantity, issuance/redemption, custody, or backing claim; bytes and quota counts are not assets. Reviewed boundary: Every output keeps full_application_status UNKNOWN and polished false. The route performs no transport, publication, human acceptance, physical action or real-money decision.","status":"DOES_NOT_APPLY"},"BENCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"COLLECTIVE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"CONTROLLER":{"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance does not apply as CONTROLLER. It does not use observed feedback to select commands for a represented target; validation or message handling alone is not control. Reviewed boundary: Every output keeps full_application_status UNKNOWN and polished false. The route performs no transport, publication, human acceptance, physical action or real-money decision.","status":"DOES_NOT_APPLY"},"DATA":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ENV":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"EVENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"FINBOT":{"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance does not itself represent an agent responsible for a real-money decision/effect path or a declared financial endpoint. Its reviewed consequence boundary is: Every output keeps full_application_status UNKNOWN and polished false. The route performs no transport, publication, human acceptance, physical action or real-money decision. This decision does not infer absence of downstream financial effects: any real financial endpoint must be a separately represented FINBOT with its accumulated roles.","status":"DOES_NOT_APPLY"},"GRAPH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HARDWARE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HARNESS":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HUMAN":{"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"Audited original-kind profile verifier-runtime-original-kind-review revision 1 (sha256:59f9e9cc8fee657c75bedcf4cf05684f7fc48909d2bfba78cfdc35d95c29fd0a) binds this object and exact owned source set. Full review scope is bound by source coordinate sha256:eb ... [full rationale sha256:9daae3bfc2d2da20092a1dfa285b64be3d7e9df0dc0577a33bc492420163db1b]","status":"DOES_NOT_APPLY"},"HYPER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"IDENTITY":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"LEDGER":{"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance applies as LEDG