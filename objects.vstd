rmation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-market-applies; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-market-applies; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"Read link.getBoundingClientRect, window.innerWidth/innerHeight and card.offsetHeight, then derive clamped tooltip width, left and top CSS pixel coordinates for the current rendered document.","observation_vs_estimate":"orientation-preview layout measurement reports only the parent-boundary observations named here. These are browser-layout observations used for placement, not physical measurements, display calibration, historical telemetry or evidence that the generated documentation is semantically current.","phenomenon":"Link rectangle edges, viewport width and height, tooltip rendered height, and the derived width, left and top coordinates.","source":"The current browser layout of one selected link and tooltip plus the current viewport dimensions at the position callback."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as MEASUREMENT because orientation-previews.js reads current link, tooltip and viewport geometry and derives placement in a defined CSS-pixel frame with explicit timing and validity limits. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"orientation-preview layout measurement records parent receipt/completion ordering; it does not reconstruct an unobserved child or external event time.","observation_time":"The observation occurs during show or resize handling and, after render, inside a requestAnimationFrame callback; it has no persisted timestamp.","reference_frame":"One page-local tooltip, repository-preview link attributes and browser focus state; and, separately, the configuration inputs of explicitly selected packaging, installation and pytest tools.","uncertainty":"These are browser-layout observations used for placement, not physical measurements, display calibration, historical telemetry or evidence that the generated documentation is semantically current.","units":"CSS pixels in the current viewport coordinate frame."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as MEASUREMENT because orientation-previews.js reads current link, tooltip and viewport geometry and derives placement in a defined CSS-pixel frame with explicit timing and validity limits. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"The observation occurs during show or resize handling and, after render, inside a requestAnimationFrame callback; it has no persisted timestamp.","missingness":"Missing matching links is an intentional no-op. Unsupported DOM APIs, exceptions or intervening events can leave only a prefix of UI mutations; missing or incompatible tooling cannot be treated as policy enforcement.","provenance":"Read link.getBoundingClientRect, window.innerWidth/innerHeight and card.offsetHeight, then derive clamped tooltip width, left and top CSS pixel coordinates for the current rendered document.","validity":"The method is valid only for the current document, viewport, link, tooltip content and browser layout engine; the configured margin is 12 CSS pixels."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as MEASUREMENT because orientation-previews.js reads current link, tooltip and viewport geometry and derives placement in a defined CSS-pixel frame with explicit timing and validity limits. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"The exact pyproject project, build-system, optional-dependencies, scripts, setuptools.package-data and pytest.ini_options tables plus the selected consumer tool and invocation.","defaults":"Missing, invalid, incompatible, bypassed or overridden policy remains unavailable or externally determined; no successful build, test, install or release is inferred from valid TOML.","precedence":"TOML and tool-specific semantics govern table interpretation; explicit command-line or environment choices may override defaults according to the selected tool, and no cross-tool precedence is invented here.","scope":"Configure the verifier-standard distribution metadata, Python floor, pinned build requirements, optional dependency groups, console aliases, package-data selection and pytest discovery defaults."},"evidence_set_digest":"sha256:268ab5978e26cdea00e94a1bc835c0c831c1abe2516e8d3ce28dc9dcfc66757f","reason":"vstd-package-object applies as POLICY because pyproject.toml defines scoped package, build, dependency-group, command-alias, package-data and test-discovery rules consumed at named external tool enforcement points. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"The policy is inert as repository bytes; it becomes an input only when a compatible selected packaging, installer or pytest tool parses it.","authority":"Repository maintainers author the file, while an operator or build system separately authorizes a named tool invocation. Configuration text alone does not authorize installation, publication, release or dependency fetch.","exceptions":"Only declared tables and compatible tool versions are covered. Optional groups remain optional, dependencies are not automatically trusted, and entry-point naming does not establish installed reachability.","revisions":"Compatible external tools parse their named TOML tables and enforce only the fields within their own invocation; this module does not assert that a tool was invoked or honored every field."},"evidence_set_digest":"sha256:268ab5978e26cdea00e94a1bc835c0c831c1abe2516e8d3ce28dc9dcfc66757f","reason":"vstd-package-object applies as POLICY because pyproject.toml defines scoped package, build, dependency-group, command-alias, package-data and test-discovery rules consumed at named external tool enforcement points. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Only declared tables and compatible tool versions are covered. Optional groups remain optional, dependencies are not automatically trusted, and entry-point naming does not establish installed reachability.","decision_evidence":"Decision evidence is the current exact pyproject.toml digest plus the separately observable selected tool, arguments and resulting build, install or test output; the file alone is not execution evidence.","enforcement_points":"Compatible external tools parse their named TOML tables and enforce only the fields within their own invocation; this module does not assert that a tool was invoked or honored every field.","unavailable_behavior":"Missing, invalid, incompatible, bypassed or overridden policy remains unavailable or externally determined; no successful build, test, install or release is inferred from valid TOML."},"evidence_set_digest":"sha256:268ab5978e26cdea00e94a1bc835c0c831c1abe2516e8d3ce28dc9dcfc66757f","reason":"vstd-package-object applies as POLICY because pyproject.toml defines scoped package, build, dependency-group, command-alias, package-data and test-discovery rules consumed at named external tool enforcement points. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-protocol-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-protocol-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-protocol-applies; fulfillment NOT_ESTABLISHED."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-robot-applies; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-robot-applies; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:20fd2f9c0d21d1a0b84b77be1bff677a918534f64317d95b8821d4838809c664","reason":"reasons.vstd:package-object-robot-applies; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"Register mouseenter, mouseleave, focus, blur, keydown and resize listeners; inspect event keys, hover/focus state and current DOM geometry.","deployment":"The current loaded browser document and window only; no operating-system, physical-device or remote observation source is addressed.","measurements":"Discrete event identities and Boolean DOM predicates, milliseconds for debounce delays, and CSS pixels for acquired layout geometry.","phenomena":"Presence and ordering of selected browser events, Escape key identity, hover/focus predicates, active-link identity and current layout values."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as SENSOR because orientation-previews.js acquires pointer, focus, keyboard and resize events plus current DOM geometry through browser listeners and layout APIs with sampling and fault boundaries. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"Physical calibration is not applicable to orientation-preview browser-input sensor's digital parent-interface acquisition; parser and source pins are compatibility bindings, not metrological calibration.","calibration_evidence":"Register mouseenter, mouseleave, focus, blur, keydown and resize listeners; inspect event keys, hover/focus state and current DOM geometry.","drift":"Event arrival uses browser dispatch order; show/hide sampling follows 250/120 ms timers and placement can wait for the next animation frame.","operating_range":"The preview applies only to matching repository links in one current document, one tooltip, current viewport dimensions and supported DOM APIs. The policy applies only to named pyproject tables and compatible tools."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as SENSOR because orientation-previews.js acquires pointer, focus, keyboard and resize events plus current DOM geometry through browser listeners and layout APIs with sampling and fault boundaries. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"Missing matching links yields no installed sensor. Unsupported APIs, lost events, timer delay or stale layout can prevent or age an observation; the source provides no completeness claim.","latency":"Event arrival uses browser dispatch order; show/hide sampling follows 250/120 ms timers and placement can wait for the next animation frame.","recovery":"A later supported browser event may render and reposition the tooltip or hide it; page reload reconstructs state. Tool failures require inspection before a separately authorized fresh build, install or test invocation.","sampling":"Presence and ordering of selected browser events, Escape key identity, hover/focus predicates, active-link identity and current layout values."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as SENSOR because orientation-previews.js acquires pointer, focus, keyboard and resize events plus current DOM geometry through browser listeners and layout APIs with sampling and fault boundaries. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"Authority is confined to DOM nodes created or selected by the loaded orientation-preview script in its current document; it grants no network, filesystem, publication or package-management authority.","effects":"Show/render/position and hide paths perform several ordered DOM and in-memory mutations; an exception can expose a partial update.","preconditions":"A matching current link, its data attributes, current active-link and timer state, current tooltip state, and the triggering browser event.","resources":"The page-local tooltip children, class, width, position and hidden flag; the selected link's aria-describedby and focus; activeLink and timer."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as TRANSACTION because orientation-previews.js coordinates multiple page-local DOM, accessibility, focus and in-memory state mutations whose commit, partial-failure and repeated-event boundaries matter. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Missing matching links is an intentional no-op. Unsupported DOM APIs, exceptions or intervening events can leave only a prefix of UI mutations; missing or incompatible tooling cannot be treated as policy enforcement.","commit":"Synchronous mutations commit individually; positioning is a later animation-frame callback. The source defines no rollback or all-or-nothing commit across the compound update.","finality":"Synchronous mutations commit individually; positioning is a later animation-frame callback. The source defines no rollback or all-or-nothing commit across the compound update. This finality is limited to the named local or remote state; it grants no broader correctness or publication authority.","partial_failure":"Missing matching links is an intentional no-op. Unsupported DOM APIs, exceptions or intervening events can leave only a prefix of UI mutations; missing or incompatible tooling cannot be treated as policy enforcement."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as TRANSACTION because orientation-previews.js coordinates multiple page-local DOM, accessibility, focus and in-memory state mutations whose commit, partial-failure and repeated-event boundaries matter. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"A new event cancels the stored timer where specified but does not dedupe already completed DOM mutations or an already queued animation frame.","idempotency":"orientation-preview DOM update transaction treats only the explicitly named digest, request, or invocation identity as duplicate evidence; no unstated idempotency is assumed.","replay":"A later supported browser event may render and reposition the tooltip or hide it; page reload reconstructs state. Tool failures require inspection before a separately authorized fresh build, install or test invocation.","retry_limits":"A new event cancels the stored timer where specified but does not dedupe already completed DOM mutations or an already queued animation frame."},"evidence_set_digest":"sha256:04c9d265fa77908c4066d51b09c606f6730815babed8eca3e4837c2b0b589998","reason":"vstd-package-object applies as TRANSACTION because orientation-previews.js coordinates multiple page-local DOM, accessibility, focus and in-memory state mutations whose commit, partial-failure and repeated-event boundaries matter. This Tier-0 declaration names the exact reviewed source boundary only; execution, declaration truth, generated-byte freshness and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"package-subject"},"reason":"Retained package role: package-subject. Source ownership enumerates its representation; operational truth remains a higher-tier question.","specializations":["POLICY","TRANSACTION","MEASUREMENT","SENSOR","CONTROLLER","ACTUATOR","PROTOCOL","FINBOT"],"surfaces":["file:docs/assets/orientation-previews.js","file:docs/assets/site.css","file:docs/assets/vstd-overview.png","file:docs/assets/vstd-overview.svg","svg:docs/assets/vstd-overview.svg:document","svg:docs/assets/vstd-overview.svg:element:1:{http://www.w3.org/2000/svg}svg","svg:docs/assets/vstd-overview.svg:element:1:{http://www.w3.org/2000/svg}svg:namespace:0:default","svg:docs/assets/vstd-overview.svg:element:1:{http://www.w3.org/2000/svg}svg:attribute:0:width","svg:docs/assets/vstd-overview.svg:element:1:{http://www.w3.org/2000/svg}svg:attribute:1:height","svg:docs/assets/vstd-overview.svg:element:1:{http://www.w3.org/2000/svg}svg:attribute:2:viewBox","svg:docs/assets/vstd-overview.svg:element:1:{http://