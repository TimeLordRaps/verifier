t NOT_ESTABLISHED."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"NOT_ESTABLISHED","decision_evidence":"NOT_ESTABLISHED","enforcement_points":"NOT_ESTABLISHED","unavailable_behavior":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-policy-vstd-anchor-history-ledger-3da8247007d5; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:anchor-history-ledger-protocol-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:anchor-history-ledger-protocol-applies; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:anchor-history-ledger-protocol-applies; fulfillment NOT_ESTABLISHED."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-robot-vstd-anchor-history-ledger-7c16982848d2; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-robot-vstd-anchor-history-ledger-7c16982848d2; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-robot-vstd-anchor-history-ledger-7c16982848d2; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"NOT_ESTABLISHED","deployment":"NOT_ESTABLISHED","measurements":"NOT_ESTABLISHED","phenomena":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-sensor-vstd-anchor-history-ledger-186d5592ffad; fulfillment NOT_ESTABLISHED."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"NOT_ESTABLISHED","calibration_evidence":"NOT_ESTABLISHED","drift":"NOT_ESTABLISHED","operating_range":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-sensor-vstd-anchor-history-ledger-186d5592ffad; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-sensor-vstd-anchor-history-ledger-186d5592ffad; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The direct caller and locally configured provider/HMAC key authorize record construction; this is not external anchor or signer authority.","effects":"anchor_content mutates the in-memory anchor map and FileAnchorProvider may append one canonical JSONL record to its configured path.","preconditions":"Content identity, digest, epoch, sequence, time, provider configuration, same-id equality, readable existing lines, and parent-directory access are required.","resources":"Resources are the provider's process memory, signing key, configured JSONL path, parent directory, and one canonical serialized record."},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"Creating an anchor mutates memory and may append a JSONL record, with a material memory-before-file partial-failure boundary and duplicate retry rules. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Forks and parse or filesystem errors raise AnchorError or the underlying I/O error; no new file row is intentionally appended after a precondition failure.","commit":"The in-memory effect occurs when the map assignment completes; the file effect occurs when the append write returns. No fsync or cross-resource atomic commit is claimed.","finality":"Finality is local same-id immutability within retained memory or JSONL bytes, not witnessed external finality or crash-durable storage.","partial_failure":"The in-memory map is updated before directory creation and file append, so a later filesystem failure can leave memory ahead of the file; no rollback is implemented."},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"Creating an anchor mutates memory and may append a JSONL record, with a material memory-before-file partial-failure boundary and duplicate retry rules. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"The exact anchor_id is checked in memory and existing JSONL lines; an equal duplicate is idempotent and a differing duplicate is rejected.","idempotency":"Repeating the same complete anchor request preserves one map entry and at most one JSONL row when the existing file remains readable.","replay":"A retry or reload must reproduce the exact record for an existing anchor_id; external effects beyond the local map and file are absent.","retry_limits":"No retry loop or backoff is provided; the caller must inspect failure and retained file state before retrying."},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"Creating an anchor mutates memory and may append a JSONL record, with a material memory-before-file partial-failure boundary and duplicate retry rules. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"In-memory and append-only JSONL continuity-anchor history with duplicate and fork rejection."},"reason":"Anchor ordering, authority and recovery semantics are authoritative-history concerns rather than generic object structure. Creating an anchor mutates memory and may append a JSONL record, with a material memory-before-file partial-failure boundary and duplicate retry rules. Boundary: Local HMAC and file history establish neither external anchoring authority nor physical or financial effects.","specializations":["TRANSACTION"],"surfaces":["file:src/verifier/hardware/anchors.py","python:src/verifier/hardware/anchors.py:<module>","python:src/verifier/hardware/anchors.py:AnchorError","python:src/verifier/hardware/anchors.py:AnchorProvider","python:src/verifier/hardware/anchors.py:AnchorProvider.anchor","python:src/verifier/hardware/anchors.py:AnchorProvider.anchor_content","python:src/verifier/hardware/anchors.py:AnchorProvider.get","python:src/verifier/hardware/anchors.py:AnchorProvider.verify","python:src/verifier/hardware/anchors.py:LocalAnchorProvider","python:src/verifier/hardware/anchors.py:LocalAnchorProvider.__post_init__","python:src/verifier/hardware/anchors.py:LocalAnchorProvider.anchor","python:src/verifier/hardware/anchors.py:LocalAnchorProvider.anchor_content","python:src/verifier/hardware/anchors.py:LocalAnchorProvider.get","python:src/verifier/hardware/anchors.py:LocalAnchorProvider.verify","python:src/verifier/hardware/anchors.py:FileAnchorProvider","python:src/verifier/hardware/anchors.py:FileAnchorProvider.__init__","python:src/verifier/hardware/anchors.py:FileAnchorProvider._load","python:src/verifier/hardware/anchors.py:FileAnchorProvider.anchor_content"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd8566d06a6b596a1ca571bb229f5cc48e","reason":"The configured-key application-authority protocol does not apply as ACTUATOR. core_application_authority.py sends nothing and writes nothing; its only asyncio use is CancelledError, and it calls no process, network, device, or file-write API. Reviewed boundary: A cryptographically valid configured-key application statement is not proof of personhood, legal authority, denominator truth, human acceptance, polish, publication, or release permission.","status":"DOES_NOT_APPLY"},"AGENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ARCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ASSET":{"evidence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd8566d06a6b596a1ca571bb229f5cc48e","reason":"The configured-key application-authority protocol does not apply as ASSET. core_application_authority.py authenticates configured-key statements and represents no quantity, right, custody, or issuance. Reviewed boundary: A cryptographically valid configured-key application statement is not proof of personhood, legal authority, denominator truth, human acceptance, polish, publication, or release permission.","status":"DOES_NOT_APPLY"},"BENCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"COLLECTIVE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"CONTROLLER":{"evidence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd8566d06a6b596a1ca571bb229f5cc48e","reason":"The configured-key application-authority protocol does not apply as CONTROLLER. core_application_authority.py verifies statements and computes no feedback or command selection. Reviewed boundary: A cryptographically valid configured-key application statement is not proof of personhood, legal authority, denominator truth, human acceptance, polish, publication, or release permission.","status":"DOES_NOT_APPLY"},"DATA":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ENV":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"EVENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"FINBOT":{"evidence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd85