"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"NOT_ESTABLISHED","missingness":"NOT_ESTABLISHED","provenance":"NOT_ESTABLISHED","validity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6209ea84e8021a52d2a8214d637c54bc23a87ddf9739ba7cdb1cd7b83ef9ab9d","reason":"reasons.vstd:tier0-measurement-vstd-vgsat-baseline-encoding-policy-767252897d8b; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"vstd-vgsat-baseline-encoding-policy declaration basis sha256:238ffd7428656918a2dc6f7edd32192e145616592b720b847073858bd6284e11 binds exact source experiments/verifier_guided_sat/verifier_guided_sat/baselines.py; source role, necessity, consequence boundary, operands, and path set are hash-bound; declaration text alone establishes no execution truth. Field declaration: vstd-vgsat-baseline-encoding-policy (Complete bounded Arm-A route encodings for stable matching, graph isomorphism and integer factorization.) accepts only its exact current source bytes and the bounded values those sources explicitly admit; undeclared external state is not input.","defaults":"vstd-vgsat-baseline-encoding-policy declaration basis sha256:238ffd7428656918a2dc6f7edd32192e145616592b720b847073858bd6284e11 binds exact source experiments/verifier_guided_sat/verifier_guided_sat/baselines.py; source role, necessity, consequence boundary, operands, and path set are hash-bound; declaration text alone establishes no execution truth. Field declaration: vstd-vgsat-baseline-encoding-policy (Complete bounded Arm-A route encodings for stable matching, graph isomorphism and integer factorization.) treats invalid, unavailable, contradictory, partial, or stale inputs as refusal or UNKNOWN rather than silently inferring success.","precedence":"vstd-vgsat-baseline-encoding-policy declaration basis sha256:238ffd7428656918a2dc6f7edd32192e145616592b720b847073858bd6284e11 binds exact source experiments/verifier_guided_sat/verifier_guided_sat/baselines.