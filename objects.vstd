6:cfd21d586a0abcbf7519e5cefba023682a141650470ab085d81aab8cfcb908f9","reason":"The self-polish case materializer applies as TRANSACTION. Its bounded state or file effect has preconditions, commit, partial-failure, retry, and replay consequences that must be explicit. Exact source-specific basis: A successful invocation creates or replaces one local generated case file; checker calls may run trusted in-process code while preparing its bytes.","status":"APPLIES"},"VERIFIER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"}},"evidence_sets":{"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945":[],"sha256:6f4e589204458d28bfb05084adfd1f48a0cda5d7e3a3efac2be0c67bfaa4885c":[{"path":"scripts/build_self_polish_native_cases.py","sha256":"sha256:e5ef93d86b093b1c50782bfdb1b936e5cd9598f622f64f8d456816fb4e0948a3"}],"sha256:cfd21d586a0abcbf7519e5cefba023682a141650470ab085d81aab8cfcb908f9":[{"path":"scripts/build_self_polish_native_cases.py","sha256":"sha256:e5ef93d86b093b1c50782bfdb1b936e5cd9598f622f64f8d456816fb4e0948a3"},{"path":"scripts/build_self_polish_sim_case_patch.py","sha256":"sha256:0856d9ec8f6a628cf51f4c1db6ae52c5123b225f9a10b2d7e4b86fcdd8fa86ab"},{"path":"scripts/render_self_polish_native_case_module.py","sha256":"sha256:e1e8c8e09d5c0ebf6e88a793732d8ae78fa401b6cfa9a38748e69f942b70fc32"}]},"kind":"TRANSACTION","object_id":"vstd-self-polish-case-materializer","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"Only explicit command-line selection authorizes local materialization; source case metadata is policy input, not authority to claim checker correctness or polish.","commands":"Invoke exact native builders/recheckers for selected cases and write one generated patch or module to the caller-selected filesystem target.","effect_domains":"LOCAL_GENERATED_CASE_FILE_ONLY","targets":"The selected generated Python module or patch file and bounded in-memory case payload; no package installation, import activation, or publication target."},"evidence_set_digest":"sha256:cfd21d586a0abcbf7519e5cefba023682a141650470ab085d81aab8cfcb908f9","reason":"The self-polish case materializer applies as ACTUATOR. It issues a process or filesystem command with a named target while keeping successful submission separate from downstream truth. Exact source-specific basis: Invoke exact native builders/recheckers for selected cases and write one generated patch or module to the caller-selected filesystem target. This Tier-0 declaration names the reviewed boundary only; execution and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"Schema, tier, entry counts, byte/decompression bounds, digest bindings, exact checker names and expected outcomes bound accepted materialization.","response":"The materializer observes selected source bytes, schema/count/digest checks, checker rebuild correspondence, rendered byte length, and output write success.","saturation":"Import, schema, count, digest, decompression, checker correspondence, rendering, or I/O failure aborts; direct output replacement can leave prior loss or partial bytes.","units_and_frames":"Discrete cases and entries, exact UTF-8 bytes, byte caps, and SHA-256 digests."},"evidence_set_digest":"sha256:cfd21d586a0abcbf7519e5cefba023682a141650470ab085d81aab8cfcb908f9","reason":"The self-polish case materializer applies as ACTUATOR. It issues a process or filesystem command with a named target while keeping successful submission separate from downstream truth. Exact source-specific basis: Invoke exact native builders/recheckers for selected cases and write one generated patch or module to the caller-selected filesystem target. This Tier-0 declaration names the reviewed boundary only; execution and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.3-feedback-and-interlocks":{"declaration":{"effect_feedback":"The materializer observes selected source bytes, schema/count/digest checks, checker rebuild correspondence, rendered byte length, and output write success.","failure_states":"Import, schema, count, digest, decompression, checker correspondence, rendering, or I/O failure aborts; direct output replacement can leave prior loss or partial bytes.","interlocks":"Load and validate before rebuilding, validate refreshed entries before rendering, and render the complete payload before opening the selected output for replacement.","recovery":"Inspect the selected output after uncertainty, repair the exact source/checker or destination, and perform a fresh bounded render; never infer installation from a write."},"evidence_set_digest":"sha256:cfd21d586a0abcbf7519e5cefba023682a141650470ab085d81aab8cfcb908f9","reason":"The self-polish case materializer applies as ACTUATOR. It issues a process or filesystem command with a named target while keeping successful submission separate from downstream truth. Exact source-specific basis: Invoke exact native builders/recheckers for selected cases and write one generated patch or module to the caller-selected filesystem target. This Tier-0 declaration names the reviewed boundary only; execution and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"NOT_ESTABLISHED","precision":"NOT_ESTABLISHED","rights":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6f4e589204458d28bfb05084adfd1f48a0cda5d7e3a3efac2be0c67bfaa4885c","reason":"reasons.vstd:tier0-asset-vstd-self-polish-case-materializer-1f45901d8930; fulfillment NOT_ESTABLISHED."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"NOT_ESTABLISHED","issuance_authority":"NOT_ESTABLISHED","redemption":"NOT_ESTABLISHED","supply_changes":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6f4e589204458d28bfb05084adfd1f48a0cda5d7e3a3efac2be0c67bfaa4885c","reason":"reasons.vstd:tier0-asset-vstd-self