},"evidence_set_digest":"sha256:d9c350770966a944451a3c59cdf82e6ca6dd7c7ae0b4c0adeca0684ded1c9cf5","reason":"reasons.vstd:tier0-actuator-vstd-token-cdc76b58ba4b; fulfillment NOT_ESTABLISHED."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"Each retained capability claim has an exact token identifier, replay identifier, kind, issuing-key identifier, signature and canonical preimage within one selected holding.","precision":"Identifiers, commitments, signatures and digests compare exactly; counters and instants are exact bounded integers, with clock-skew boundaries reported as undetermined rather than rounded.","rights":"Scopes, audiences, windows and caveats are a recorded capability claim, not an authority grant, legal right, financial instrument, ownership proof, or evidence that an application will honor it.","units":"Tokens and invocations are dimensionless counts; epochs are dimensionless; issued-at, windows, status publication and skew are integers on the one declared microsecond clock."},"evidence_set_digest":"sha256:90270fd3b96afed5564e1b079836e90a88d60a955501e614720ed35f73445538","reason":"A TOKEN records a claimed scoped capability with identity, issuance, delegation, windows, caveats, revocation and backing questions. ASSET applies to that nonfinancial claim while the declaration explicitly denies inferred authority or ownership. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"Cryptographic binding, attenuation and freshness checks back only the exact recorded relationships. Legal, organizational, application, physical and financial backing remain unestablished.","issuance_authority":"A verified signature identifies an admitted issuing key for the canonical bytes. The checker policy admits keys, but neither key possession nor signature authenticates the issuer's real authority.","redemption":"No redemption, invocation, application access, money conversion, settlement, or consumption occurs. Downstream use requires separate current application authority and effect evidence.","supply_changes":"Retained birth, aging and lifetime records describe issuance and delegation, while epoch/status traces describe suspension or revocation; the checker itself creates, transfers, redeems or destroys no token."},"evidence_set_digest":"sha256:90270fd3b96afed5564e1b079836e90a88d60a955501e614720ed35f73445538","reason":"A TOKEN records a claimed scoped capability with identity, issuance, delegation, windows, caveats, revocation and backing questions. ASSET applies to that nonfinancial claim while the declaration explicitly denies inferred authority or ownership. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.3-custody-and-encumbrance":{"declaration":{"control":"Delegate keys, confirmation keys, soulbound flags, scopes and caveats constrain the recorded capability path but do not prove exclusive control or prevent use outside this checker.","custody":"The checker temporarily holds selected immutable token bytes. Byte possession is not custody of an underlying right, secret key, account, asset, or application authority.","encumbrances":"Parent scopes, time windows, invocation ceilings, caveats, soulbound restrictions, audience, suspension, revocation, key retirement and status freshness are explicit recorded encumbrances.","reconciliation":"Reconciliation is exact replay of identifiers, parent paths, epoch accumulator, signatures, audiences, windows and latest bounded statuses under the current selected policy; no external authority system is reconciled."},"evidence_set_digest":"sha256:90270fd3b96afed5564e1b079836e90a88d60a955501e614720ed35f73445538","reason":"A TOKEN records a claimed scoped capability with identity, issuance, delegation, windows, caveats, revocation and backing questions. ASSET applies to that nonfinancial claim while the declaration explicitly denies inferred authority or ownership. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"CONTROLLER-0.1-feedback-and-authority":{"declaration":{"authority":"NOT_ESTABLISHED","commands":"NOT_ESTABLISHED","feedback":"NOT_ESTABLISHED","objectives":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:d9c350770966a944451a3c59cdf82e6ca6dd7c7ae0b4c0adeca0684ded1c9cf5","reason":"reasons.vstd:tier0-controller-vstd-token-8d31af21447e; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.2-timing-and-stability":{"declaration":{"operating_envelope":"NOT_ESTABLISHED","saturation":"NOT_ESTABLISHED","stability_assumptions":"NOT_ESTABLISHED","timing":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:d9c350770966a944451a3c59cdf82e6ca6dd7c7ae0b4c0adeca0684ded1c9cf5","reason":"reasons.vstd:tier0-controller-vstd-token-8d31af21447e; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"NOT_ESTABLISHED","failure_behavior":"NOT_ESTABLISHED","feedback_loss":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:d9c350770966a944451a3c59cdf82e6ca6dd7c7ae0b4c0adeca0684ded1c9cf5","reason":"reasons.vstd:tier0-controller-vstd-token-8d31af21447e; fulfillment NOT_ESTABLISHED."},"FINBOT-0.1-agent-and-financial-authority":{"declaration":{"agent":"NOT_ESTABLISHED","decision_scope":"NOT_ESTABLISHED","financial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:d9c350770966a944451a3c59cdf82e6ca6dd7c7ae0b4c0adeca0684ded1c9cf5","reason":"reasons.vstd:tier0-finbot-vstd-token-6f9bb276f921; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"