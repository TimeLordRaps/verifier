5a66e6085d871942d7df51f7713fef901e8d8220":[{"path":"src/verifier/domains/contracts/robot_checks.py","sha256":"sha256:403d84725192917af694d3c84d4a475a22a1fc35a8a15c1b91741bf5f916df00"},{"path":"src/verifier/runtime/added_kind_behavioral_routes.py","sha256":"sha256:19f121645632ef499d6dc60ff5fc8b7ab7c0ed8a3fc34cdf9d023cbf44687775"}],"sha256:80e40fd7185fa1944b9ff86229980604166a1815b5c22f421a52551201570e41":[{"path":"src/verifier/domains/contracts/market_checks.py","sha256":"sha256:2a7716c17e6ba95be2c0c812d4862037f515baf1b6407560b43cb28bb07ba159"},{"path":"src/verifier/runtime/added_kind_behavioral_routes.py","sha256":"sha256:19f121645632ef499d6dc60ff5fc8b7ab7c0ed8a3fc34cdf9d023cbf44687775"}],"sha256:b036d1856154c8e45c8b749431538700d1c2414556232697b9120ed744ba8728":[{"path":"src/verifier/runtime/added_kind_behavioral_routes.py","sha256":"sha256:19f121645632ef499d6dc60ff5fc8b7ab7c0ed8a3fc34cdf9d023cbf44687775"}],"sha256:e073587b46d44f9dd79dd9bf9af9bddc0725bcaaad76466856722e70dfb2e081":[{"path":"src/verifier/domains/contracts/finbot_checks.py","sha256":"sha256:c1f75930f077067855ff90cfd9f5ce5c1d1fe287d0427bf2c1c826f4266bf94a"},{"path":"src/verifier/runtime/added_kind_behavioral_routes.py","sha256":"sha256:19f121645632ef499d6dc60ff5fc8b7ab7c0ed8a3fc34cdf9d023cbf44687775"}]},"kind":"VERIFIER","object_id":"vstd-added-kind-behavioral-verifier","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"Installed route and policy code select the proposition, checker, limits, and nonpromotion boundary and authorize only the named local worker launch. Caller-supplied trust-root labels and retained records grant no venue, physical, legal, publication, or release authority; actual financial authority is NOT_ESTABLISHED.","commands":"Call installed route selection, strict decoding, digest, finite domain-evaluation, consequence-graph assessment, certificate construction, and certificate recheck functions, or launch only the exact installed POLICY observation worker as python -I -S -B; no subject-authored command is executed.","effect_domains":"BOUNDED_LOCAL_SOFTWARE_PROCESS_ACTUATION_AND_RETAINED_BYTE_VERIFICATION_ONLY; the checker may launch its exact isolated observation worker and otherwise parses, hashes, and replays supplied records, but performs no participant exchange, trading, settlement, physical actuation, real-money movement, or represented runtime correspondence.","targets":"One caller-supplied immutable retained-evidence payload, one exact installed MARKET/ROBOT/FINBOT route and evaluator, current mechanism sources, the exact local POLICY observation worker when selected, and one in-memory certificate."},"evidence_set_digest":"sha256:b036d1856154c8e45c8b749431538700d1c2414556232697b9120ed744ba8728","reason":"added-kind retained-evidence VERIFIER applies as ACTUATOR. Its owned source connects an accepted command to a represented real or simulated effect endpoint and exposes effect feedback plus an explicit failure surface. Submission, dispatch, replay, callback entry, or child-process launch alone is insufficient. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"Canonical closed schemas, one exact registered route, one to sixteen sorted unique trust-root labels, at most 4 MiB of evidence, 4096 retained records per selected collection, at most 8 MiB per certificate, bounded identifiers, plain integer quantities, one exact isolated worker command per observation acquisition, one positive timeout, and exact SHA-256 commitments fail closed.","response":"Current mechanism and proposition digests, exact policy/request/evidence bindings, selected route and source coordinate, finite retained lifecycle or consequence relationships, worker return status, response bytes, nonce, schema, and source pins where launched, typed PASS/FAIL/UNKNOWN reason, explicit NOT_ESTABLISHED fields, and reproduced certificate digest.","saturation":"Malformed, noncanonical, mutated, stale, foreign, digest-inconsistent, or contradictory evidence and certificates FAIL; absent or explicitly incomplete retained evidence and bounded-resource exhaustion remain UNKNOWN. Worker launch errors or timeouts are unavailable, nonzero status is failed, and malformed, nonce-mismatched, or source-drifted output is refused; none is promoted to runtime truth or external safety.","units_and_frames":"Evidence and certificate bytes, retained record and trust-root counts, integer price/quantity/exposure/sequence units declared by the retained evidence, and SHA-256 identities; worker timeouts use integer seconds and process completion uses one integer return code."},"evidence_set_digest":"sha256:b036d1856154c8e45c8b749431538700d1c2414556232697b9120ed744ba8728","reason":"added-kind retained-evidence VERIFIER applies as ACTUATOR. Its owned source connects an accepted command to a represented real or simulated effect endpoint and exposes effect feedback plus an explicit failure surface. Submission, dispatch, replay, callback entry, or child-process launch alone is insufficient. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.3-feedback-and-interlocks":{"declaration":{"effect_feedback":"Current mechanism and proposition digests, exact policy/request/evidence bindings, selected route and source coordinate, finite retained lifecycle or consequence relationships, worker return status, response bytes, nonce, schema, and source pins where launched, typed PASS/FAIL/UNKNOWN reason, explicit NOT_ESTABLISHED fields, and reproduced certificate digest.","failure_states":"Malformed, noncanonical, mutated, stale, foreign, digest-inconsistent, or contradictory evidence and certificates FAIL; absent or explicitly incomplete retained evidence and bounded-resource exhaustion remain UNKNOWN. Worker launch errors or timeouts are unavailable, nonzero status is failed, and malformed, nonce-mismatched, or source-drifted output is refused; none is promoted to runtime truth or external safety.","interlocks":"Validate the current policy, mechanism, route, proposition, request, limits, and evidence reference before decoding retained bytes; for observation acquisition, construct the fixed nonce request before the isolated worker launch and accept output only after return-code, schema, nonce, and source-pin checks; evaluate only the selected route; bind the result and nonpromotion fields before the envelope digest; on recheck, validate the envelope and rebuild it exactly before returning.","recovery":"Select the exact current route and policy, restore current source/proposition bindings and worker availability, supply a complete bounded canonical retained payload, and perform a fresh full acquisition, build, or recheck; never edit or trust a partial response or certificate. Real-world financial reconciliation and recovery remain NOT_ESTABLISHED."},"evidence_set_digest":"sha256:b036d1856154c8e45c8b749431538700d1c2414556232697b9120ed744ba8728","reason":"added-kind retained-evidence VERIFIER applies as ACTUATOR. Its owned source connects an accepted command to a represented real or simulated effect endpoint and exposes effect feedback plus an explicit failure surface. Submission, dispatch, replay, callback entry, or child-process launch alone is insufficient. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"An exact kind/check/subject/source selection, current proposition and mechanism digests, an immutable evidence-byte reference, sorted unique trust-root labels, a policy digest, retained asset and party identifiers where selected, and finite evidence-byte, record, and certificate ceilings.","precision":"Canonical closed schemas, one exact registered route, one to sixteen sorted unique trust-root labels, at most 4 MiB of evidence, 4096 retained records per selected collection, at most 8 MiB per certificate, bounded identifiers, plain integer quantities, one exact isolated worker command per observation acquisition, one positive timeout, and exact SHA-256 commitments fail closed.","rights":"Installed route and policy code select the proposition, checker, limits, and nonpromotion boundary and authorize only the named local worker launch. Caller-supplied trust-root labels and retained records grant no venue, physical, legal, publication, or release authority; actual financial authority is NOT_ESTABLISHED.","units":"Evidence and certificate bytes, retained record and trust-root counts, integer price/quantity/exposure/sequence units declared by the retained evidence, and SHA-256 identities; worker timeouts use integer seconds and process completion uses one integer return code."},"evidence_set_digest":"sha256:007780e146ef72134bcddc919e0b9d80736c5150920516d35e38feb0cb3dba7d","reason":"added-kind retained-evidence VERIFIER applies as ASSET. Its retained identity, quantity, rights, backing, custody, and encumbrance references require explicit asset boundaries even though external asset truth remains unestablished. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"This is a first-party VERIFIER with bounded local software actuation for one exact isolated POLICY observation worker. Its retained records and certificate lifecycle carry the twelve review-kind roles so their obligations cannot be discarded. These are bounded checker and evidence roles, not promotion to represented subjects: an actual financial or physical AGENT, HARNESS binding, live market participant, venue, financial authority, exposure, real-world endpoint, physical reach, effect, safety, settlement, and reconciliation are NOT_ESTABLISHED. The checker commands no represented subject, performs no external participant exchange, physical actuation, settlement, or real-money movement, and does not establish runtime correspondence; asset backing and custody are NOT_ESTABLISHED. It does not establish full-application polish, publication, release, or deployment.","issuance_authority":"Installed route and policy code select the proposition, checker, limits, and nonpromotion boundary and authorize only the named local worker launch. Caller-supplied trust-root labels and retained records grant no venue, physical, legal, publication, or release authority; actual financial authority is NOT_ESTABLISHED.","redemption":"Select the exact current route and policy, restore current source/proposition bindings and worker availability, supply a complete bounded canonical retained payload, and perform a fresh full acquisition, build, or recheck; never edit or trust a partial response or certificate. Real-world financial reconciliation and recovery remain NOT_ESTABLISHED.","supply_changes":"Launch at most one selected local POLICY observation subprocess per acquisition, write its bounded nonce request to standard input, capture its return code and output, read current checker sources and caller-supplied bytes, compute digests, replay finite retained relationships, and return certificate bytes or a typed refusal without commanding the represented external system."},"evidence_set_digest":"sha256:007780e146ef72134bcddc919e0b9d80736c5150920516d35e38feb0cb3dba7d","reason":"added-kind retained-evidence VERIFIER applies as ASSET. Its retained identity, quantity, rights, backing, custody, and encumbrance references require explicit asset boundaries even though external asset truth remains unestablished. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.3-custody-and-encumbrance":{"declaration":{"control":"Call installed route selection, strict decoding, digest, finite domain-evaluation, consequence-graph assessment, certificate construction, and certificate recheck functions, or launch only the exact installed POLICY observation worker as python -I -S -B; no subject-authored command is executed.","custody":"One caller-supplied immutable retained-evidence payload, one exact installed MARKET/ROBOT/FINBOT route and evaluator, current mechanism sources, the exact local POLICY observation worker when selected, and one in-memory certificate.","encumbrances":"Malformed, noncanonical, mutated, stale, foreign, digest-inconsistent, or contradictory evidence and certificates FAIL; absent or explicitly incomplete retained evidence and bounded-resource exhaustion remain UNKNOWN. Worker launch errors or timeouts are unavailable, nonzero status is failed, and malformed, nonce-mismatched, or source-drifted output is refused; none is promoted to runtime truth or external safety.","reconciliation":"Current mechanism and proposition digests, exact policy/request/evidence bindings, selected route and source coordinate, finite retained lifecycle or consequence relationships, worker return status, response bytes, nonce, schema, and source pins where launched, typed PASS/FAIL/UNKNOWN reason, explicit NOT_ESTABLISHED fields, and reproduced certificate digest."},"evidence_set_digest":"sha256:007780e146ef72134bcddc919e0b9d80736c5150920516d35e38feb0cb3dba7d","reason":"added-kind retained-evidence VERIFIER applies as ASSET. Its retained identity, quantity, rights, backing, custody, and encumbrance references require explicit asset boundaries even though external asset truth remains unestablished. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"CONTROLLER-0.1-feedback-and-authority":{"declaration":{"authority":"Installed route and policy code select the proposition, checker, limits, and nonpromotion boundary and authorize only the named local worker launch. Caller-supplied trust-root labels and retained records grant no venue, physical, legal, publication, or release authority; actual financial authority is NOT_ESTABLISHED.","commands":"Call installed route selection, strict decoding, digest, finite domain-evaluation, consequence-graph assessment, certificate construction, and certificate recheck functions, or launch only the exact installed POLICY observation worker as python -I -S -B; no subject-authored command is executed.","feedback":"Current mechanism and proposition digests, exact policy/request/evidence bindings, selected route and source coordinate, finite retained lifecycle or consequence relationships, worker return status, response bytes, nonce, schema, and source pins where launched, typed PASS/FAIL/UNKNOWN reason, explicit NOT_ESTABLISHED fields, and reproduced certificate digest.","objectives":"Select one of nine exact source-registered MARKET, ROBOT, or FINBOT propositions and construct or independently recheck its bounded retained-byte certificate without executing the represented subject; for POLICY observations, launch one exact isolated local worker and retain its bounded response. The applicable ASSET boundary retains an obligation-bearing FINBOT consequence role without promoting a represented financial effect."},"evidence_set_digest":"sha256:b036d1856154c8e45c8b749431538700d1c2414556232697b9120ed744ba8728","reason":"added-kind retained-evidence VERIFIER applies as CONTROLLER. Its state, feedback, admission decisions, commands, timing, and intervention behavior form a bounded software control loop. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"CONTROLLER-0.2-timing-and-stability":{"declaration":{"operating_envelope":"Canonical closed schemas, one exact registered route, one to sixteen sorted unique trust-root labels, at most 4 MiB of evidence, 4096 retained records per selected collection, at most 8 MiB per certificate, bounded identifiers, plain integer quantities, one exact isolated worker command per observation acquisition, one positive timeout, and exact SHA-256 commitments fail closed.","saturation":"Malformed, noncanonical, mutated, stale, foreign, digest-inconsistent, or contradictory evidence and certificates FAIL; absent or explicitly incomplete retained evidence and bounded-resource exhaustion remain UNKNOWN. Worker launch errors or timeouts are unavailable, nonzero status is failed, and malformed, nonce-mismatched, or source-drifted output is refused; none is promoted to runtime truth or external safety.","stability_assumptions":"added-kind retained-evidence VERIFIER controls a bounded software lifecycle, not a proved dynamical plant; safe downstream stability remains outside this Tier-0 claim.","timing":"The local observation worker has an explicit caller-selected timeout (180 seconds by default); timeout is refusal evidence, not a scheduler or external progress guarantee. Other work is bounded by selected byte and record ceilings."},"evidence_set_digest":"sha256:b036d1856154c8e45c8b749431538700d1c2414556232697b9120ed744ba8728","reason":"added-kind retained-evidence VERIFIER applies as CONTROLLER. Its state, feedback, admission decisions, commands, timing, and intervention behavior form a bounded software control loop. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"Validate the current policy, mechanism, route, proposition, request, limits, and evidence reference before decoding retained bytes; for observation acquisition, construct the fixed nonce request before the isolated worker launch and accept output only after return-code, schema, nonce, and source-pin checks; evaluate only the selected route; bind the result and nonpromotion fields before the envelope digest; on re