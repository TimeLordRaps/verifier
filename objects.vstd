titioned, challenged, attested, execution-started, observed, completed, anchored, and reset.","transitions":"Typed methods move the in-memory state only after lifecycle, identity, capacity, and chain checks and append corresponding accounting records."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Caller, emulator, anchor provider, and verifier participate in an ordered boot/challenge/attestation/execution/accounting state machine. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"Package dataclasses, schema/version constants, supported state methods, canonical hashes, and receipt types define local compatibility.","message_authority":"Direct calls identify the caller only by process access; HMAC evidence is a test trust root and an external AnchorProvider is separately selected.","ordering":"Epoch and sequence increase monotonically, rolling roots link events, and challenge/execution predecessors constrain later records.","replay":"Duplicate or out-of-order identities are bounded by current state; there is no generic exactly-once remote transport or physical-command replay guarantee."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Caller, emulator, anchor provider, and verifier participate in an ordered boot/challenge/attestation/execution/accounting state machine. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"Caller values, order, quantities, keys, provider behavior, and process lifetime may fail; physical correspondence and durable storage are not assumed.","liveness":"No command, provider, execution, or verifier progress guarantee exists; a protocol state may remain incomplete indefinitely.","recovery":"A caller may inspect records, reset the simulated epoch, or rebuild a new instance from external retained inputs; full durable replay is outside this source.","safety":"Invariant checks and hash-linked events prevent accepted simulated transitions from silently bypassing current lifecycle and accounting state."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Caller, emulator, anchor provider, and verifier participate in an ordered boot/challenge/attestation/execution/accounting state machine. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-robot-vstd-firmware-emulator-accounting-593364c79197; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-robot-vstd-firmware-emulator-accounting-593364c79197; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-robot-vstd-firmware-emulator-accounting-593364c79197; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"NOT_ESTABLISHED","deployment":"NOT_ESTABLISHED","measurements":"NOT_ESTABLISHED","phenomena":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-sensor-vstd-firmware-emulator-accounting-cffb23e5e5f6; fulfillment NOT_ESTABLISHED."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"NOT_ESTABLISHED","calibration_evidence":"NOT_ESTABLISHED","drift":"NOT_ESTABLISHED","operating_range":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-sensor-vstd-firmware-emulator-accounting-cffb23e5e5f6; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-sensor-vstd-firmware-emulator-accounting-cffb23e5e5f6; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The direct Python caller invokes every mutation; the test HMAC key and provider bind simulated evidence but do not authenticate a physical operator.","effects":"Configuration, boot, challenge, attestation, execution submission/observation/completion, anchor, and reset mutate bounded in-memory simulated device state.","preconditions":"Device lifecycle state, capacity, unique identities, matching executions/challenges, valid quantities, event continuity, and selected provider conditions must hold.","resources":"Resources are one emulator instance, finite partitions and record lists, simulated capacity, test keys, caller values, and an optional anchor provider."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its commands mutate multi-part in-memory state and sometimes an anchor provider, requiring explicit precondition, commit, partial-failure, retry, and replay boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"FirmwareContractError rejects invalid state, capacity, identity, order, or continuity; no external physical effect is initiated.","commit":"Each method commits when its validated state fields and corresponding accounting event/list entries have been updated and the method returns.","finality":"Committed state is final only for the current in-memory simulated prefix and epoch; it is neither crash-durable nor externally witnessed unless a separate anchor is successfully retained.","partial_failure":"Methods make multiple in-memory updates and anchor may call an external provider; Python exceptions or provider failures can require inspection of retained state because no general rollback transaction exists."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its commands mutate multi-part in-memory state and sometimes an anchor provider, requiring explicit precondition, commit, partial-failure, retry, and replay boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"Execution, challenge, partition, boot, sequence, and lifecycle identities plus current lists and roots detect bounded conflicts; duplicate semantics vary by command.","idempotency":"Commands are not generically idempotent. A caller must inspect sequence, epoch, ids, and retained records before retrying after an ambiguous failure.","replay":"A retry must respect current epoch/sequence and exact ids. Receipt or accounting replay demonstrates simulated continuity, not repetition of physical work.","retry_limits":"No automatic retry or backoff is implemented; capacity and lifecycle rules bound admissible attempts, and the caller owns retry count."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its commands mutate multi-part in-memory state and sometimes an anchor provider, requiring explicit precondition, commit, partial-failure, retry, and replay boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Virtual accelerator command, simulated effect and append-only firmware-accounting state machine."},"reason":"The emulator combines authoritative accounting with command-to-effect control, so generic HARDWARE ownership loses necessary ledger and actuation questions. Caller, emulator, anchor provider, and verifier participate in an ordered boot/challenge/attestation/execution/accounting state machine. Its commands mutate multi-part in-memory state and sometimes an anchor provider, requiring explicit precondition, commit, partial-failure, retry, and replay boundaries. Boundary: Software simulation only: no physical actuator, live sensor, tamper-resistance, ROBOT, confinement or real-money claim is made.","specializations":["ACTUATOR","CONTROLLER","PROTOCOL","TRANSACTION"],"surfaces":["file:src/verifier/hardware/emulator.py","python:src/verifier/hardware/emulator.py:<module>","python:src/verifier/hardware/emulator.py:FirmwareContractError","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.__post_init__","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.physical_identity_id","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.evidence_source_id","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.current_topology_snapshot_id","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.descriptor","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.physical_identity","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.configure_partitions","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.boot","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.firmware_measurement","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.issue_challenge","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.attest","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.submit_execution","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.observe_execution","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.complete_execution","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.anchor","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.reset","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.continuity_record","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.build_receipt","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.topology_snapshot","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator._remember_topology","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator.capability_declarations","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator._append_event","python:src/verifier/hardware/emulator.py:VirtualVSTDAccelerator._logical_partition"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:a218ebb62061f024b95d0f133678414f21d058630446c1c1bc69e08c4f328e33","reason":"vstd-first-software-workflow-declarations is explicitly DOES_NOT_APPLY for ACTUATOR after a current-source audit. Exact owned source denominator: examples/first_