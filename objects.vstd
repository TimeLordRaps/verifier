sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945":[],"sha256:f5370223b803c0feb19cc14775e0947625ea50be0d5648c4e3dc5669595e8952":[{"path":"src/verifier/hardware/validation.py","sha256":"sha256:7de4b1734322454db453a1d44bdde1e0b6608d6450b310993489952964b515f0"}]},"kind":"VERIFIER","object_id":"vstd-hardware-receipt-validator","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"vstd-hardware-receipt-validator declaration basis sha256:b04f85a4c2cc6d4d6acbdf3018877aaf9ed3118aad6afc403d941148c774f86a binds exact source src/verifier/hardware/validation.py; source role, necessity, consequence boundary, operands, and path set are hash-bound; declaration text alone establishes no execution truth. Field declaration: vstd-hardware-receipt-validator (Bounded policy validation of supplied hardware receipts.) has only caller invocation and source-declared authority. Ownership review grants no human, legal, physical, financial, or release authority.","commands":"vstd-hardware-receipt-validator declaration basis sha256:b04f85a4c2cc6d4d6acbdf3018877aaf9ed3118aad6afc403d941148c774f86a binds exact source src/verifier/hardware/validation.py; source role, necessity, consequence boundary, operands, and path set are hash-bound; declaration text alone establishes no execution truth. Field declaration: vstd-hardware-receipt-validator (Bounded policy validation of supplied hardware receipts.) can submit only calls, callbacks, decisions, or records implemented by its owned sources; downstream effects require separate evidence.","effect_domains":"vstd-hardware-receipt-validator declaration basis sha256:b04f85a4c2cc6d4d6acbdf3018877aaf9ed3118aad6afc403d941148c774f86a binds exact source src/verifier/hardware/validation.py; source role, necessity, consequence boundary, operands, and path set are hash-bound; declaration text alone establishes no execution truth. Field declaration: vstd-hardware-receipt-validator (Bounded policy validation of supplied ha