ence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-sensor-vstd-privacy-emission-policy-f8f1642f26f7; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:713c5e1f94fee50f4342b6e1d0645623bfefe8dc2bf8ddd663f1b63486c1d8a6","reason":"reasons.vstd:tier0-sensor-vstd-privacy-emission-policy-f8f1642f26f7; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"Only caller-supplied policy, consent, observer, governance, and in-memory budget configuration authorizes a local decision; the receipt is not its own authority.","effects":"Evaluation can mutate the supplied in-memory budget counters and return admitted/redacted bytes plus a receipt; it performs no publication, network call, or atomic invocation consumption.","preconditions":"Finite captured certificate bytes, explicit disclosure bounds, observer context, join rules, consent/governance facts, and any mutable budget state are the decision inputs.","resources":"Targets are in-memory certificate projections, privacy budget counters, and returned local decision/receipt records; no network recipient is contacted."},"evidence_set_digest":"sha256:e4e84ccfa8e974303b9709066400bca9af7081af2198d0ba13b627584c293ad2","reason":"The bounded privacy-emission evaluator applies as TRANSACTION. Its named local change, response-dependent finality, retry behavior, and partial-failure state require an explicit transaction boundary. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Missing bounds, observer mismatch, unsafe composition, malformed input, budget exhaustion, concurrent mutation, or replay mismatch fails closed without external emission.","commit":"A successful call returns one bound local result after all configured checks and any budget consumption; no durable, concurrent, or cross-process commit is provided.","finality":"A successful call returns one bound local result after all configured checks and any budget consumption; no durable, concurrent, or cross-process commit is provided. Finality is limited to the named local state and grants no application-wide correctness, publication, physical, or financial authority.","partial_failure":"Missing bounds, observer mismatch, unsafe composition, malformed input, budget exhaustion, concurrent mutation, or replay mismatch fails closed without external emission."},"evidence_set_digest":"sha256:e4e84ccfa8e974303b9709066400bca9af7081af2198d0ba13b627584c293ad2","reason":"The bounded privacy-emission evaluator applies as TRANSACTION. Its named local change, response-dependent finality, retry behavior, and partial-failure state require an explicit transaction boundary. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"A repeated call is a new evaluation and may consume a mutable budget again; callers must coordinate shared state and cannot infer idempotency from matching inputs.","idempotency":"A repeated call is a new evaluation and may consume a mutable budget again; callers must coordinate shared state and cannot infer idempotency from matching inputs. These are the exact retry semantics; no broader idempotency is inferred.","replay":"Recovery requires corrected current inputs or an explicitly coordinated fresh budget/evaluation; callers may not treat a reset mutable object as reconciled history.","retry_limits":"Finite JSON shape/bytes, exact bound coverage, allowed observers, composition screens, nonnegative finite epsilon/delta, and configured maxima bound admission."},"evidence_set_digest":"sha256:e4e84ccfa8e974303b9709066400bca9af7081af2198d0ba13b627584c293ad2","reason":"The bounded privacy-emission evaluator applies as TRANSACTION. Its named local change, response-dependent finality, retry behavior, and partial-failure state require an explicit transaction boundary. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Controlled privacy-emission policy and in-memory differential-privacy budget accounting."},"reason":"Emission rules and mutable privacy-budget consumption require explicit precedence, authorization, accounting, duplicate and correction semantics. Boundary: The accounting is in-memory, non-durable and non-concurrent; these paths execute no caller callback or external transmission and prove no downstream recipient behavior.","specializations":["LEDGER","TRANSACTION"],"surfaces":["file:src/verifier/controlled_emission.py","python:src/verifier/controlled_emission.py:<module>","python:src/verifier/controlled_emission.py:_InputCaptureRefused","python:src/verifier/controlled_emission.py:_CaptureBudget","python:src/verifier/controlled_emission.py:_CaptureBudget.__init__","python:src/verifier/controlled_emission.py:_capture_inputs","python:src/verifier/controlled_emission.py:_capture_inputs.charge","python:src/verifier/controlled_emission.py:_capture_inputs.charge_text","python:src/verifier/controlled_emission.py:_capture_inputs.copy","python:src/verifier/controlled_emission.py:evaluate_controlled_emission","python:src/verifier/controlled_emission.py:evaluate_controlled_current_emission","python:src/verifier/controlled_emission.py:_evaluate_controlled_emission","python:src/verifier/controlled_emission.py:_evaluate_controlled_emission.finish","python:src/verifier/controlled_emission.py:recheck_controlled_current_emission","file:src/verifier/privacy/__init__.py","python:src/verifier/privacy/_