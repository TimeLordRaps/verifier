,"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-finbot-vstd-model-68e90f9067b2; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-finbot-vstd-model-68e90f9067b2; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"NOT_ESTABLISHED","history":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","state":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-ledger-vstd-model-fe35541cd4dc; fulfillment NOT_ESTABLISHED."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"NOT_ESTABLISHED","rounding":"NOT_ESTABLISHED","sources_and_sinks":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-ledger-vstd-model-fe35541cd4dc; fulfillment NOT_ESTABLISHED."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"NOT_ESTABLISHED","reconciliation":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-ledger-vstd-model-fe35541cd4dc; fulfillment NOT_ESTABLISHED."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-market-vstd-model-0af4203433a2; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-market-vstd-model-0af4203433a2; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-market-vstd-model-0af4203433a2; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"Replay dense-model arithmetic and metrics, then launch the fixed worker under each selected committed-memory cap for every trial and compare its bounded output with the selected expected vector.","observation_vs_estimate":"Metric values are deterministic source-bound computations; the hardware bracket is a fresh local parent-interface observation. Neither is an estimate of universal model quality or intrinsic minimum memory.","phenomenon":"Finite MODEL outputs and evaluation metrics under exact retained architecture and weights, plus lower-cap exhaustion and upper-cap completion for one selected workload on the current Windows CPU runtime.","source":"Exact retained model artifacts, finite samples or workload, parent-observed Job Object configuration, child exit and bounded stdout/stderr, current machine and Python identity, and installed source digests."},"evidence_set_digest":"sha256:f892a0750c04315455f7f587133b61a418ee5a9e6a441212cc0bea074315cbe8","reason":"The MODEL implementation recomputes finite outputs and metrics and, at MODEL-3.2, freshly observes a selected lower/upper committed-memory execution bracket on the current Windows CPU runtime. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"Each status arrives when the parent observes the bounded child completion and captures its exit and streams; child-internal event timing is not reconstructed.","observation_time":"Fresh child observations occur in invocation order during certificate evaluation; no authenticated wall-clock instant or device-internal sample time is retained.","reference_frame":"Values are relative to the exact MODEL bytes, input or sample set, tolerance, current machine, Windows CPython version, execution backend, selected caps, and installed checker source.","uncertainty":"No physical calibration, resident-memory value, hardware authenticity, cross-runtime interval, universal minimum, or statistical quality confidence is established; those remain explicit exclusions.","units":"Committed-memory caps count bytes; trials, operations, layers and samples are dimensionless; dense outputs and supported metrics use ordered Python binary64 values in the selected contract frame."},"evidence_set_digest":"sha256:f892a0750c04315455f7f587133b61a418ee5a9e6a441212cc0bea074315cbe8","reason":"The MODEL implementation recomputes finite outputs and metrics and, at MODEL-3.2, freshly observes a selected lower/upper committed-memory execution bracket on the current Windows CPU runtime. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"The hardware bracket is fresh for this evaluation and current runtime only; retained model metrics are fresh only to the selected bytes and no claim survives source, runtime, input, or policy change.","missingness":"Absent inputs, unsupported platform or format, unavailable enforcement, ambiguous exit, unverified cleanup, missing child evidence, and exhausted bounds remain UNKNOWN rather than zero or PASS.","provenance":"Canonical certificates bind the request, MODEL/HARDWARE and child references, artifact and collection digests, mechanism and policy source, limits, machine/Python/backend identity, and exact bounded outcome.","validity":"Validity requires exact artifacts and expected output, supported numeric forms, verified Job Object limits before resume, bounded clean child completion, expected lower/high statuses, current bindings, and all finite checks."},"evidence_set_digest":"sha256:f892a0750c04315455f7f587133b61a418ee5a9e6a441212cc0bea074315cbe8","reason":"The MODEL implementation recomputes finite outputs and metrics and, at MODEL-3.2, freshly observes a selected lower/upper committed-memory execution bracket on the current Windows CPU runtime. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"Selected MODEL, HARDWARE, DATA and TRAIN records; exact request, policy, mechanism, source, artifact and child-certificate digests; finite inputs, outputs, caps, trials, tolerances and limits.","defaults":"No historical training, weight derivation, universal memory minimum, cross-runtime behavior, physical device authenticity, model safety, disclosure authority, or deployment fitness is inferred.","precedence":"Canonical and source binding precede computation; reproduced output, metric or cap contradictions FAIL, while unsupported formats, platforms, children, or bounded execution remain UNKNOWN.","scope":"Admission of exact MODEL architecture and weight bytes, finite inference and metric replay, DATA and TRAIN citations, quantization records, and one fresh local hardware bracket observation."},"evidence_set_digest":"sha256:1477dec6ac077da71a5c683578916d47cfed1e1a605a5ee76527353158e7afca","reason":"The MODEL sources enforce exact artifacts, child citations, numeric and quantization forms, local runtime selection, hardware caps, expected output and current source bindings under externally selected policies. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"The policy applies to one bounded replay or fresh hardware observation and does not activate an inference service, agent, controller, or deployed model.","authority":"An external selector chooses the model proposition, child policies, trust roots and local resource bracket; the checker grants no model-use, disclosure, deployment, physical, or financial authority.","exceptions":"No exception bypasses raw-byte commitments, child selection, shape and numeric checks, Job Object enforcement, exact expected output, cap ordering, or finite limits.","revisions":"Schema, semantic, policy, mechanism, dependency and installed source digests plus the current runtime identity bind the rules; changed bytes or runtime require new evidence."},"evidence_set_digest":"sha256:1477dec6ac077da71a5c683578916d47cfed1e1a605a5ee76527353158e7afca","reason":"The MODEL sources enforce exact artifacts, child citations, numeric and quantization forms, local runtime selection, hardware caps, expected output and current source bindings under externally selected policies. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Substituted artifacts, unsupported formats, stale children, wrong outputs, unverified job limits, ambiguous child exits, and exhausted bounds cannot become PASS.","decision_evidence":"Certificates bind exact selected bytes and report finite replay values or the current local low-cap exhaustion and high-cap completion observations with explicit exclusions.","enforcement_points":"Request and policy parsing, object composition, raw artifact and child replay, quantization validation, inference and metric comparison, platform binding, pre-resume Job Object limits, child result validation, and certificate reproduction.","unavailable_behavior":"Missing children, unsupported Windows runtime, unavailable enforcement, ambiguous child results, absent inputs, or unbounded claims remain UNKNOWN rather than being estimated."},"evidence_set_digest":"sha256:1477dec6ac077da71a5c683578916d47cfed1e1a605a5ee76527353158e7afca","reason":"The MODEL sources enforce exact artifacts, child citations, numeric and quantization forms, local runtime selection, hardware caps, expected output and current source bindings under externally selected policies. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"External selector/caller, MODEL checker, Windows execution backend, one fixed installed child worker per cap, and the certificate rechecker.","roles":"The caller selects immutable intent, the checker validates prerequisites and payload, the backend applies bounds and transports bytes, the worker computes one dense output, and the checker validates and records the response.","states":"Selected, prerequisites-replayed, payload-bound, child-created-suspended, limits-verified, resumed, exited-or-bounded, response-validated, trial-complete, and certificate-built or refused.","transitions":"Only exact validation advances selection to launch; verified pre-resume limits advance to running; bounded exit and response parsing advance to accepted observation; any mismatch terminates that path without PASS."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 defines a bounded parent/backend/fixed-worker request and response state machine with pre-resume limit ordering, exact compatibility, timeout and replay rules. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"Exact schema and semantic versions, Windows CPython, installed execution backend, canonical JSON dense-model format, mechanism digest, source dependencies and finite request shape must match.","message_authority":"Request, policy, evidence, mechanism and object digests authorize interpretation of canonical stdin/stdout bytes only; child output grants no broader authority.","ordering":"Raw artifact prerequisite precedes native work; within each trial the lower-cap child precedes the upper-cap child; limit verification precedes resume; complete response validation precedes certificate publication.","replay":"Recheck validates the exact request and policy and rebuilds the outcome through current fresh worker execution; replay is bounded and cannot substitute another model or runtime."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 defines a bounded parent/backend/fixed-worker request and response state machine with pre-resume limit ordering, exact compatibility, timeout and replay rules. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"The boundary assumes only parent-visible operating-system Job Object and process results; power loss, kernel compromise, physical authenticity, hidden platform effects and external time truth are outside evidence.","liveness":"Each child wait is finite, but no guarantee says the platform is available or either selected cap will yield the desired status; bounded nonprogress becomes UNKNOWN.","recovery":"A failed or unavailable exchange produces no accepted observation; cleanup is bounded to the owned job and later recovery is a fresh complete exchange after the cause is addressed.","safety":"Fixed source, exact payload, verified cap before resume, bounded time and output, owned-job cleanup, strict response fields and expected-output equality prevent unsupported results from becoming PASS."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 defines a bounded parent/backend/fixed-worker request and response state machine with pre-resume limit ordering, exact compatibility, timeout and replay rules. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-robot-vstd-model-fbd41765f35a; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-robot-vstd-model-fbd41765f35a; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ec6e8f53a3561b8bfa7eeea9817ec610e6f60e8b05d716295b299fcc86547256","reason":"reasons.vstd:tier0-robot-vstd-model-fbd41765f35a; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"For each selected trial the parent freshly launches a fixed worker twice, verifies the Windows Job Object committed-memory cap before resume, and captures bounded child status, exit, stdout, stderr, and cleanup state.","deployment":"The deployed acquisition boundary is the current local Windows CPython parent, its Job Object backend, and the fixed installed child source; it is not a physical transducer or remote telemetry service.","measurements":"RESOURCE_EXHAUSTED or PASS status, selected cap in bytes, exact output vector, bounded operation count, trial order, machine, Python version, and execution backend.","phenomena":"Parent-visible resource exhaustion under the selected lower cap and successful exact dense-model output under the selected higher cap on the current software and processor runtime."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 is a fresh parent-side acquisition route: it applies and verifies Job Object limits before child resume, then captures bounded child status, exit and streams. It is a software sensor, not calibrated physical telemetry. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"Physical calibration is not applicable to this software process-bound observation. Applicability is limited to verified operating-system job-limit configuration and exact source/runtime compatibility.","calibration_evidence":"Applied Job Object flags and byte cap are verified before resume and the fixed worker output is checked, but this is enforcement evidence rather than metrological calibration or device authentication.","drift":"Windows, CPython, machine, execution backend, installed numerical/checker source, model bytes, input, and operating-system behavior can drift and require a new observation.","operating_range":"Selected committed-memory caps are finite increasing values from 8 MiB through 64 MiB, with one to three trials, one-to-five-second child bounds, finite payloads, and bounded native operations."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 is a fresh parent-side acquisition route: it applies and verifies Job Object limits before child resume, then captures bounded child status, exit and streams. It is a software sensor, not calibrated physical telemetry. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"Unsupported platform, launch error, timeout, output exhaustion, nonzero exit, stderr, malformed response, wrong output, unverified limits, nonempty owned job, and cleanup ambiguity prevent a valid observation.","latency":"Parent waiting is bounded by the selected wall seconds per child, but launch, scheduling, allocation and observation latency are not separately measured or guaranteed.","recovery":"The backend bounds and cleans the selected child where observable; after environmental repair the only supported recovery is a fresh invocation, never promotion of cached status.","sampling":"Each trial performs one lower-cap observation followed by one upper-cap observation; there is no periodic cadence, aggregation population, or cross-host synchronization."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 is a fresh parent-side acquisition route: it applies and verifies Job Object limits before child resume, then captures bounded child status, exit and streams. It is a software sensor, not calibrated physical telemetry. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The external local invocation and operating-system process permissions authorize this bounded checker worker only; no model deployment, external inference, physical-device, or financial authority is established.","effects":"Launch the fixed installed Windows CPython dense-model worker under selected Job Object memory caps, consume local process and memory resources, collect its bounded result, and construct one local certificate.","preconditions":"Exact MODEL and HARDWARE selections, current raw architecture and weight bytes, finite input and expected output, supported Windows CPython backend, increasing caps, wall bound, trials, policy, and source bindings must validate before admission.","resources":"One fixed-source child process per cap observation, a Windows Job Object, committed memory, anonymous standard-input/output/error pipes, bounded parent time, and in-memory certificate bytes."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 freshly creates fixed local child processes under selected memory and time bounds. Process creation, resource consumption, response publication and partial failure require an explicit transaction boundary even though no external model effect is committed. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Timeout, output exhaustion, unavailable enforcement, ambiguous exit, unexpected output, failed cleanup, or any binding error prevents admission; this is process cleanup, not rollback of an external transaction.","commit":"The bounded observation is accepted only after the lower cap exhausts, the upper cap completes with the selected output, limits were verified before child resume, cleanup is observed, and the certificate is canonically built.","finality":"The result is final only for this local invocation and exact source/runtime coordinate. It is not a universal memory minimum, durable deployment result, or external transaction finality.","partial_failure":"A child may be created, resumed, allocate memory, or exit before the parent rejects a result or certificate construction fails; no external compensation beyond bounded process cleanup is claimed."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 freshly creates fixed local child processes under selected memory and time bounds. Process creation, resource consumption, response publication and partial failure require an explicit transaction boundary even though no external model effect is committed. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"Exact request, evidence, object, collection, policy and mechanism digests distinguish the selected invocation; no cross-invocation external duplicate ledger exists.","idempotency":"Repetition reruns local child processes and resource consumption. The fixed computation is intended to be source-deterministic, but process effects and current runtime observations are not claimed idempotent.","replay":"Certificate recheck reconstructs the exact selection and freshly evaluates the current local worker; retained prior PASS is not accepted as a current hardware observation.","retry_limits":"The request permits one to three explicit trials and each child wait is bounded to at most five seconds; no hidden automatic retry promotes an unavailable result."},"evidence_set_digest":"sha256:ba5a2108e078093792a0c3be71ed795cc60af77788fca99a624701a4e316b582","reason":"MODEL-3.2 freshly creates fixed local child processes under selected memory and time bounds. Process creation, resource consumption, response publication and partial failure require an explicit transaction boundary even though no external model effect is committed. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."}},"operands":{"arch":["vstd-architecture"],"bench":["vstd-benchmark"],"data":["vstd-data"],"env":["vstd-environment"],"events":["vstd-event"],"hardware":["vstd-hardware"],"train":["vstd-training"]},"payload":{"representation_role":"model-representation"},"reason":"Retained package role: model-representation. Source ownership enumerates its representation; operational truth remains a higher-tier question.","specializations":["TRANSACTION","MEASUREMENT","SENSOR","ACTUATOR","PROTOCOL","POLICY"],"surfaces":["file:src/verifier/domains/contracts/model_artifact_bytes.py","python:src/verifier/domains/contracts/model_artifact_bytes.py:<module>","python:src/verifier/domains/contracts/model_artifact_bytes.py:ModelArtifactBytesError","python:src/verifier/domains/contracts/model_artifact_bytes.py:registration","python:src/verifier/domains/contracts/model_artifact_bytes.py:ModelArtifactBytesDescriptor","python:src/verifier/domains/contracts/model_artifact_bytes.py:mechanism_digest","python:src/verifier/domains/contracts/model_artifact_bytes.py:_policy","python:src/verifier/domains/contracts/model_artifact_bytes.py:model_artifact_bytes_policy","python:src/verifier/domains/contracts/model_artifact_bytes.py:_request","python:src/verifier/domains/contracts/model_artifact_bytes.py:model_artifact_bytes_request","python:src/verifier/domains/contracts/model_artifact_bytes.py:_raw_artifact","python:src/verifier/domains/contracts/model_artifact_bytes.py:_evaluate","python:src/verifier/domains/contracts/model_artifact_bytes.py:_ModelArtifactBytesMechanism","python:src/verifier/domains/contracts/model_artifact_bytes.py:_ModelArtifactBy