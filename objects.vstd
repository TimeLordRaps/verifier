ED"},"evidence_set_digest":"sha256:19fb77488aeaf3a063cea520836936fa0b9f7712310d3f87c467c221e1801984","reason":"reasons.vstd:tier0-sensor-vstd-permission-slot-controller-dab5f625f711; fulfillment NOT_ESTABLISHED."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"NOT_ESTABLISHED","calibration_evidence":"NOT_ESTABLISHED","drift":"NOT_ESTABLISHED","operating_range":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:19fb77488aeaf3a063cea520836936fa0b9f7712310d3f87c467c221e1801984","reason":"reasons.vstd:tier0-sensor-vstd-permission-slot-controller-dab5f625f711; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:19fb77488aeaf3a063cea520836936fa0b9f7712310d3f87c467c221e1801984","reason":"reasons.vstd:tier0-sensor-vstd-permission-slot-controller-dab5f625f711; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"External verifiers establish the named grant/successor admission; the slot cannot mint endpoint authority.","effects":"Mutate local lifecycle state, append bounded events, and submit one admitted callback invocation.","preconditions":"Exact grant/ticket/restart identities, verifier decisions, entry observation, callback, and optional trace anchor.","resources":"One in-process callback entry and the local permission-slot lifecycle/trace state."},"evidence_set_digest":"sha256:19fb77488aeaf3a063cea520836936fa0b9f7712310d3f87c467c221e1801984","reason":"permission-slot lifecycle applies as TRANSACTION. Its named changes, response-dependent finality, duplicate handling, and partial-failure state require an explicit transaction boundary. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declarati