ISHED","objectives":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-controller-vstd-artifact-network-history-d1c4110a0232; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.2-timing-and-stability":{"declaration":{"operating_envelope":"NOT_ESTABLISHED","saturation":"NOT_ESTABLISHED","stability_assumptions":"NOT_ESTABLISHED","timing":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-controller-vstd-artifact-network-history-d1c4110a0232; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"NOT_ESTABLISHED","failure_behavior":"NOT_ESTABLISHED","feedback_loss":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-controller-vstd-artifact-network-history-d1c4110a0232; fulfillment NOT_ESTABLISHED."},"FINBOT-0.1-agent-and-financial-authority":{"declaration":{"agent":"NOT_ESTABLISHED","decision_scope":"NOT_ESTABLISHED","financial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-finbot-vstd-artifact-network-history-50a39bf92a58; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-finbot-vstd-artifact-network-history-50a39bf92a58; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-finbot-vstd-artifact-network-history-50a39bf92a58; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"Authority is bounded to caller-selected publisher keys, signed records, explicit authority-model roots, and local store ownership; real-world identity is not established.","history":"The artifact network owns content-addressed objects and records, silo commits, signed publisher heads, key-continuity records, and signed directory snapshots.","ordering":"Publisher head sequences, previous-head links, key transitions, commit ancestry, and canonical directory entries define explicit finite order.","state":"Current state is the exact selected commit/head/directory and its reachable immutable object and record digests under one store root."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Content-addressed records, signed heads, key continuity, commit ancestry, and directory snapshots form an authoritative bounded artifact history. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"Content digests must match bytes, signed chains must link exactly, finite censuses must close, and duplicate identities must not disagree.","rounding":"Canonical JSON permits JavaScript-safe integers and exact byte/digest comparison; no floating-point or monetary rounding is admitted.","sources_and_sinks":"Objects and records enter through bounded content-addressed writes and verified transfer/materialization; the module never deletes or garbage-collects stored objects or records, and its only removals are partial export or rebuild destinations on exception (interoperability/network.py:2336-2338, 2525-2527) and CLI unlink calls (runtime/network_cli.py:293, 301).","units":"Units are exact bytes, digests, sequence numbers, finite record/member counts, and declared actions; there are no monetary balances."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Content-addressed records, signed heads, key continuity, commit ancestry, and directory snapshots form an authoritative bounded artifact history. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"Published history is corrected by a new linked commit, head, directory, or key-continuity record; retained content is not silently overwritten under the same digest.","reconciliation":"Reconciliation is exact comparison of commit inventories, publisher/key continuity, directory entries, and rebuilt store contents at selected coordinates.","recovery":"Recovery can rebuild or reclone verified retained bytes; remote availability, private-key recovery, concurrent writers, and storage durability remain external.","replay":"Export, transfer, clone, rebuild, and assessment re-read canonical bytes and revalidate digests, signatures, ancestry, census, and authority-model closure."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Content-addressed records, signed heads, key continuity, commit ancestry, and directory snapshots form an authoritative bounded artifact history. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-market-vstd-artifact-network-history-2777a9d26c4e; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-market-vstd-artifact-network-history-2777a9d26c4e; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-market-vstd-artifact-network-history-2777a9d26c4e; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"NOT_ESTABLISHED","observation_vs_estimate":"NOT_ESTABLISHED","phenomenon":"NOT_ESTABLISHED","source":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-measurement-vstd-artifact-network-history-601aeb24d7ca; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"NOT_ESTABLISHED","observation_time":"NOT_ESTABLISHED","reference_frame":"NOT_ESTABLISHED","uncertainty":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-measurement-vstd-artifact-network-history-601aeb24d7ca; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"NOT_ESTABLISHED","missingness":"NOT_ESTABLISHED","provenance":"NOT_ESTABLISHED","validity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-measurement-vstd-artifact-network-history-601aeb24d7ca; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"Inputs are the selected authority-model record, ground action and actor-scope digests, transitions, local additions, commit census, composition members, adapters, relations, and policies.","defaults":"Missing, malformed, ungrounded, incompatible, incomplete, or unclosed authority evidence fails closed rather than inferring permission.","precedence":"Ground agency is a required floor; local additions remain actor-scoped and cannot revoke ground actions; composition obligations do not disappear through member intersection.","scope":"Policy covers exact allowable-action authority models, ground agency, actor-scoped local additions, finite reachable states, and composition admission for one selected silo."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"The source implements explicit authority-model and silo-composition admission rules over allowable actions, local additions, and closure evidence. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"Activation is assessment of one exact selected commit/composition and its current inputs; no global deployment or time-based enforcement is implied.","authority":"The caller selects trust roots and records; signed publishers bind bytes, but the module does not establish real-world actors or permission to execute artifacts.","exceptions":"Only explicit finite local additions and declared composition adapters/relations are considered; undeclared exceptions are not inferred.","revisions":"A changed authority model, action set, actor scope, transition graph, mechanism bytes, or composition produces a different digest-bound policy coordinate."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"The source implements explicit authority-model and silo-composition admission rules over allowable actions, local additions, and closure evidence. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Missing census members, authority roots, bridges, adapters, policies, or residual obligations remain failed or incomplete; generic object labels cannot bypass them.","decision_evidence":"Assessment and receipt records bind exact commits, mechanism bytes, finite inputs, results, and reasons for the selected evaluation.","enforcement_points":"The assess_silo and assess_composition paths refuse to report grounded/complete outcomes when registered authority and closure checks fail.","unavailable_behavior":"Unavailable cryptography, files, keys, records, or required closure yields an error or non-passing assessment, never inferred allowability."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"The source implements explicit authority-model and silo-composition admission rules over allowable actions, local additions, and closure evidence. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"Participants are publisher/key holders, signed directory providers, source stores or HTTPS endpoints, local consumers/materializers, and the Claim Garden enrollment endpoint (runtime/network_cli.py:361-404).","roles":"Publishers sign heads and continuity; directories enumerate publishers; sources serve bounded transfers; consumers verify before retaining local bytes.","states":"States include absent, content-addressed, committed, head-linked, directory-listed, transferred, materialized, assessed, and rejected.","transitions":"Canonical object insertion, commit formation, head/key signing, directory signing, transfer construction, download, verification, and materialization define transitions."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Publishers, directories, stores, HTTPS sources, and consumers follow signed, ordered, replay-checked transfer and reconstruction states. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"Schema constants, canonical JSON, finite limits, media/artifact kinds, and declared authority-model versions define compatibility.","message_authority":"Ed25519 signatures and exact key identifiers bind selected messages; caller trust roots and real-world publisher identity remain external selections.","ordering":"Head sequences and previous digests, key-continuity links, commit ancestry, and transfer record dependencies are checked exactly.","replay":"Equal signed content may be replayed safely only under the same digest and sequence; conflicting sequence, key, ancestry, or bytes are rejected."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Publishers, directories, stores, HTTPS sources, and consumers follow signed, ordered, replay-checked transfer and reconstruction states. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"Peers, storage, DNS/TLS, redirects, signed data, and local files may be absent, malformed, stale, hostile, truncated, or inconsistent.","liveness":"No remote availability or progress guarantee is made; bounded operations either return one verified result or fail.","recovery":"Recovery uses a fresh verified transfer, clone, export, or rebuild from retained valid records; automatic distributed repair is not claimed.","safety":"Bounded reads, safe paths, canonical forms, digest/signature checks, closed inventories, and verify-before-accept rules prevent silent substitution within scope."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Publishers, directories, stores, HTTPS sources, and consumers follow signed, ordered, replay-checked transfer and reconstruction states. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-robot-vstd-artifact-network-history-80eb3fa46909; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-robot-vstd-artifact-network-history-80eb3fa46909; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-robot-vstd-artifact-network-history-80eb3fa46909; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"NOT_ESTABLISHED","deployment":"NOT_ESTABLISHED","measurements":"NOT_ESTABLISHED","phenomena":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-sensor-vstd-artifact-network-history-ebb9b060df6e; fulfillment NOT_ESTABLISHED."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"NOT_ESTABLISHED","calibration_evidence":"NOT_ESTABLISHED","drift":"NOT_ESTABLISHED","operating_range":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-sensor-vstd-artifact-network-history-ebb9b060df6e; fulfillment NOT_ESTABLISHED."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"NOT_ESTABLISHED","latency":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","sampling":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:677923042e0445e5ecff65ecac59621c6b0375bac44bdebae7fe71e0e662bfa1","reason":"reasons.vstd:tier0-sensor-vstd-artifact-network-history-ebb9b060df6e; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The direct caller selects source, destination, opener, and keys; signed publisher material authenticates bounded records but grants no execution permission.","effects":"Store writes, exports, downloads, transfer materialization, clone, and rebuild create bounded local filesystem objects and metadata; the Claim Garden register path POSTs to its endpoint unconditionally and writes the returned bearer token to a local file (runtime/network_cli.py:361-404).","preconditions":"Canonical shape, byte limits, digest/signature validity, chain continuity, safe relative paths, allowed inventories, and destination conditions must hold.","resources":"Resources include bounded payloads, HTTPS responses, source/export/store directories, private-key files, temporary local paths, and finite inventories."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Export, transfer, clone, materialization, and rebuild create local filesystem effects with validation, partial-failure, finality, and retry boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Validation, size, redirect, transport, signature, digest, path, inventory, and filesystem failures raise NetworkError or an I/O error and stop the selected operation.","commit":"Each operation commits only at its documented local file/directory write or verified materialized tree; there is no distributed atomic commit across peers.","finality":"Content-addressed bytes are locally final under their digest and signed sequence records are immutable inputs; remote publication or execution finality is not established.","partial_failure":"Multi-file export, clone, and rebuild can fail after earlier local writes; export and rebuild remove their partial destination on exception (interoperability/network.py:2336-2338, 2525-2527), but a process interruption can still leave an incomplete destination that the caller must not treat as a committed silo."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Export, transfer, clone, materialization, and rebuild create local filesystem effects with validation, partial-failure, finality, and retry boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"Digest-addressed paths, signed sequence/link checks, exact inventories, and destination validation identify equal repeats and conflicting retained state.","idempotency":"Only digest-addressed object writes are byte-idempotent (interoperability/network.py:1421-1427); composite export, materialization, and rebuild refuse an existing destination (interoperability/network.py:2180-2181, 2318-2319, 2458-2459) rather than repeating silently.","replay":"Replay must revalidate the same signed/digested transfer and safe destination inventory; retained bytes confer no permission to execute them.","retry_limits":"Network redirects, bytes, entries, and records are bounded; general operator retry count and backoff are not provided by this module."},"evidence_set_digest":"sha256:49196b81accaac28c73ce48de0981a9b9904014588c4fe0a651ee543882b73a2","reason":"Export, transfer, clone, materialization, and rebuild create local filesystem effects with validation, partial-failure, finality, and retry boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Content-addressed silo, publisher-head, key-continuity and directory history with transfer protocols."},"reason":"Persistent signed heads and continuity records need explicit history and replay semantics across network exchange. The source implements explicit authority-model and silo-composition admission rules over allowable actions, local additions, and closure evidence. Boundary: Artifact transfer and local materialization are external effects; retained bytes prove neither correctness nor execution permission.","specializations":["POLICY","PROTOCOL","TRANSACTION"],"surfaces":["file:examples/artifact-network/build_specimen.py","python:examples/artifact-network/build_specimen.py:<module>","python:examples/artifact-network/build_specimen.py:_unique_object","python:examples/artifact-network/build_specimen.py:_load_fixture","python:examples/artifact-network/build_specimen.py:build_specimen","python:examples/artifact-network/build_specimen.py:main","file:src/verifier/interoperability/network.py","py