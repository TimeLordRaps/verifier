ED"},"SENSOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SIM":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SPACE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TIME":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TOKEN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRAIN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRANSACTION":{"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its commands mutate multi-part in-memory state and sometimes an anchor provider, requiring explicit precondition, commit, partial-failure, retry, and replay boundaries.","status":"APPLIES"},"VERIFIER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"}},"evidence_sets":{"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945":[],"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091":[{"path":"src/verifier/hardware/emulator.py","sha256":"sha256:0ae9d764733223ae92ed940e42bb327ea99110aa5e863bd582b0732a3f054683"}]},"kind":"LEDGER","object_id":"vstd-firmware-emulator-accounting","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"The direct caller controls the simulated instance. The source claims no physical firmware privilege, host isolation, or external-effect authority.","commands":"The emulator accepts explicit configuration, boot, challenge, attestation, execution, observation, completion, anchor, and reset method calls.","effect_domains":"SIMULATED_ACCELERATOR_ONLY; no physical accelerator, motor, network service, money rail, or external workload is commanded by these exact sources.","targets":"Targets are only VirtualVSTDAccelerator in-memory state, simulated partitions/executions, accounting events, receipts, and an explicitly supplied anchor provider."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its command-to-effect surface changes only simulated/emulated accelerator state and an explicitly supplied local anchor target. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"Configured capacity, lifecycle prerequisites, unique identities, valid quantities, and event continuity limit accepted commands.","response":"Successful calls return typed simulated records after local state updates; no physical response time, motion, power, or delivered compute is represented.","saturation":"Over-capacity partitioning and invalid state are rejected with FirmwareContractError rather than silently saturating a physical target.","units_and_frames":"Effects are framed by virtual device/execution ids, epoch, sequence, integer capacities/quantities, caller time strings, and exact digests."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its command-to-effect surface changes only simulated/emulated accelerator state and an explicitly supplied local anchor target. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ACTUATOR-0.3-feedback-and-interlocks":{"declaration":{"effect_feedback":"Returned events, observations, roots, continuity records, topology, and receipts expose local simulated effects only.","failure_states":"Contract exceptions, provider failures, invalid order, exhausted capacity, and process interruption can leave no physical effect but may require inspection of in-memory partial state.","interlocks":"Boot, current epoch, capacity, predecessor, identity, and rolling-root checks interlock state-changing methods.","recovery":"Recovery is bounded to caller inspection, a valid later command, or simulated reset/new instance; no physical safe-state guarantee is made."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"Its command-to-effect surface changes only simulated/emulated accelerator state and an explicitly supplied local anchor target. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"NOT_ESTABLISHED","precision":"NOT_ESTABLISHED","rights":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-asset-vstd-firmware-emulator-accounting-704472566cd3; fulfillment NOT_ESTABLISHED."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"NOT_ESTABLISHED","issuance_authority":"NOT_ESTABLISHED","redemption":"NOT_ESTABLISHED","supply_changes":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-asset-vstd-firmware-emulator-accounting-704472566cd3; fulfillment NOT_ESTABLISHED."},"ASSET-0.3-custody-and-encumbrance":{"declaration":{"control":"NOT_ESTABLISHED","custody":"NOT_ESTABLISHED","encumbrances":"NOT_ESTABLISHED","reconciliation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-asset-vstd-firmware-emulator-accounting-704472566cd3; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.1-feedback-and-authority":{"declaration":{"authority":"The direct caller has software control of the virtual instance; test keys and anchors do not confer physical-device command authority.","commands":"configure_partitions, boot, issue_challenge, attest, submit_execution, observe_execution, complete_execution, anchor, and reset are the bounded control surface.","feedback":"Control decisions read the emulator's current boot, epoch, partition, challenge, execution, event, and rolling-root state; no external physical feedback is consumed.","objectives":"Maintain a valid simulated accelerator lifecycle, partition capacity, execution ordering, accounting continuity, and reset/anchor state under explicit caller commands."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"The virtual device validates and sequences commands using current simulated lifecycle feedback, capacity limits, interlocks, and failure states. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"CONTROLLER-0.2-timing-and-stability":{"declaration":{"operating_envelope":"The envelope is the configured virtual capacity, supported partition and execution shapes, current lifecycle state, and finite in-memory package types.","saturation":"Partition requests beyond simulated physical capacity and invalid quantities are refused; no command is clipped into an apparently successful physical value.","stability_assumptions":"Stability means invariant-preserving finite simulated state transitions, not closed-loop control stability or plant dynamics.","timing":"Ordering uses caller-supplied timestamps and synchronous method order; there is no real-time deadline, scheduler guarantee, or clock authentication."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"The virtual device validates and sequences commands using current simulated lifecycle feedback, capacity limits, interlocks, and failure states. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"Calls are serialized only by ordinary Python execution and explicit state checks; no concurrent multi-controller arbitration is established.","failure_behavior":"Invalid transitions raise FirmwareContractError and preserve a bounded software failure; general multi-step rollback and crash recovery are not guaranteed.","feedback_loss":"Missing lifecycle state or referenced execution/challenge is treated as a contract error; no stale physical observation is substituted.","intervention":"A cooperating caller can stop issuing commands or invoke reset when permitted; no emergency physical stop or independent supervisor exists."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"The virtual device validates and sequences commands using current simulated lifecycle feedback, capacity limits, interlocks, and failure states. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"FINBOT-0.1-agent-and-financial-authority":{"declaration":{"agent":"NOT_ESTABLISHED","decision_scope":"NOT_ESTABLISHED","financial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-finbot-vstd-firmware-emulator-accounting-3f35369db358; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-finbot-vstd-firmware-emulator-accounting-3f35369db358; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-finbot-vstd-firmware-emulator-accounting-3f35369db358; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"Authority is local to the direct caller, emulator instance, test HMAC key, and optional selected AnchorProvider; no physical firmware or hardware root is established.","history":"VirtualVSTDAccelerator owns an append-only in-memory sequence of boot, partition, execution, observation, completion, anchor, and reset accounting events.","ordering":"Each accounting event carries epoch, monotone sequence, previous root, and rolling root; execution starts precede observations and completion within the emulator lifecycle.","state":"Current simulated device epoch, rolling root, sequence, partitions, challenges, attestations, executions, observations, anchors, resets, and receipts derive from retained fields and events."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"The virtual accelerator owns hash-linked append-only firmware-accounting history and derived epoch, execution, anchor, and receipt state. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"Rolling-root continuity, epoch/sequence order, partition-capacity limits, unique lifecycle records, and execution/accounting relationships constrain state.","rounding":"Integer capacities and quantities and exact digests are retained without rounding; the emulator establishes no physical performance precision.","sources_and_sinks":"State enters through explicit emulator commands and remains in memory for receipt/topology construction; no delete or durable compaction path exists.","units":"Units include discrete events/executions/partitions, byte and count quantities, caller-supplied timestamps, and digest identities; no monetary unit is present."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"The virtual accelerator owns hash-linked append-only firmware-accounting history and derived epoch, execution, anchor, and receipt state. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"Prior events are not edited. reset advances epoch and records a reset boundary; later records cannot silently rewrite an earlier rolling root.","reconciliation":"Receipts, continuity records, topology, anchors, and accounting state reconcile against the emulator's exact in-memory prefix and test trust root.","recovery":"A reset records a new simulated epoch; process loss destroys unpersisted state, and physical firmware recovery, durable replay, and external backup are not claimed.","replay":"Retained events and roots expose continuity for deterministic inspection, but this module does not provide a durable full command replay engine."},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"The virtual accelerator owns hash-linked append-only firmware-accounting history and derived epoch, execution, anchor, and receipt state. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-market-vstd-firmware-emulator-accounting-cf0b1cfd64e6; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-market-vstd-firmware-emulator-accounting-cf0b1cfd64e6; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:tier0-market-vstd-firmware-emulator-accounting-cf0b1cfd64e6; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"NOT_ESTABLISHED","observation_vs_estimate":"NOT_ESTABLISHED","phenomenon":"NOT_ESTABLISHED","source":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:firmware-emulator-accounting-measurement-applies; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"NOT_ESTABLISHED","observation_time":"NOT_ESTABLISHED","reference_frame":"NOT_ESTABLISHED","uncertainty":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:b819d05f8e3a4de3fa4a4bf91f9f9d3a45cb25c61203c7d5b3f5baec81e78091","reason":"reasons.vstd:firmware-emulator-accounting-measurement-applies; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.3-validity-and-miss