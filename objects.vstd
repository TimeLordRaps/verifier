854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-measurement-vstd-owner-a1efa0d38873; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"NOT_ESTABLISHED","observation_time":"NOT_ESTABLISHED","reference_frame":"NOT_ESTABLISHED","uncertainty":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ab8854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-measurement-vstd-owner-a1efa0d38873; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"NOT_ESTABLISHED","missingness":"NOT_ESTABLISHED","provenance":"NOT_ESTABLISHED","validity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ab8854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-measurement-vstd-owner-a1efa0d38873; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"Inputs are exact OWNER and artifact records, selected instruments, lifecycle/fork inventories, base/end states, eligibility evidence, mechanism/trust pins, clocks, and finite limits.","defaults":"The OWNER checkers fails closed to UNKNOWN or FAIL when necessary selected evidence, support, compatibility, or bounded checking capacity is absent; it never infers approval from silence.","precedence":"Typed identity and selected-base contradictions fail first; eligibility and instrument constraints precede lifecycle changes, and no event may widen rights or erase duties outside the declared limbs.","scope":"Policy covers artifact identity, capability/consequence/duty limbs, ownership eligibility, instruments, delegation/transfer/revocation, freeze/seal/thaw, term and succession, replay, and forks."},"evidence_set_digest":"sha256:9ab15e0ea3fb0a5819ae7bbe5a1078928776a1472bb249e3136eb639dd1a9550","reason":"They enforce eligibility, instruments, capability/consequence/duty limbs, delegates, terms, lifecycle transitions, forks, and fail-closed authority boundaries. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"The policy is activated only for one exact request, mechanism digest, trust-root selection, retained evidence coordinate, and finite limits; no ambient deployment is inferred.","authority":"The caller selects holdings, instruments, issuer/trust labels, evidence, and policies; these sources do not establish legal ownership, jurisdiction, consent, issuer authority, or external registry precedence.","exceptions":"Only explicit lifecycle kinds, admitted instruments, bounded delegates, term conditions, hardware eligibility predicates, and selected fork relations are recognized; no implied waiver or authority is accepted.","revisions":"Changed OWNER/artifact bytes, rights/duties, instrument, delegate, event/fork history, clock, trust root, policy, or mechanism creates a different digest-bound decision."},"evidence_set_digest":"sha256:9ab15e0ea3fb0a5819ae7bbe5a1078928776a1472bb249e3136eb639dd1a9550","reason":"They enforce eligibility, instruments, capability/consequence/duty limbs, delegates, terms, lifecycle transitions, forks, and fail-closed authority boundaries. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Generic labels, declarations without selected support, stale bytes, foreign children, unregistered exceptions, and exhausted checks cannot be promoted to PASS.","decision_evidence":"Results bind exact selected records, instruments, histories, endpoint/fork commitments, requests, policies, child evidence where selected, and explicit external-authority exclusions.","enforcement_points":"Eligibility, holding replay, fork, and certificate recheck paths reject malformed or contradictory retained ownership relations while leaving possession, title, liens, custody, and external execution unestablished.","unavailable_behavior":"The OWNER checkers preserves UNKNOWN for missing support or checking capacity and FAIL for retained contradictions; neither result authorizes downstream action."},"evidence_set_digest":"sha256:9ab15e0ea3fb0a5819ae7bbe5a1078928776a1472bb249e3136eb639dd1a9550","reason":"They enforce eligibility, instruments, capability/consequence/duty limbs, delegates, terms, lifecycle transitions, forks, and fail-closed authority boundaries. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"Participants represented are an OWNER subject, artifact, declared issuers/instruments, delegates, successor owners, fork claimants, and verifier; legal identity, consent, and authority remain declared.","roles":"The OWNER holding and lifecycle checks assigns bounded declarant, subject, supporting-record, verifier, and transition roles; those labels do not authenticate real participants.","states":"States include active, frozen, sealed, thawed, transferred, delegated, revoked, expired/terminated, succeeded, and forked holdings with bounded capability, consequence, and duty limbs.","transitions":"Freeze, seal, thaw, transfer, delegation, revocation, succession, term-end, and fork evidence define finite retained changes to the OWNER relation."},"evidence_set_digest":"sha256:9ab15e0ea3fb0a5819ae7bbe5a1078928776a1472bb249e3136eb639dd1a9550","reason":"They implement finite holding lifecycle, delegation, transfer, revocation, succession, eligibility, replay, and fork protocols with explicit states, order, failures, and recovery boundaries. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"Exact OWNER/artifact/instrument schemas, rights/duties vocabularies, lifecycle and fork versions, policy/mechanism pins, canonical bytes, and finite limits define compatibility.","message_authority":"Selected instruments, issuer labels, signatures or evidence references, and child records bind declared transition authority; they do not prove legal title, key custody, consent, or external enforceability.","ordering":"Lifecycle events use exact unique positions and time/interval constraints, transfer/succession must preserve the declared relation, and fork comparison binds a common selected base.","replay":"The OWNER holding and lifecycle checks replays exact retained bytes and commitments; replay establishes consistency only and never repeats or proves a live-world event."},"evidence_set_digest":"sha256:9ab15e0ea3fb0a5819ae7bbe5a1078928776a1472bb249e3136eb639dd1a9550","reason":"They implement finite holding lifecycle, delegation, transfer, revocation, succession, eligibility, replay, and fork protocols with explicit states, order, failures, and recovery boundaries. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"The OWNER holding and lifecycle checks assumes retained inputs may be absent, malformed, stale, contradictory, unauthenticated, incomplete, or beyond finite checking bounds.","liveness":"No owner, delegate, issuer, registry, court, custodian, or artifact is guaranteed to respond or honor the relation; unavailable external support remains UNKNOWN.","recovery":"Recovery replays exact retained base state, events, instruments, endpoints, and forks. It cannot restore possession, legal title, authority, or an external artifact.","safety":"The checks reject ineligible hardware holdings, rights/duties outside declared limbs, invalid transfer/delegation/revocation order, incompatible instruments, and contradictory fork histories."},"evidence_set_digest":"sha256:9ab15e0ea3fb0a5819ae7bbe5a1078928776a1472bb249e3136eb639dd1a9550","reason":"They implement finite holding lifecycle, delegation, transfer, revocation, succession, eligibility, replay, and fork protocols with explicit states, order, failures, and recovery boundaries. This exact-source Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ab8854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-robot-vstd-owner-17b38397f56a; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ab8854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-robot-vstd-owner-17b38397f56a; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ab8854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-robot-vstd-owner-17b38397f56a; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"NOT_ESTABLISHED","deployment":"NOT_ESTABLISHED","measurements":"NOT_ESTABLISHED","phenomena":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:ab8854ecef28a2bde10bedb8d06df784d1658df0862aab81589382bdb94485a2","reason":"reasons.vstd:tier0-sensor-vstd-owner-919395835ca9; fulfillment NOT_ES