0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"reasons.vstd:tier0-finbot-vstd-finite-record-issuance-36e5d77ce647; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"The host-selected authority policy, exact action scope, current status role, configured ledger identity/generation and distinct postcommit public key authorize only this finite local issuance.","history":"Exact assessment, authority, native/public, ledger receipt and signed-status digests plus explicit FAIL/UNKNOWN reasons and replay correspondence.","ordering":"Bounded input capture and exact finite denominator precede native/public and authority assessment; identical precommit reconstruction precedes one ledger commit; a distinct current signed postcommit precedes finalization and replay.","state":"Captured, denominator-refused, assessed PASS/FAIL/UNKNOWN, precommitted, ready-for-local-commit, locally committed, postcommit-unavailable/refuted, issued, replayed and full-application-UNKNOWN states."},"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance applies as LEDGER. Its locally authoritative ordered history and recovery behavior would be hidden by a generic object label. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"finite OBJECT record issuance is an ordered event/accounting ledger, not a fungible balance sheet. Its invariant is the exact authorized and ordered commit contract: Commit is the invocation ledger's atomic exact-proposal consumption at the selected time. Final issuance additionally requires the SAME receipt and a distinct current signed postcommit; no full-application claim is committed.","rounding":"finite OBJECT record issuance records exact discrete events and byte digests; it defines no numeric rounding convention or financial balance.","sources_and_sinks":"Consume one invocation in the selected local ledger and return bounded precommit, local-commit, issued-attestation and replay records.","units":"Exact bytes and SHA-256 identities, one discrete invocation/record, integer policy epochs and commit sequences, and trusted integer timestamps."},"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance applies as LEDGER. Its locally authoritative ordered history and recovery behavior would be hidden by a generic object label. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"finite OBJECT record issuance does not rewrite an accepted history entry; later action is a new ordered event or a separately retained recovery operation.","reconciliation":"Exact assessment, authority, native/public, ledger receipt and signed-status digests plus explicit FAIL/UNKNOWN reasons and replay correspondence.","recovery":"Retain the exact precommit and ledger receipt, reacquire missing independent status/time/input evidence, and replay the SAME bytes. A new commit requires a new authorized invocation rather than inferred rollback.","replay":"The invocation identifier and ledger uniqueness reject duplicate consumption; assessment/replay are pure rechecks, while commit is never automatically retried."},"evidence_set_digest":"sha256:7bfa40f5869cc01a4cae8a5ff74fff88e6e7cc138666f00642ca834f10235b19","reason":"finite OBJECT record issuance applies as LEDGER. Its locally authoritative ordered history and r