R-0.2-accounting-invariants":{"declaration":{"balance_rules":"NOT_ESTABLISHED","rounding":"NOT_ESTABLISHED","sources_and_sinks":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-ledger-vstd-amd-live-sensor-d73a8815b6d7; fulfillment NOT_ESTABLISHED."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"NOT_ESTABLISHED","reconciliation":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-ledger-vstd-amd-live-sensor-d73a8815b6d7; fulfillment NOT_ESTABLISHED."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-market-vstd-amd-live-sensor-c59f7e1c8dd9; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-market-vstd-amd-live-sensor-c59f7e1c8dd9; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-market-vstd-amd-live-sensor-c59f7e1c8dd9; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"Launch one read-only amd-smi static --json query (hardware/adapters/amd.py:95-101) through subprocess.run with timeout=_DISCOVERY_TIMEOUT_SECONDS and stdout written to a tempfile.TemporaryFile (hardware/adapters/amd.py:93-110), parse the captured response (hardware/adapters/amd.py:118-121), and normalize supported fields through a helper imported from the NVIDIA adapter module (hardware/adapters/amd.py:20), which is outside this object's owned paths.","observation_vs_estimate":"Values are host-interface observations. Physical identity, available capacity under load, performance, and completeness are not inferred or estimated.","phenomenon":"Host-visible AMD accelerator identity, inventory, memory, software, and health fields returned by amd-smi static query.","source":"The current host's amd-smi executable and its file-captured stdout (hardware/adapters/amd.py:93-110) and return code (hardware/adapters/amd.py:111-117); stderr is discarded to DEVNULL (hardware/adapters/amd.py:98), and the adapter observation timestamp is recorded after parsing (hardware/adapters/amd.py:148)."},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"The AMD adapter normalizes live host-visible accelerator observations with explicit timestamps, units, missingness, and source diagnostics; this does not establish physical truth. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"Arrival is the parent process's receipt of the completed vendor response; transport and device-internal latency are not measured.","observation_time":"The adapter records a UTC time after the query; it does not claim a hardware sampling instant for every returned field.","reference_frame":"Each observation is relative to the host-visible AMD device identifier and the vendor tool's current namespace.","uncertainty":"No physical calibration, accuracy interval, drift bound, device authenticity, or inventory completeness is established; those uncertainties remain explicit.","units":"Byte-valued memory fields are normalized as integer bytes where available; identifiers, versions, modes, and health states remain typed strings or explicit missing values."},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"The AMD adapter normalizes live host-visible accelerator observations with explicit timestamps, units, missingness, and source diagnostics; this does not establish physical truth. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"Freshness is bounded to this invocation and its recorded UTC time; no claim is made about state before or after the query.","missingness":"Absent model and UUID fields are replaced with placeholder values (\"unknown AMD accelerator\" at hardware/adapters/amd.py:129; the device key at hardware/adapters/amd.py:130), so a placeholder is not an observation of the field it replaces.","provenance":"The result records the adapter, selected amd-smi static query route, raw diagnostics, and observation time; it does not authenticate the physical device.","validity":"Success requires an available executable, accepted response shape, successful return code, bounded parsing, and supported value normalization."},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"The AMD adapter normalizes live host-visible accelerator observations with explicit timestamps, units, missingness, and source diagnostics; this does not establish physical truth. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"NOT_ESTABLISHED","defaults":"NOT_ESTABLISHED","precedence":"NOT_ESTABLISHED","scope":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-policy-vstd-amd-live-sensor-d6e9c93fb02b; fulfillment NOT_ESTABLISHED."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"NOT_ESTABLISHED","authority":"NOT_ESTABLISHED","exceptions":"NOT_ESTABLISHED","revisions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-policy-vstd-amd-live-sensor-d6e9c93fb02b; fulfillment NOT_ESTABLISHED."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"NOT_ESTABLISHED","decision_evidence":"NOT_ESTABLISHED","enforcement_points":"NOT_ESTABLISHED","unavailable_behavior":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-policy-vstd-amd-live-sensor-d6e9c93fb02b; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-protocol-vstd-amd-live-sensor-f6f9fc32a87d; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"NOT_ESTABLISHED","message_authority":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-protocol-vstd-amd-live-sensor-f6f9fc32a87d; fulfillment NOT_ESTABLISHED."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"NOT_ESTABLISHED","liveness":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","safety":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-protocol-vstd-amd-live-sensor-f6f9fc32a87d; fulfillment NOT_ESTABLISHED."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-robot-vstd-amd-live-sensor-cb56113e7290; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-robot-vstd-amd-live-sensor-cb56113e7290; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-robot-vstd-amd-live-sensor-cb56113e7290; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"The adapter directly launches amd-smi static query and captures the current host-visible response without commanding accelerator work.","deployment":"Deployment is the local host process with the vendor management executable available; container, permission, virtualization, and device mapping affect visibility.","measurements":"Normalized AdapterResult observations retain explicit success, failure, raw evidence, values, and observation time.","phenomena":"Phenomena are the AMD management interface's reported inventory, memory, version, mode, and health fields, not direct physical transduction."},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"The AMD adapter actively acquires amd-smi static query output from the current host, so acquisition, calibration-applicability, sampling, latency, and fault declarations are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"Physical calibration is not performed. Applicability is limited to vendor-interface metadata acquisition and software normalization.","calibration_evidence":"No calibration certificate or traceable physical reference is present; parser fixtures and vendor output are not calibration evidence.","drift":"Driver, firmware, vendor-tool, virtualization, and parser-format drift are not quantified and can invalidate or reduce observations.","operating_range":"The supported range is the bounded response and field formats accepted by this adapter on a host where the vendor query completes."},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"The AMD adapter actively acquires amd-smi static query output from the current host, so acquisition, calibration-applicability, sampling, latency, and fault declarations are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"Missing executables, nonzero exits, malformed payloads, unsupported values, and parsing exceptions are reported as bounded acquisition failures.","latency":"The amd-smi subprocess.run call is bounded by timeout=_DISCOVERY_TIMEOUT_SECONDS, 30 seconds (hardware/adapters/amd.py:23, hardware/adapters/amd.py:100), over the call at hardware/adapters/amd.py:95-101; expiry returns an unsupported result (hardware/adapters/amd.py:102-108). This declaration claims no stronger termination guarantee for helper processes, and device-internal observation latency is not measured.","recovery":"Recovery is a later fresh query after the operator fixes availability or compatibility; cached values are not promoted as current observations.","sampling":"One adapter call performs one vendor query; it defines no periodic cadence, aggregation window, or cross-call synchronization."},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"The AMD adapter actively acquires amd-smi static query output from the current host, so acquisition, calibration-applicability, sampling, latency, and fault declarations are necessary. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"NOT_ESTABLISHED","effects":"NOT_ESTABLISHED","preconditions":"NOT_ESTABLISHED","resources":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-transaction-vstd-amd-live-sensor-f3c9905c9822; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"NOT_ESTABLISHED","commit":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","partial_failure":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-transaction-vstd-amd-live-sensor-f3c9905c9822; fulfillment NOT_ESTABLISHED."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"NOT_ESTABLISHED","idempotency":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED","retry_limits":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:6377b3e4f7033df93ddac3dd1867d959bc8f06bcda27d6fd178ad509a3dd23c0","reason":"reasons.vstd:tier0-transaction-vstd-amd-live-sensor-f3c9905c9822; fulfillment NOT_ESTABLISHED."}},"operands":{},"payload":{"representation_role":"Live AMD SMI/ROCm host discovery and normalization of observed accelerator state."},"reason":"Live vendor acquisition has calibration, freshness and failure questions that generic package ownership cannot express. Boundary: Reads live host state but commands no device; identity, calibration and physical completeness remain unestablished.","specializations":["MEASUREMENT"],"surfaces":["file:src/verifier/hardware/adapters/amd.py","python:src/verifier/hardware/adapters/amd.py:<module>","python:src/verifier/hardware/adapters/amd.py:_profile_for_model","python:src/verifier/hardware/adapters/amd.py:AmdAdapter","python:src/verifier/hardware/adapters/amd.py:AmdAdapter.discover"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"AGENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ARCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ASSET":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BENCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"COLLECTIVE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRE