 gateway and sandbox records, source digests, policy bindings, probes, and cleanup state with explicit gaps.","status":"APPLIES"},"MODEL":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"OWNER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"POLICY":{"evidence_set_digest":"sha256:5c789f0b1e6db74005ba500c4281c11a805b3854099a63ee7ad5a48b467af2c2","reason":"Exact config, image pin, resource limits, filesystem and network rules, ownership labels, negative probes, and fail-closed result mapping govern backend admission and execution.","status":"APPLIES"},"PROTOCOL":{"evidence_set_digest":"sha256:1ffea3f262639be99bf49bbfb7188bf98df3492a6a6a8c5a74fc50c792b7f3ed","reason":"Runner, CLI, gateway, sandbox, probe, and subject exchange through ordered versioned commands and bounded responses with named failure and recovery states.","status":"APPLIES"},"RECEIPT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ROBOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"Migration retains this applicability question. Exact source ownership alone cannot establish or refute a ROBOT role.","status":"UNRESOLVED"},"ROLE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SENSOR":{"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The OpenShell CLI and in-sandbox probes actively acquire those software-environment observations; they are not physical sensors and make no physical calibration claim.","status":"APPLIES"},"SIM":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SPACE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TIME":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TOKEN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRAIN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRANSACTION":{"evidence_set_digest":"sha256:d9f291f97f6e2890920e2aff16fa235291f598bcf5c615fe0ccd2c1cd6560d98","reason":"Create, stage, execute, inspect, stop, and delete form a bounded remote lifecycle with explicit preconditions, authority, partial-failure, retry, cleanup, and finality boundaries.","status":"APPLIES"},"VERIFIER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"}},"evidence_sets":{"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82":[{"path":"extensions/openshell/pyproject.toml","sha256":"sha256:bfe29f43e4b80294ac0d56b26d3f76296d98c0cf606731d1e1dde90ae49bdd53"}],"sha256:1ffea3f262639be99bf49bbfb7188bf98df3492a6a6a8c5a74fc50c792b7f3ed":[{"path":"extensions/openshell/pyproject.toml","sha256":"sha256:bfe29f43e4b80294ac0d56b26d3f76296d98c0cf606731d1e1dde90ae49bdd53"},{"path":"extensions/openshell/src/vstd_openshell/__init__.py","sha256":"sha256:bc69510fd278eee017dfe774890dc36ebe0a33293fa698b59d880447db607a95"},{"path":"extensions/openshell/src/vstd_openshell/live.py","sha256":"sha256:3c81305491a7266d4f75db3bc21f8a53da9fe8f02aa621bdbb9d9fb1ba56d3ff"}],"sha256:3dc490e678d30494cac2f9e669601bf10b1536c393faede2057a11667701f8b9":[{"path":"extensions/openshell/src/vstd_openshell/__init__.py","sha256":"sha256:bc69510fd278eee017dfe774890dc36ebe0a33293fa698b59d880447db607a95"}],"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945":[],"sha256:5c789f0b1e6db74005ba500c4281c11a805b3854099a63ee7ad5a48b467af2c2":[{"path":"extensions/openshell/src/vstd_openshell/__init__.py","sha256":"sha256:bc69510fd278eee017dfe774890dc36ebe0a33293fa698b59d880447db607a95"},{"path":"extensions/openshell/src/vstd_openshell/environment.py","sha256":"sha256:69951e26067484960db01ce773bf3a9a1ede52a16f70998066887b6738fd8c77"},{"path":"extensions/openshell/src/vstd_openshell/live.py","sha256":"sha256:3c81305491a7266d4f75db3bc21f8a53da9fe8f02aa621bdbb9d9fb1ba56d3ff"}],"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba":[{"path":"extensions/openshell/src/vstd_openshell/__init__.py","sha256":"sha256:bc69510fd278eee017dfe774890dc36ebe0a33293fa698b59d880447db607a95"},{"path":"extensions/openshell/src/vstd_openshell/environment.py","sha256":"sha256:69951e26067484960db01ce773bf3a9a1ede52a16f70998066887b6738fd8c77"}],"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206":[{"path":"extensions/openshell/src/vstd_openshell/__init__.py","sha256":"sha256:bc69510fd278eee017dfe774890dc36ebe0a33293fa698b59d880447db607a95"},{"path":"extensions/openshell/src/vstd_openshell/live.py","sha256":"sha256:3c81305491a7266d4f75db3bc21f8a53da9fe8f02aa621bdbb9d9fb1ba56d3ff"}],"sha256:d9f291f97f6e2890920e2aff16fa235291f598bcf5c615fe0ccd2c1cd6560d98":[{"path":"extensions/openshell/pyproject.toml","sha256":"sha256:bfe29f43e4b80294ac0d56b26d3f76296d98c0cf606731d1e1dde90ae49bdd53"},{"path":"extensions/openshell/src/vstd_openshell/__init__.py","sha256":"sha256:bc69510fd278eee017dfe774890dc36ebe0a33293fa698b59d880447db607a95"},{"path":"extensions/openshell/src/vstd_openshell/environment.py","sha256":"sha256:69951e26067484960db01ce773bf3a9a1ede52a16f70998066887b6738fd8c77"},{"path":"extensions/openshell/src/vstd_openshell/live.py","sha256":"sha256:3c81305491a7266d4f75db3bc21f8a53da9fe8f02aa621bdbb9d9fb1ba56d3ff"}]},"kind":"ENV","object_id":"vstd-openshell-environment","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"The explicit caller's configured gateway permissions plus exact workspace, ownership label, and selected sandbox name bound command authority.","commands":"OpenShell create, upload, sandbox exec, stop, and delete requests plus process kill of the local CLI on bounded capture failure.","effect_domains":"Gateway-managed computational resource lifecycle, sandbox filesystem staging, and process execution only; external subject effects remain outside the observation boundary.","targets":"The uniquely labelled sandbox resource, its staged files, its selected process, and the local CLI process; no physical target is selected."},"evidence_set_digest":"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206","reason":"The adapter submits OpenShell create, upload, execute, stop, and delete commands whose targets are computational sandbox resources and processes, not physical actuators. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"No host mount, port forward, credential attachment, automatic provider, login shell, unrestricted network rule, image tag without digest, or mutation of an unowned sandbox is admitted.","response":"Bounded exit code and streams, canonical JSON state, source hash comparison, before/after binding equality, and owned-resource absence report command response.","saturation":"Timeout or output capacity kills the local CLI, records incomplete execution when necessary, and prevents a successful actuator result.","units_and_frames":"Commands use exact sandbox names, POSIX in-sandbox paths, CPU counts, enumerated MiB, seconds, and selected host paths scoped to the repository root."},"evidence_set_digest":"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206","reason":"The adapter submits OpenShell create, upload, execute, stop, and delete commands whose targets are computational sandbox resources and processes, not physical actuators. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"ACTUATOR-0.3-feedback-and-interlocks":{"declaration":{"effect_feedback":"Sandbox get/list responses, named policy probes, exact source checks, subject process capture, and cleanup observation are the bounded computational feedback surface.","failure_states":"Rejected commands, transport uncertainty, subject failure, binding drift, source mutation, inability to stop, or inability to prove deletion are retained distinctly.","interlocks":"Strict config validation, pinned CLI and image, healthy gateway, ownership label, nonroot policy, denied direct network and selected filesystem access, and unchanged binding gate effects.","recovery":"Only a sandbox whose exact random ownership label is reobserved may be stopped or deleted; cleanup failure is surfaced and never broadened to unrelated resources."},"evidence_set_digest":"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206","reason":"The adapter submits OpenShell create, upload, execute, stop, and delete commands whose targets are computational sandbox resources and processes, not physical actuators. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"ASSET-0.1-identity-and-quantity":{"declaration":{"identity":"NOT_ESTABLISHED","precision":"NOT_ESTABLISHED","rights":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-asset-vstd-openshell-environment-0ed286bd1b2d; fulfillment NOT_ESTABLISHED."},"ASSET-0.2-issuance-and-redemption":{"declaration":{"backing_claims":"NOT_ESTABLISHED","issuance_authority":"NOT_ESTABLISHED","redemption":"NOT_ESTABLISHED","supply_changes":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-asset-vstd-openshell-environment-0ed286bd1b2d; fulfillment NOT_ESTABLISHED."},"ASSET-0.3-custody-and-encumbrance":{"declaration":{"control":"NOT_ESTABLISHED","custody":"NOT_ESTABLISHED","encumbrances":"NOT_ESTABLISHED","reconciliation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-asset-vstd-openshell-environment-0ed286bd1b2d; fulfillment NOT_ESTABLISHED."},"CONTROLLER-0.1-feedback-and-authority":{"declaration":{"authority":"Control is limited to the explicitly selected gateway/workspace and the one fresh sandbox bearing the invocation's random ownership label.","commands":"Gateway queries, sandbox create, get, exec, upload, source check, stop, delete, and ownership-filtered list operations.","feedback":"Every stage consumes bounded CLI exit and response evidence, probe results, source hashes, sandbox binding state, and final listing state before selecting the next command.","objectives":"Admit only the selected bounded environment, preserve exact source and sandbox bindings through execution, and remove the owned sandbox afterward."},"evidence_set_digest":"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206","reason":"The adapter sequences lifecycle commands, checks feedback after each stage, refuses binding drift, and drives cleanup under fixed resource and time limits. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"CONTROLLER-0.2-timing-and-stability":{"declaration":{"operating_envelope":"Digest-pinned image, finite source and stream sizes, fixed CPU and memory choices, denied ambient network, restricted filesystem, nonroot process, and one subject invocation.","saturation":"Input, stream, timeout, CPU, memory, name, and response-shape limits terminate or refuse the run rather than widening silently.","stability_assumptions":"The gateway and CLI must remain compatible and the sandbox binding must remain identical before and after execution; no continuous-system stability theorem is claimed.","timing":"Sequential fixed command deadlines, a bounded subject timeout, bounded stream joins, and five short cleanup observations constrain waiting."},"evidence_set_digest":"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206","reason":"The adapter sequences lifecycle commands, checks feedback after each stage, refuses binding drift, and drives cleanup under fixed resource and time limits. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"CONTROLLER-0.3-intervention-and-failure":{"declaration":{"arbitration":"A unique ownership label selects the only mutable sandbox; the adapter does not arbitrate unrelated sandboxes, global capacity, or concurrent gateway policy.","failure_behavior":"Subject launch is withheld until controls pass, binding drift prevents PASS, and uncertain cleanup downgrades successful execution to UNKNOWN.","feedback_loss":"Timeout, incomplete capture, malformed response, unavailable gateway, or ambiguous remote state yields failure or UNKNOWN and never an inferred successful transition.","intervention":"Local CLI processes can be killed on timeout or overflow, and an owned sandbox can be stopped and deleted; subject-level corrigibility and service availability remain unestablished."},"evidence_set_digest":"sha256:cdcd14432512bf74c5a7778d142bf9f21b7be25ed138a4cd78e1b95f8d0de206","reason":"The adapter sequences lifecycle commands, checks feedback after each stage, refuses binding drift, and drives cleanup under fixed resource and time limits. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"FINBOT-0.1-agent-and-financial-authority":{"declaration":{"agent":"NOT_ESTABLISHED","decision_scope":"NOT_ESTABLISHED","financial_authority":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-finbot-vstd-openshell-environment-4e09b1ceb442; fulfillment NOT_ESTABLISHED."},"FINBOT-0.2-financial-exposure-and-dependencies":{"declaration":{"assets_and_parties":"NOT_ESTABLISHED","exposure_limits":"NOT_ESTABLISHED","financial_dependencies":"NOT_ESTABLISHED","real_world_paths":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-finbot-vstd-openshell-environment-4e09b1ceb442; fulfillment NOT_ESTABLISHED."},"FINBOT-0.3-decisions-effects-and-recovery":{"declaration":{"decision_effect_evidence":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","limit_enforcement":"NOT_ESTABLISHED","reconciliation_and_recovery":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-finbot-vstd-openshell-environment-4e09b1ceb442; fulfillment NOT_ESTABLISHED."},"LEDGER-0.1-authoritative-history":{"declaration":{"authority":"NOT_ESTABLISHED","history":"NOT_ESTABLISHED","ordering":"NOT_ESTABLISHED","state":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-ledger-vstd-openshell-environment-af795192744b; fulfillment NOT_ESTABLISHED."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"NOT_ESTABLISHED","rounding":"NOT_ESTABLISHED","sources_and_sinks":"NOT_ESTABLISHED","units":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-ledger-vstd-openshell-environment-af795192744b; fulfillment NOT_ESTABLISHED."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"NOT_ESTABLISHED","reconciliation":"NOT_ESTABLISHED","recovery":"NOT_ESTABLISHED","replay":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-ledger-vstd-openshell-environment-af795192744b; fulfillment NOT_ESTABLISHED."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-market-vstd-openshell-environment-a5d73e7c1b34; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-market-vstd-openshell-environment-a5d73e7c1b34; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-market-vstd-openshell-environment-a5d73e7c1b34; fulfillment NOT_ESTABLISHED."},"MEASUREMENT-0.1-phenomenon-and-method":{"declaration":{"method":"Bounded subprocess capture of pinned OpenShell commands plus deterministic in-sandbox Python probes, canonical JSON parsing, source hashing, and before/after binding comparison.","observation_vs_estimate":"The fields are interface observations from one run; they are not independent attestation, complete host or image inventory, physical measurement, or an estimate of unobserved effects.","phenomenon":"Selected gateway health and version, sandbox identity and phase, admitted policy binding, exact staged bytes, named isolation probes, subject process result, and cleanup state.","source":"CLI response bytes, gateway and sandbox JSON, probe stdout, process exit state, local monotonic elapsed time, and exact selected file bytes."},"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The adapter observes bounded CLI streams, exit state, elapsed host time, gateway and sandbox records, source digests, policy bindings, probes, and cleanup state with explicit gaps. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"MEASUREMENT-0.2-units-time-and-uncertainty":{"declaration":{"arrival_time":"Responses are captured after their ordered CLI commands with bounded stream collection; remote production time and network transit decomposition are unobserved.","observation_time":"Host monotonic elapsed duration bounds each CLI interaction; no trusted remote wall-clock or cross-host clock synchronization is claimed.","reference_frame":"Every observation is scoped to the selected gateway, workspace, unique sandbox generation, ownership token, config, source digests, and command record.","uncertainty":"Timeout, truncation, incomplete streams, transport ambiguity, unsupported response shape, or cleanup ambiguity remain UNKNOWN rather than being assigned zero uncertainty.","units":"Streams are bytes, elapsed duration is seconds, timeouts are integer seconds, resources are CPU count and enumerated MiB, and probe results are booleans or exact identifiers."},"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The adapter observes bounded CLI streams, exit state, elapsed host time, gateway and sandbox records, source digests, policy bindings, probes, and cleanup state with explicit gaps. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"MEASUREMENT-0.3-validity-and-missingness":{"declaration":{"freshness":"Gateway, sandbox, source, policy, probe, execution, and cleanup observations are reacquired during each fresh invocation and expire with that bounded run.","missingness":"A missing CLI, gateway, response field, probe, binding, execution result, or cleanup confirmation is explicit failure or UNKNOWN; no absent value is synthesized.","provenance":"The result retains command argv, exit state, bounded streams and digests, adapter and CLI digests, source digests, config, gateway record, before/after bindings, and cleanup status.","validity":"Pinned version, canonical response shapes, exact ownership and workspace, unchanged generation and policy, source-digest equality, named probe truth, and bounded complete capture are required."},"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The adapter observes bounded CLI streams, exit state, elapsed host time, gateway and sandbox records, source digests, policy bindings, probes, and cleanup state with explicit gaps. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"Exact config and profile, digest-pinned image, CPU and memory bounds, adapter and CLI versions, gateway/workspace, source paths and digests, effective policy, probes, bindings, execution, and cleanup evidence.","defaults":"OpenShell is not selected by the basic runner, network has no grants, filesystem access is enumerated, execution is nonroot, availability is not claimed, and no obligation is discharged by backend success alone.","precedence":"Malformed or incompatible input refuses before effects; controls and exact binding precede subject launch; known contradiction is FAIL; transport or cleanup ambiguity is UNKNOWN.","scope":"Admission and bounded execution of an explicitly selected optional OpenShell environment for one runner invocation."},"evidence_set_digest":"sha256:5c789f0b1e6db74005ba500c4281c11a805b3854099a63ee7ad5a48b467af2c2","reason":"Exact config, image pin, resource limits, filesystem and network rules, ownership labels, negative probes, and fail-closed result mapping govern backend admission and execution. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"Policy activates only for an explicit --sandbox openshell invocation after config validation and is rechecked through returned binding and probe evidence.","authority":"The caller explicitly selects the backend and config while existing gateway credentials authorize service operations; the adapter only narrows targets to its owned sandbox.","exceptions":"No override permits unpinned images, broader resources, host mounts, network grants, login shells, automatic providers, alternate lifecycle, unowned cleanup, or a local fallback.","revisions":"Config and result schemas, pinned OpenShell version, adapter and environment-projection digests, and effective policy bytes identify the selected policy revision."},"evidence_set_digest":"sha256:5c789f0b1e6db74005ba500c4281c11a805b3854099a63ee7ad5a48b467af2c2","reason":"Exact config, image pin, resource limits, filesystem and network rules, ownership labels, negative probes, and fail-closed result mapping govern backend admission and execution. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Unknown fields, environment overrides, custom image tags, expanded resource values, policy drift, failed probes, source escape, binding drift, and cleanup ownership mismatch prevent PASS.","decision_evidence":"The retained result binds config, code and CLI digests, command records, gateway state, requested and effective controls, exact sources, process result, before/after bindings, environment projection, and cleanup.","enforcement_points":"Config parsing, executable/version check, gateway preflight, create parameters, binding validation, negative probes, source staging checks, execution capture, post-binding check, and ownership-checked cleanup.","unavailable_behavior":"Missing CLI or gateway and ambiguous transport, execution, capture, or cleanup remain explicit UNKNOWN unless a validated local contradiction warrants FAIL."},"evidence_set_digest":"sha256:5c789f0b1e6db74005ba500c4281c11a805b3854099a63ee7ad5a48b467af2c2","reason":"Exact config, image pin, resource limits, filesystem and network rules, ownership labels, negative probes, and fail-closed result mapping govern backend admission and execution. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"Verifier runner, optional adapter, pinned OpenShell CLI, selected gateway/workspace, uniquely labelled sandbox, in-sandbox probes, and selected subject process.","roles":"Verifier validates and sequences; the CLI transports commands; the gateway manages sandbox state; probes observe named controls; the subject supplies only its selected process behavior.","states":"Unselected, config-validated, gateway-observed, creation-uncertain or created, bound, probed, staged, executed, rechecked, stopped, deleted, failed, or UNKNOWN.","transitions":"Each ordered CLI result and validation permits exactly the next lifecycle step; failures divert to owned cleanup and a fail-closed final status."},"evidence_set_digest":"sha256:1ffea3f262639be99bf49bbfb7188bf98df3492a6a6a8c5a74fc50c792b7f3ed","reason":"Runner, CLI, gateway, sandbox, probe, and subject exchange through ordered versioned commands and bounded responses with named failure and recovery states. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"Adapter result schema, config schema, OpenShell 0.1.3 version, canonical JSON shapes, pinned image digest, policy fields, and profile constraints must agree.","message_authority":"Only the pinned CLI invoked with the selected gateway/workspace and canonical responses bound to the random ownership label supplies backend state evidence.","ordering":"Version and gateway preflight precede create; binding and probes precede upload; source check precedes and follows subject execution; ownership recheck precedes stop/delete.","replay":"Every invocation uses a fresh token and sandbox, reacquires state, and refuses to treat a prior receipt or same-named external resource as current participation."},"evidence_set_digest":"sha256:1ffea3f262639be99bf49bbfb7188bf98df3492a6a6a8c5a74fc50c792b7f3ed","reason":"Runner, CLI, gateway, sandbox, probe, and subject exchange through ordered versioned commands and bounded responses with named failure and recovery states. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"CLI or network calls can fail, time out, truncate, return malformed data, create after client uncertainty, change bindings, or leave cleanup ambiguous.","liveness":"Per-command timeouts, bounded output readers, finite source set, one subject call, and finite cleanup polling bound client waiting but do not promise gateway availability.","recovery":"The adapter records creation ownership before the call, rechecks the label, attempts stop/delete, and returns failure or UNKNOWN when safe completion cannot be established.","safety":"No local fallback, unpinned image, inherited OpenShell override, login shell, ambient network grant, unowned cleanup, source mutation, or inferred success is allowed."},"evidence_set_digest":"sha256:1ffea3f262639be99bf49bbfb7188bf98df3492a6a6a8c5a74fc50c792b7f3ed","reason":"Runner, CLI, gateway, sandbox, probe, and subject exchange through ordered versioned commands and bounded responses with named failure and recovery states. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-robot-vstd-openshell-environment-55bbf0c19bd7; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-robot-vstd-openshell-environment-55bbf0c19bd7; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:18fe60a7beed2ede31013466589e7d039373f476a1b4e1e225b5c8efd7f5eb82","reason":"reasons.vstd:tier0-robot-vstd-openshell-environment-55bbf0c19bd7; fulfillment NOT_ESTABLISHED."},"SENSOR-0.1-acquisition-and-observations":{"declaration":{"acquisition":"The host launches pinned OpenShell CLI queries and sandbox commands; controlled Python probes acquire filesystem, identity, network, source, and subject-process observations.","deployment":"Optional host-side adapter to a selected OpenShell 0.1.3 gateway and one fresh remote or local gateway-managed sandbox; no physical transducer is deployed.","measurements":"The acquired values feed the OpenShell MEASUREMENT declarations and retain raw bounded command evidence rather than only a derived verdict.","phenomena":"Software-visible gateway state, sandbox policy and lifecycle state, staged-byte identity, named containment controls, process output and exit, and owned-resource disappearance."},"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The OpenShell CLI and in-sandbox probes actively acquire those software-environment observations; they are not physical sensors and make no physical calibration claim. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"SENSOR-0.2-calibration-and-envelope":{"declaration":{"calibration_applicability":"Physical calibration is inapplicable; software interpretation instead requires exact CLI version, adapter bytes, schemas, policy shape, and named probe semantics.","calibration_evidence":"CLI and adapter SHA-256 digests, exact version output, canonical gateway and sandbox records, requested policy digest, admitted policy binding, and deterministic probe code are retained.","drift":"Gateway version, sandbox generation, workspace, labels, policy, source bytes, and before/after binding are rechecked; any observed drift prevents PASS.","operating_range":"At most 256 selected files and 8 MiB total input, 1 MiB per output stream, 1 to 8 CPUs, enumerated 256 to 4096 MiB memory, and bounded command timeouts."},"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The OpenShell CLI and in-sandbox probes actively acquire those software-environment observations; they are not physical sensors and make no physical calibration claim. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"SENSOR-0.3-sampling-and-faults":{"declaration":{"fault_detection":"Nonzero exit, timeout, overflow, incomplete stream, malformed JSON, wrong version, missing target, failed probe, changed binding, source mutation, and cleanup ambiguity are named.","latency":"Each command has an explicit timeout and host-monotonic elapsed record; no claim is made about subcommand or remote scheduling latency.","recovery":"The adapter attempts stop and delete only after revalidating its ownership label; inability to prove cleanup downgrades a prior PASS to UNKNOWN.","sampling":"One ordered acquisition sequence per fresh run: gateway preflight, sandbox binding, negative probes, source check before and after execution, process result, and cleanup observation."},"evidence_set_digest":"sha256:9513f47cd4767938d2d8de52a302428bb5e21022a1ed1e58ee4a8fda2001e4ba","reason":"The OpenShell CLI and in-sandbox probes actively acquire those software-environment observations; they are not physical sensors and make no physical calibration claim. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"TRANSACTION-0.1-effects-and-authority":{"declaration":{"authorization":"The invoking user and configured gateway credentials authorize the CLI operations; Verifier adds an ownership token but claims no wider gateway, subject, publication, physical, or financial authority.","effects":"Creates one uniquely labelled sandbox, stages exact selected source bytes, launches the selected subject, then stops and deletes only that owned sandbox.","preconditions":"Explicit OpenShell selection, a canonical bounded config, a digest-pinned image, the pinned CLI and healthy gateway, exact input paths, and passing policy probes are required before subject launch.","resources":"One named gateway and workspace, one fresh sandbox, bounded CPU and memory, selected source files, one subject process, and bounded command streams."},"evidence_set_digest":"sha256:d9f291f97f6e2890920e2aff16fa235291f598bcf5c615fe0ccd2c1cd6560d98","reason":"Create, stage, execute, inspect, stop, and delete form a bounded remote lifecycle with explicit preconditions, authority, partial-failure, retry, cleanup, and finality boundaries. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"TRANSACTION-0.2-commit-and-failure":{"declaration":{"abort":"Any malformed input, incompatible response, denied probe, source mismatch, timeout, output overflow, binding drift, or command failure prevents a successful result and enters owned cleanup when creation may have occurred.","commit":"Subject completion is recorded only after exact-byte staging and pre-execution controls; cleanup completes only when the owned sandbox is observed absent after stop and delete.","finality":"A PASS is final only for the captured subject process and named probes in that fresh sandbox; remote durability, descendant effects, service continuity, and whole-object conformance are not established.","partial_failure":"Transport uncertainty can leave execution or cleanup UNKNOWN; creation ownership is recorded before the create call so later cleanup never assumes noncreation from a client timeout."},"evidence_set_digest":"sha256:d9f291f97f6e2890920e2aff16fa235291f598bcf5c615fe0ccd2c1cd6560d98","reason":"Create, stage, execute, inspect, stop, and delete form a bounded remote lifecycle with explicit preconditions, authority, partial-failure, retry, cleanup, and finality boundaries. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."},"TRANSACTION-0.3-retry-and-replay":{"declaration":{"duplicate_detection":"A fresh random ownership token and unique sandbox name distinguish each invocation, and cleanup rechecks the exact ownership label before mutation.","idempotency":"Source inspection and policy probes are repeatable over the same bytes; create and subject execution are not treated as idempotent or silently replayed.","replay":"A later run creates a new sandbox, reacquires gateway and policy observations, restages and rehashes source, and cannot reuse a prior PASS as current evidence.","retry_limits":"Commands have fixed timeouts, deletion observation has five bounded polls, and there is no automatic subject or create retry."},"evidence_set_digest":"sha256:d9f291f97f6e2890920e2aff16fa235291f598bcf5c615fe0ccd2c1cd6560d98","reason":"Create, stage, execute, inspect, stop, and delete form a bounded remote lifecycle with explicit preconditions, authority, partial-failure, retry, cleanup, and finality boundaries. This Tier-0 declaration names the boundary only; mechanism execution and higher-tier semantic fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Optional OpenShell execution environment, gateway lifecycle, policy probes, exact-byte staging and ENV projection."},"reason":"An explicitly selected sandbox backend is an ENV whose remote command, observation, policy and cleanup boundaries must not remain hidden inside generic package ownership. Boundary: Optional path only: the basic runner does not require OpenShell. Named probes and a successful subject process do not establish complete containment, corrigibility, availability, physical effects, financial effects or whole-object conformance.","specializations":["ACTUATOR","CONTROLLER","MEASUREMENT","POLICY","PROTOCOL","SENSOR","TRANSACTION"],"surfaces":["file:extensions/openshell/pyproject.toml","file:extensions/openshell/src/vstd_openshell/__init__.py","python:extensions/openshell/src/vstd_openshell/__init__.py:<module>","py