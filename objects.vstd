ence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd8566d06a6b596a1ca571bb229f5cc48e","reason":"reasons.vstd:tier0-measurement-vstd-application-authority-protocol-b427730ea39e; fulfillment NOT_ESTABLISHED."},"POLICY-0.1-rules-and-precedence":{"declaration":{"decision_inputs":"Host-authenticated profile/union/compiler/application selections plus exact policy and receipt bytes, independent digests, operation/revision/subject pins, evaluation time, and minimum status sequence.","defaults":"Forgery, substitution, denial, revocation, stale or inconsistent binding FAILS; missing, cancelled, carried, incomplete, or unavailable evidence remains UNKNOWN.","precedence":"Host pins and installed mechanism identity precede decoding; receipt body binds approvals; every approval and status envelope is authenticated before quorum/revocation/currentness determines replay state.","scope":"Replay one exact configured-key scope-admission or semantic-completeness receipt and bind a host-selected core application denominator without conflating signatures with human or legal authority."},"evidence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd8566d06a6b596a1ca571bb229f5cc48e","reason":"The configured-key application-authority protocol applies as POLICY. Its rule selection, authority boundary, defaults, exceptions, and enforcement points determine the bounded result. Reviewed boundary: A cryptographically valid configured-key application statement is not proof of personhood, legal authority, denominator truth, human acceptance, polish, publication, or release permission. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.2-authority-and-exceptions":{"declaration":{"activation":"Selected, policy current/expired, signatures valid/invalid, approval current/revoked, quorum met/unmet, execution/evidence current/stale, replay reproduced/rejected/not established, and application binding UNKNOWN/FAIL.","authority":"Configured keys authenticate only the exact current statements they sign; signatures and actor labels do not establish personhood, legal authority, denominator truth, human acceptance, polish, or release permission.","exceptions":"Record bytes, key/approval counts, exact Ed25519 backend version, supported operations, fixed schemas, digest pins, and finite application member sets bound replay.","revisions":"Strict-decode bounded policy/receipt records, pin installed source and revision digests, verify domain-separated Ed25519 envelopes under configured keys, enforce quorum/revocation/time rules, and compose conservative binding status."},"evidence_set_digest":"sha256:f00fbf48a25c81cb598a666dc8f46dcd8566d06a6b596a1ca571bb229f5cc48e","reason":"The configured-key application-authority protocol applies as POLICY. Its rule selection, authority boundary, defaults, exceptions, and enforcement points determine the bounded result. Reviewed boundary: A cryptographically valid configured-key application statement is not proof of personhood, legal authority, denominator truth, human acceptance, polish, publication, or release permission. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Record bytes, key/approval counts, exact Ed25519 backend version, supported operations, fixed schemas, digest pins, and finite application member sets bound replay.","decision_evidence":"Exact configured-key signatures, declared actor/key identifiers, revisions, subject, quorum, revocation list, time windows, application bindings, and blockers only.","enforcement_points":"Strict-decode bounded policy/receipt records, pin installed source and revision digests, verify domain-separated Ed25519 envelopes under configured keys, enforce quorum/revocation/time rules, and compose conservative binding status.","unavailable_behavior":"For