lished.","history":"LocalAnchorProvider owns the current in-memory anchor map; FileAnchorProvider additionally owns its append-only JSONL anchor record sequence.","ordering":"Epoch and sequence are retained in each record; file order is append order, while duplicate anchor identifiers must reproduce the same complete record.","state":"State is the exact ContinuityAnchor selected by anchor_id, including content identity, epoch, sequence, root, provider, time, and HMAC signature."},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"The anchor providers own authoritative local anchor-id history with append ordering, fork rejection, replay, and recovery boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.2-accounting-invariants":{"declaration":{"balance_rules":"An anchor_id may denote one exact record; a differing reuse is a fork and is rejected rather than balanced or netted.","rounding":"No numeric rounding occurs; digests, identifiers, epochs, and sequences are compared exactly.","sources_and_sinks":"Records enter only through anchor_content or validated JSONL loading; there is no delete, redemption, or compaction path.","units":"Accounting units are discrete anchor records keyed by anchor_id; epoch and sequence are bounded integer coordinates, not money or physical quantities."},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"The anchor providers own authoritative local anchor-id history with append ordering, fork rejection, replay, and recovery boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"LEDGER-0.3-correction-and-recovery":{"declaration":{"corrections":"Existing records are immutable. A correction requires a separately identified later anchor; same-id disagreement is rejected as a fork.","reconciliation":"Reconciliation compares exact anchor identity and record equality plus local HMAC verification; it does not consult an external witness.","recovery":"Recovery is bounded to reopening and validating the retained JSONL file; truncation, interrupted final writes, fsync durability, and external backup are not solved here.","replay":"JSONL loading deterministically reconstructs the anchor map and rejects malformed rows and conflicting duplicates."},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"The anchor providers own authoritative local anchor-id history with append ordering, fork rejection, replay, and recovery boundaries. This source-bound Tier-0 declaration states the boundary; mechanism truth and Tier-1-plus fulfillment remain unestablished."},"MARKET-0.1-orders-and-access":{"declaration":{"cancellation":"NOT_ESTABLISHED","order_states":"NOT_ESTABLISHED","participant_access":"NOT_ESTABLISHED","validation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-market-vstd-anchor-history-ledger-cd778d134390; fulfillment NOT_ESTABLISHED."},"MARKET-0.2-matching-and-allocation":{"declaration":{"allocation":"NOT_ESTABLISHED","manipulation_controls":"NOT_ESTABLISHED","matching":"NOT_ESTABLISHED","price_formation":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-market-vstd-anchor-history-ledger-cd778d134390; fulfillment NOT_ESTABLISHED."},"MARKET-0.3-settlement-and-disruption":{"declaration":{"disruption":"NOT_ESTABLISHED","finality":"NOT_ESTABLISHED","participant_failure":"NOT_ESTABLISHED","settlement_dependencies":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4597494ad939f2551d50cf1cf717785b0d6704ea832e87d9b78b5e70cc7b1062","reason":"reasons.vstd:tier0-market-vstd-anchor-history-ledger-cd7