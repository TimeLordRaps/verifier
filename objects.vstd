},"evidence_set_digest":"sha256:312a62657d3e3b8f9167af6fb90db7e7639a50d8434e28cc45a48d5625030401","reason":"core mechanism executor applies as POLICY. Its rule selection, authority, defaults, and enforcement points decide whether a consequential operation may proceed. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"POLICY-0.3-enforcement-and-decisions":{"declaration":{"bypass_handling":"Declared evidence, proposition and profile bounds constrain core data, but caller callback resources and side effects are not sandboxed by this path.","decision_evidence":"The core observes selected inputs, callback return values or exceptions, mechanism decisions, witness/probe outcomes and aggregate status only.","enforcement_points":"Core certification, evidence-session, witness, depth, translation and profile-obligation code validates selections, invokes admitted in-process mechanism callbacks, and retains typed decisions.","unavailable_behavior":"Invalid selection and known refutation fail closed; missing applicability, unavailable mechanism or unestablished evidence remains UNKNOWN. Callback side effects and interruption cannot be rolled back here."},"evidence_set_digest":"sha256:312a62657d3e3b8f9167af6fb90db7e7639a50d8434e28cc45a48d5625030401","reason":"core mechanism executor applies as POLICY. Its rule selection, authority, defaults, and enforcement points decide whether a consequential operation may proceed. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.1-participants-and-states":{"declaration":{"participants":"NOT_ESTABLISHED","roles":"NOT_ESTABLISHED","states":"NOT_ESTABLISHED","transitions":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:4c80ea206cea31f4fdccef1f1d017ef4b7fc02d0f4b348e328df21fad9ec1bf3","reason":"reasons.vstd:core-mechanism-executor-protocol-applies; fulfillment NOT_ESTABLISHED.