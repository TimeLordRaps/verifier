nd supplies no security or release clearance. This Tier-0 declaration names the reviewed exact-source boundary only; mechanism execution, semantic truth, and Tier-1-plus fulfillment remain unestablished."}},"operands":{},"payload":{"representation_role":"Externally selected secret-presence gate, refusal, and disclosure policy."},"reason":"Secret checks need exact selected scope, authority, non-disclosure, and unavailable-input behavior rather than accidental environment access. Boundary: The specification reads no secret, authenticates no selector, and supplies no security or release clearance.","specializations":[],"surfaces":["file:src/verifier/standard/SELECTED_SECRET_GATE.md"]},{"classification":{"ACTOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ACTUATOR":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"AGENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ARCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ASSET":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BENCH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"BOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"COLLECTIVE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"CONTROLLER":{"evidence_set_digest":"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676","reason":"The selected-source admission mechanism applies as CONTROLLER. It selects and sequences consequential acquisition, checking, replay, or output commands using bounded feedback and stop states. Exact source-specific basis: Admit one externally bound repository root and read only the regular members named by its exact manifest, source coordinate, generation, and byte bounds.","status":"APPLIES"},"DATA":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ENV":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"EVENT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"FINBOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"GRAPH":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HARDWARE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HARNESS":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HUMAN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"HYPER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"IDENTITY":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"LEDGER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"MARKET":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"MEASUREMENT":{"evidence_set_digest":"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676","reason":"The selected-source admission mechanism applies as MEASUREMENT. It captures host or repository values, so direct observations must be distinguished from inferred completeness and semantic truth. Exact source-specific basis: The mechanism observes manifest identity, root volume/file identity, path and handle metadata snapshots, cancellation state, exact member bytes, sizes, and SHA-256 correspondence.","status":"APPLIES"},"MODEL":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"OWNER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"POLICY":{"evidence_set_digest":"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676","reason":"The selected-source admission mechanism applies as POLICY. Its admission or case-selection rules, precedence, defaults, exceptions, and enforcement decide what may be accepted or emitted. Exact source-specific basis: Admit one externally bound repository root and read only the regular members named by its exact manifest, source coordinate, generation, and byte bounds.","status":"APPLIES"},"PROTOCOL":{"evidence_set_digest":"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676","reason":"The selected-source admission mechanism applies as PROTOCOL. Its participants, ordered records or exchanges, compatibility, replay, failure, and progress semantics form a distinct protocol boundary. Exact source-specific basis: The caller, its RootAdmission and consumed-admission set, a borrowed trusted root handle, the local filesystem, exact member readers, and the returned scope.","status":"APPLIES"},"RECEIPT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ROBOT":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"ROLE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SENSOR":{"evidence_set_digest":"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676","reason":"The selected-source admission mechanism applies as SENSOR. It actively acquires those digital observations and therefore needs an explicit source, range, drift, latency, and fault boundary. Exact source-specific basis: Strict manifest parsing, SHA-256 and size checks, canonical relative paths, Windows handle-relative no-follow traversal, before/open/after identity snapshots, cancellation checks, and deterministic handle cleanup.","status":"APPLIES"},"SIM":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"SPACE":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TIME":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TOKEN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRAIN":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"},"TRANSACTION":{"evidence_set_digest":"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676","reason":"The selected-source admission mechanism applies as TRANSACTION. Its bounded state or file effect has preconditions, commit, partial-failure, retry, and replay consequences that must be explicit. Exact source-specific basis: A successful bind adds one admission id to the caller-owned set; reads open and close local handles and return exact bytes without writing member content.","status":"APPLIES"},"VERIFIER":{"evidence_set_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","reason":"UNRESOLVED.","status":"UNRESOLVED"}},"evidence_sets":{"sha256:050abb87ccf744b329a563ca2c9641228174c4a70b4d401cc9a67d2ee6c29ded":[{"path":"scripts/exact_source_scope.py","sha256":"sha256:0304ca0eaf2f0dda052b205cf724fb22e7be959b1e1190c58c68733c06e6659b"}],"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945":[],"sha256:9cec2d0ad3cf0afb86e1eb0d63717071b0868234ea5a1568a11b4fdfae7ca676":[{"path":"scripts/admitted_root_binding.py","sha256":"sha256:39b6e1557e4de5e644c1c052a27937ccbdf55cddf154305d3c0386cac039b87d"},{"path":"scripts/exact_materialized_member.py","sha256":"sha256:aaa927e53de69b175acea5df61923632cce5ee849e801625b6c471145867fa59"},{"path":"scripts/exact_source_scope.py","sha256":"sha256:0304ca0eaf2f0dda052b205cf724fb22e7be959b1e1190c58c68733c06e6659b"},{"path":"scripts/windows_anchored_member.py","sha256":"sha256:af7c9be10f4c6f0d7e3a982bcce67e9d5cb5f31b5beb82f1bfe8f936e0ea71c7"}]},"kind":"POLICY","object_id":"vstd-selected-source-admission","obligations":{"ACTUATOR-0.1-command-to-effect":{"declaration":{"authority":"NOT_ESTABLISHED","commands":"NOT_ESTABLISHED","effect_domains":"NOT_ESTABLISHED","targets":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:050abb87ccf744b329a563ca2c9641228174c4a70b4d401cc9a67d2ee6c29ded","reason":"reasons.vstd:tier0-actuator-vstd-selected-source-admission-2c00988800ea; fulfillment NOT_ESTABLISHED."},"ACTUATOR-0.2-response-and-limits":{"declaration":{"limits":"NOT_EST