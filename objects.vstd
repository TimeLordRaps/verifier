ier client, registered publisher credential, and selected Claim Garden artifact endpoint.","roles":"Validate and transmit one exact SIM artifact/certificate/request envelope to the selected Claim Garden artifact endpoint and verify its quarantined state.","states":"Locally validated, transport-attempted, STORED/QUARANTINED, rejected, INDETERMINATE, or UNKNOWN.","transitions":"Local exact-byte and native replay checks precede one authenticated artifact POST."},"evidence_set_digest":"sha256:459b7bcc4bfe595e718f7455c6b4e7f95e339ad4c92acd524ba75507c3042ab5","reason":"SIM artifact submission applies as PROTOCOL. Its participants exchange ordered requests/responses across a process or remote boundary with explicit compatibility and failure states. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.2-ordering-and-replay":{"declaration":{"compatibility":"Exact canonical JSON bytes, source digest, native certificate replay, model transition and initial-state checks, authenticated bounded HTTPS, and strict response fields.","message_authority":"The caller and bearer credential authorize one remote artifact submission, not publication, payment, or physical execution.","ordering":"Local exact-byte and native replay checks precede one authenticated artifact POST.","replay":"No automatic retry follows a transport attempt; response uncertainty requires separate remote inspection."},"evidence_set_digest":"sha256:459b7bcc4bfe595e718f7455c6b4e7f95e339ad4c92acd524ba75507c3042ab5","reason":"SIM artifact submission applies as PROTOCOL. Its participants exchange ordered requests/responses across a process or remote boundary with explicit compatibility and failure states. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"PROTOCOL-0.3-failures-and-progress":{"declaration":{"failure_assumptions":"Pre-transport mismatch refuses; after transport, missing or inconsistent response remains INDETERMINATE/UNKNOWN.","liveness":"One bounded HTTPS request with finite timeout; quarantine review/publication progress has no guarantee.","recovery":"Inspect authenticated remote artifact state before an explicit new attempt; never infer remote abort or publication.","safety":"Canonical shape, exact digests, SIM/native bindings, model transition, endpoint, response bytes, and fields are bounded."},"evidence_set_digest":"sha256:459b7bcc4bfe595e718f7455c6b4e7f95e339ad4c92acd524ba75507c3042ab5","reason":"SIM artifact submission applies as PROTOCOL. Its participants exchange ordered requests/responses across a process or remote boundary with explicit compatibility and failure states. This Tier-0 declaration names the reviewed boundary only; mechanism execution and Tier-1-plus fulfillment remain unestablished."},"ROBOT-0.1-agent-to-actuator-binding":{"declaration":{"actuators":"NOT_ESTABLISHED","agent":"NOT_ESTABLISHED","controllers":"NOT_ESTABLISHED","harness":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:459b7bcc4bfe595e718f7455c6b4e7f95e339ad4c92acd524ba75507c3042ab5","reason":"reasons.vstd:tier0-robot-vstd-sim-artifact-publication-a966e778c12f; fulfillment NOT_ESTABLISHED."},"ROBOT-0.2-physical-reach-and-observation":{"declaration":{"confinement_evidence":"NOT_ESTABLISHED","domain_crossings":"NOT_ESTABLISHED","observations":"NOT_ESTABLISHED","physical_reach":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:459b7bcc4bfe595e718f7455c6b4e7f95e339ad4c92acd524ba75507c3042ab5","reason":"reasons.vstd:tier0-robot-vstd-sim-artifact-publication-a966e778c12f; fulfillment NOT_ESTABLISHED."},"ROBOT-0.3-consequences-and-intervention":{"declaration":{"hazards":"NOT_ESTABLISHED","intervention":"NOT_ESTABLISHED","operating_limits":"NOT_ESTABLISHED","safe_state_or_continuity":"NOT_ESTABLISHED"},"evidence_set_digest":"sha256:459b7bcc4bfe595e718f7455c6b4e7f95e339ad4c92acd524ba75507c3042ab5","reason":"reasons.vstd:tie