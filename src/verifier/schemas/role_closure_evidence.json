{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite ROLE closure retained evidence",
  "description": "Structural evidence grammar only. Installed native replay independently checks external selections, child certificates and temporal predicates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_certificate",
    "events",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "verifier-current-role-closure-evidence-1"
    },
    "lifecycle_certificate": {
      "type": [
        "string",
        "null"
      ],
      "contentEncoding": "base64"
    },
    "events": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "decisions": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "names": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "time_us",
        "action",
        "taking",
        "leaving"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "time_us": {
          "$ref": "#/$defs/instant"
        },
        "action": {
          "enum": [
            "TAKE",
            "LEAVE",
            "HANDOVER",
            "CHECKPOINT"
          ]
        },
        "taking": {
          "$ref": "#/$defs/names"
        },
        "leaving": {
          "$ref": "#/$defs/names"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "decision_id",
        "time_us",
        "actor_id",
        "identity_id",
        "scope",
        "decision_class",
        "content_digest"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "decision_id": {
          "$ref": "#/$defs/name"
        },
        "time_us": {
          "$ref": "#/$defs/instant"
        },
        "actor_id": {
          "$ref": "#/$defs/name"
        },
        "identity_id": {
          "$ref": "#/$defs/name"
        },
        "scope": {
          "$ref": "#/$defs/name"
        },
        "decision_class": {
          "$ref": "#/$defs/name"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "$id": "https://timelordraps.github.io/verifier/schemas/role_closure_evidence.json"
}
