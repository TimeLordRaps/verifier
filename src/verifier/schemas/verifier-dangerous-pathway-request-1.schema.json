{
  "$comment": "Verifier Standard (VSTD); JavaScript Object Notation (JSON); Secure Hash Algorithm 256-bit (SHA-256). Schema validity establishes structure only, never pathway clearance or publication authority.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-dangerous-pathway-request-1.schema.json",
  "title": "Verifier dangerous-pathway request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mechanism_digest", "artifact_digest", "derived_surface_digest",
    "source_coordinate_digest", "dependency_inventory_digest", "object_kind",
    "risk_policy_digest", "threat_catalog_digest", "threat_catalog_version",
    "pathway_search_scope_digest", "operating_envelope_digest",
    "capability_inventory_digest", "pathway_id", "catalog_entry_digest", "severity",
    "required_checks", "reviewer_policy_digest", "invalidator_policy_digest", "limits",
    "request_digest"
  ],
  "properties": {
    "schema_version": {"const": "verifier-dangerous-pathway-request-1"},
    "mechanism_digest": {"$ref": "#/$defs/digest"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "derived_surface_digest": {"$ref": "#/$defs/digest"},
    "source_coordinate_digest": {"$ref": "#/$defs/digest"},
    "dependency_inventory_digest": {"$ref": "#/$defs/digest"},
    "object_kind": {"$ref": "#/$defs/objectKind"},
    "risk_policy_digest": {"$ref": "#/$defs/digest"},
    "threat_catalog_digest": {"$ref": "#/$defs/digest"},
    "threat_catalog_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "pathway_search_scope_digest": {"$ref": "#/$defs/digest"},
    "operating_envelope_digest": {"$ref": "#/$defs/digest"},
    "capability_inventory_digest": {"$ref": "#/$defs/digest"},
    "pathway_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "catalog_entry_digest": {"$ref": "#/$defs/digest"},
    "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "required_checks": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/check"}
    },
    "reviewer_policy_digest": {"$ref": "#/$defs/digest"},
    "invalidator_policy_digest": {"$ref": "#/$defs/digest"},
    "limits": {"$ref": "#/$defs/limits"},
    "request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "objectKind": {
      "enum": ["ACTOR", "AGENT", "ARCH", "BENCH", "BOT", "COLLECTIVE", "DATA", "ENV", "EVENT", "GRAPH", "HARDWARE", "HARNESS", "HUMAN", "HYPER", "IDENTITY", "MODEL", "OBJECT", "OWNER", "RECEIPT", "ROLE", "SIM", "SPACE", "TIME", "TOKEN", "TRAIN", "VERIFIER"]
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "purpose", "mechanism_digest", "request_digest", "policy_digest", "confidential"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "purpose": {"enum": ["APPLICABILITY", "TRIGGER", "REFUTATION", "CAPABILITY_REMOVAL", "COUNTEREXAMPLE", "CONTAINMENT"]},
        "mechanism_digest": {"$ref": "#/$defs/digest"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "confidential": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_checks", "max_reviewers", "max_invalidators"],
      "properties": {
        "max_checks": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_reviewers": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_invalidators": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    }
  }
}
