{
  "$comment": "Terminology: generative simulation specification (VSTD-SIM); Verifier Standard (VSTD).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-sim-1.schema.json",
  "title": "Verifier Standard (VSTD) v2.0.0 Generative Simulation Receipt",
  "description": "Experimental declaration/receipt format. Schema validity establishes structure only; see docs/V2_CANDIDATE.md for mechanism limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "simulation_id",
    "tier",
    "verdict",
    "manifest_digest",
    "trajectory_root_digest",
    "invariants_checked",
    "findings",
    "shards_verified",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "verifier-sim-2"
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "simulation_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "SIM_1_TRACE_REPLAY",
        "SIM_2_INVARIANT_SAFETY",
        "SIM_3_BISIMULATION_ABSTRACTION",
        "SIM_4_AGENT_PARITY_CONTAINED",
        "SIM_5_DISTRIBUTED_SHARDED"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "VIOLATION_DETECTED",
        "NOT_ESTABLISHED"
      ]
    },
    "manifest_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "trajectory_root_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "invariants_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bisimulation_epsilon": {
      "type": [
        "number",
        "null"
      ]
    },
    "shards_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_digest": {
      "$ref": "#/$defs/sha256Digest"
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
