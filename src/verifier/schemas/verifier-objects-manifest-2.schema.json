{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-objects-manifest-2.schema.json",
  "title": "Extensible repository admission declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_digest", "extensions", "objects"],
  "properties": {
    "schema_version": {"const": "verifier-objects-manifest-2"},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/extension"}},
    "objects": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/object"}},
    "consequence_graph": {"$ref": "#/$defs/consequence_graph"},
    "instance_checks": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/instance_check"}},
    "execution_checks": {"type": "array", "maxItems": 4096,
      "description": "Selections are unique by object_id and mechanism together. An object may select several mechanisms; runtime validation rejects duplicate pairs.",
      "items": {"$ref": "#/$defs/execution_check"}}
  },
  "$defs": {
    "execution_check": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "mechanism", "reason", "evidence"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "mechanism": {"enum": ["verifier-local-invocation-ledger-1", "verifier-manifest-publication-1", "verifier-worker-protocol-1", "verifier-provenance-policy-1", "verifier-resource-measurement-1", "verifier-token-asset-1", "verifier-emulated-control-1"]},
        "reason": {"type": "string", "maxLength": 8192},
        "evidence": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "instance_check": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "coordinate", "semantic_version", "proposition_digest", "reason", "evidence", "request", "policy", "certificate"],
      "properties": {
        "object_id": {"type": "string"}, "coordinate": {"type": "string", "pattern": "^[A-Z]+-[1-3]\\.[1-9][0-9]*$"},
        "semantic_version": {"type": "string"}, "proposition_digest": {"type": "string"},
        "reason": {"type": "string"}, "evidence": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/reference"}},
        "request": {"$ref": "#/$defs/reference"}, "policy": {"$ref": "#/$defs/reference"}, "certificate": {"$ref": "#/$defs/reference"}
      }
    },
    "consequence_graph": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "edges", "effects"],
      "properties": {
        "schema_version": {"const": "verifier-consequence-graph-1"},
        "edges": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/consequence_edge"}},
        "effects": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/consequence_effect"}}
      }
    },
    "consequence_edge": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target", "relation", "reason", "evidence"],
      "properties": {
        "source": {"type": "string"}, "target": {"type": "string"},
        "relation": {"enum": ["influences", "embodies", "controls", "actuates", "decides"]},
        "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "consequence_effect": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "domain", "reason", "evidence"],
      "properties": {
        "object_id": {"type": "string"}, "domain": {"enum": ["REAL_PHYSICAL", "REAL_FINANCIAL", "SIMULATED"]},
        "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["reason", "evidence"],
      "properties": {
        "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "declaration": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "refutation": {
      "description": "Typed DOES_NOT_APPLY witness. Admission judges its digest, identity and current anchored bytes; the schema only fixes its shape.",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "object_id", "kind", "decision_status", "basis", "review_module",
                   "review_mechanism_digest", "review_row_digest", "source_anchors", "callee_anchors", "witness_digest"],
      "properties": {
        "schema": {"const": "verifier-dne-refutation-witness-1"},
        "object_id": {"type": "string"},
        "kind": {"type": "string"},
        "decision_status": {"const": "DOES_NOT_APPLY"},
        "basis": {"enum": ["EXECUTABLE_CLOSURE", "AUDITED_SOURCE"]},
        "review_module": {"type": "string"},
        "review_mechanism_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "review_row_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_anchors": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/anchor"}},
        "callee_anchors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/anchor"}},
        "witness_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "evidence"],
      "properties": {
        "status": {"enum": ["APPLIES", "DOES_NOT_APPLY", "UNRESOLVED"]},
        "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "refutation": {"$ref": "#/$defs/refutation"}
      },
      "if": {"required": ["refutation"]},
      "then": {"properties": {"status": {"const": "DOES_NOT_APPLY"}}}
    },
    "obligation": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "reason", "evidence_requirement"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-0\\.[1-9][0-9]*-[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
        "evidence_requirement": {"type": "string", "minLength": 1},
        "declaration_fields": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
        }
      }
    },
    "extension": {
      "type": "object", "additionalProperties": false, "required": ["kind", "extends", "version", "reason", "obligations"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,63}$"}, "extends": {"type": "string"},
        "version": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
        "obligations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/obligation"}}
      }
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "kind", "specializations", "payload", "operands", "surfaces", "reason", "classification", "obligations"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1, "maxLength": 256}, "kind": {"type": "string"},
        "specializations": {"$ref": "#/$defs/strings"}, "payload": {"type": "object"},
        "operands": {"type": "object", "additionalProperties": {"$ref": "#/$defs/strings"}},
        "surfaces": {"$ref": "#/$defs/strings"}, "reason": {"type": "string"},
        "classification": {"type": "object", "additionalProperties": {"$ref": "#/$defs/classification"}},
        "obligations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/binding"}}
      }
    }
  }
}
