{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-quality-profile-1.schema.json",
  "title": "Selected check-only quality application profile, version 1",
  "description": "Exact raw profile bytes require an independently selected digest. Selected source paths are inventoried per run; consumer policy and required choices cannot be inferred from candidate metadata. Passing checks establish only declared formatting predicates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "stages", "timeout_seconds", "max_output_bytes"],
  "properties": {
    "schema_version": {"const": "verifier-quality-profile-1"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "timeout_seconds": {"type": "number", "minimum": 0.05, "maximum": 60},
    "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "stages": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/stage"},
      "allOf": [
        {"contains": {"properties": {"id": {"const": "comment-format"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "lint"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "pretty-format"}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*\/)?\\.\\.?(?:\/|$))[^/]+(?:/[^/]+)*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "interpreter_digest", "distribution_digest"],
      "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "interpreter_digest": {"$ref": "#/$defs/digest"}, "distribution_digest": {"$ref": "#/$defs/digest"}}
    },
    "config": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selected", "required", "backend", "tool", "config"],
      "properties": {
        "id": {"enum": ["comment-format", "lint", "pretty-format"]},
        "selected": {"type": "boolean"}, "required": {"type": "boolean"},
        "backend": {"type": ["string", "null"]},
        "tool": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tool"}]},
        "config": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/config"}]}
      },
      "allOf": [
        {"if": {"properties": {"selected": {"const": false}}}, "then": {"properties": {"required": {"const": false}, "backend": {"type": "null"}, "tool": {"type": "null"}, "config": {"type": "null"}}}},
        {"if": {"properties": {"selected": {"const": true}, "id": {"const": "comment-format"}}}, "then": {"properties": {"backend": {"const": "builtin-managed-python-comments-1"}, "tool": {"type": "null"}, "config": {"type": "null"}}}},
        {"if": {"properties": {"selected": {"const": true}, "id": {"const": "lint"}}}, "then": {"properties": {"backend": {"const": "ruff"}, "tool": {"$ref": "#/$defs/tool"}, "config": {"$ref": "#/$defs/config"}}}},
        {"if": {"properties": {"selected": {"const": true}, "id": {"const": "pretty-format"}}}, "then": {"properties": {"backend": {"const": "black"}, "tool": {"$ref": "#/$defs/tool"}, "config": {"$ref": "#/$defs/config"}}}}
      ]
    }
  }
}
