{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-birth-token-1.schema.json",
  "title": "Verifier Standard (VSTD) zero-identity birth token",
  "description": "Cryptographic commitment anchoring an actor creation epoch without disclosing civil identity or activity telemetry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token_id",
    "genesis_key_digest",
    "birth_epoch",
    "commitment",
    "issued_at",
    "signature_base64url"
  ],
  "properties": {
    "schema_version": {
      "const": "VSTD-BIRTH-TOKEN-1"
    },
    "token_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "genesis_key_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "birth_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "commitment": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "declared_parameters": {
      "type": "object"
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signature_base64url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
