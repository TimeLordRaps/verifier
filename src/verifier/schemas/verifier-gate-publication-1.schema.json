{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-gate-publication-1.schema.json",
  "title": "Minimized local gate report for private submission review",
  "description": "Structural projection only; no execution authentication, original-receipt proof, account authority or native domain validity. Unicode Transformation Format, 8-bit (UTF-8). Byte counts are UTF-8 bytes; digest values have no physical unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "source_receipt_digest",
    "runner_digest",
    "manifest_digest",
    "inputs",
    "final_inputs",
    "inputs_unchanged",
    "steps",
    "status",
    "projection_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "verifier-gate-publication-1"
    },
    "evidence_class": {
      "const": "UNAUTHENTICATED_LOCAL_REPORT"
    },
    "source_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runner_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "final_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "inputs_unchanged": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "needs",
          "result_contract",
          "status",
          "exit_code",
          "cleanup",
          "stdout_digest",
          "stderr_digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "needs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
            }
          },
          "result_contract": {
            "enum": [
              "process-exit",
              "vstd-verdict"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "ERROR",
              "TIMEOUT",
              "OUTPUT_LIMIT",
              "BLOCKED"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cleanup": {
            "enum": [
              "UNKNOWN",
              "NOT_STARTED",
              "OWNED_TREE_TERMINATED",
              "OWNED_GROUP_SIGNALLED"
            ]
          },
          "stdout_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stderr_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "projection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
