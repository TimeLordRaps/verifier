{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-polish-workflow-policy-1.schema.json",
  "title": "Preparation-only workflow policy, version 1",
  "description": "Independently selected exact JavaScript Object Notation (JSON) bytes select installed bounded preparation dispatchers. No executable hooks, environment injection, publication, or qualification authority. Runtime additionally checks portable unique paths, installed prerequisites and an acyclic dependency graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_paths", "stages", "bounds"],
  "properties": {
    "schema_version": {"const": "verifier-polish-workflow-policy-1"},
    "input_paths": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "stages": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/stage"}},
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["max_files", "max_file_bytes", "max_total_bytes"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    }
  },
  "$defs": {
    "stageId": {"enum": ["bind-inputs", "validate-definitions", "project-comments", "compile-explanations", "quality", "retain-bundle"]},
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selected", "required", "depends_on"],
      "properties": {
        "id": {"$ref": "#/$defs/stageId"},
        "selected": {"type": "boolean"},
        "required": {"type": "boolean"},
        "depends_on": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/stageId"}}
      },
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"properties": {"selected": {"const": true}}}}]
    }
  }
}
