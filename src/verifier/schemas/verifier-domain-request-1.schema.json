{
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-domain-request-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "domain": {
            "const": "DATA"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "ENV"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "BENCH"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "HYPER"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "MODEL"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "SIM"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "HARNESS"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "AGENT"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "BOT"
          }
        }
      },
      "then": {
        "properties": {
          "target_depth": {
            "maximum": 5
          }
        }
      }
    }
  ],
  "description": "Structural envelope only. Domain evaluators check retained contract semantics; certificate replay requires external intent and policy.",
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "domain": {
      "enum": [
        "DATA",
        "ENV",
        "BENCH",
        "HYPER",
        "MODEL",
        "SIM",
        "HARNESS",
        "AGENT",
        "BOT"
      ]
    },
    "evidence_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "verifier-domain-request-1"
    },
    "subject_id": {
      "minLength": 1,
      "type": "string"
    },
    "target_depth": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "domain",
    "subject_id",
    "artifact_digest",
    "evidence_ref",
    "target_depth"
  ],
  "title": "Verifier Standard domain request version 1",
  "type": "object"
}
