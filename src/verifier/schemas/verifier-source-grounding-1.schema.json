{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-source-grounding-1.schema.json",
  "title": "Verifier Standard experimental source-grounding records",
  "description": "Structural validation only for Verifier Standard (VSTD). Canonical JavaScript Object Notation (JSON) bytes, Secure Hash Algorithm 256-bit (SHA-256) byte binding, source and certificate identity, semantic-frame support, mechanism execution, proposition evaluation, and receipt reproduction require the direct-module mechanism.",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/certificate" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/profile" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "string_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" },
      "description": "The mechanism additionally requires strict Unicode Transformation Format, 8-bit (UTF-8) byte order."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "size_bytes"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "implementation_version", "mechanism_profile_digest"],
      "properties": {
        "implementation_id": { "$ref": "#/$defs/text" },
        "implementation_version": { "$ref": "#/$defs/text" },
        "mechanism_profile_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facets", "frame_id", "proposition_language", "vocabulary_digest"],
      "properties": {
        "facets": { "$ref": "#/$defs/string_array" },
        "frame_id": { "$ref": "#/$defs/text" },
        "proposition_language": { "$ref": "#/$defs/text" },
        "vocabulary_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "certificate", "declarer_coordinate", "ground_proposition", "interpretation", "schema_version", "semantic_frame", "source"],
      "properties": {
        "schema_version": { "const": "verifier-source-grounding-1" },
        "source": { "$ref": "#/$defs/reference" },
        "semantic_frame": { "$ref": "#/$defs/frame" },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checker_coordinate", "mechanism_id", "mechanism_profile_digest", "profile_id"],
          "properties": {
            "checker_coordinate": { "$ref": "#/$defs/checker" },
            "mechanism_id": { "$ref": "#/$defs/text" },
            "mechanism_profile_digest": { "$ref": "#/$defs/digest" },
            "profile_id": { "$ref": "#/$defs/text" }
          }
        },
        "ground_proposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "path", "predicate", "proposition_id"],
          "properties": {
            "expected": true,
            "path": { "$ref": "#/$defs/string_array" },
            "predicate": { "$ref": "#/$defs/text" },
            "proposition_id": { "$ref": "#/$defs/text" }
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certificate_kind", "digest", "size_bytes"],
          "properties": {
            "certificate_kind": { "enum": ["DERIVATION", "TRANSLATION"] },
            "digest": { "$ref": "#/$defs/digest" },
            "size_bytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
          }
        },
        "assumptions": { "$ref": "#/$defs/string_array" },
        "declarer_coordinate": { "$ref": "#/$defs/text" }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_kind", "checker_coordinate", "evidence_origin", "ground_proposition_digest", "interpretation_profile_digest", "mechanism_id", "observation", "producer_coordinate", "result", "schema_version", "semantic_frame_digest", "source_digest"],
      "properties": {
        "schema_version": { "const": "verifier-source-grounding-certificate-1" },
        "certificate_kind": { "enum": ["DERIVATION", "TRANSLATION"] },
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "evidence_origin": { "const": "MECHANISM_EXECUTION" },
        "ground_proposition_digest": { "$ref": "#/$defs/digest" },
        "interpretation_profile_digest": { "$ref": "#/$defs/digest" },
        "mechanism_id": { "$ref": "#/$defs/text" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "value"],
          "properties": {
            "path": { "$ref": "#/$defs/string_array" },
            "state": { "enum": ["ABSENT", "VALUE"] },
            "value": true
          }
        },
        "producer_coordinate": { "$ref": "#/$defs/text" },
        "result": { "enum": ["ESTABLISHED", "REFUTED"] },
        "semantic_frame_digest": { "$ref": "#/$defs/digest" },
        "source_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "certificate_digest", "checker_coordinate", "checks", "declaration_digest", "interpretation_profile_digest", "reason_codes", "residual_obligations", "result", "schema_version", "source_digest"],
      "properties": {
        "schema_version": { "const": "verifier-source-grounding-receipt-1" },
        "declaration_digest": { "$ref": "#/$defs/digest" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "certificate_digest": { "$ref": "#/$defs/digest" },
        "interpretation_profile_digest": { "$ref": "#/$defs/digest" },
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "result": { "enum": ["ESTABLISHED", "REFUTED", "UNKNOWN", "INVALID"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certificate_binding", "certificate_recheck", "frame_compatibility", "mechanism_support", "proposition_evaluation", "source_binding"],
          "properties": {
            "certificate_binding": { "type": "string" },
            "certificate_recheck": { "type": "string" },
            "frame_compatibility": { "type": "string" },
            "mechanism_support": { "type": "string" },
            "proposition_evaluation": { "type": "string" },
            "source_binding": { "type": "string" }
          }
        },
        "reason_codes": { "$ref": "#/$defs/string_array" },
        "residual_obligations": { "$ref": "#/$defs/string_array" },
        "assumptions": { "$ref": "#/$defs/string_array" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_frame_id", "accepted_language", "accepted_predicate", "canonical_records_required", "certificate_replay_required", "max_json_depth", "max_json_nodes", "max_source_bytes", "mechanism_id", "schema_version"],
      "properties": {
        "schema_version": { "const": "verifier-source-grounding-mechanism-profile-1" },
        "accepted_frame_id": { "const": "CANONICAL-JSON-OBJECT-0.1" },
        "accepted_language": { "const": "CANONICAL_JSON_OBJECT" },
        "accepted_predicate": { "const": "JSON_POINTER_EQUALS" },
        "canonical_records_required": { "const": true },
        "certificate_replay_required": { "const": true },
        "max_json_depth": { "const": 16 },
        "max_json_nodes": { "const": 4096 },
        "max_source_bytes": { "const": 1048576 },
        "mechanism_id": { "const": "canonical-json-pointer-equality-v1" }
      }
    }
  }
}
