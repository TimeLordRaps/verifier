{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-package-contract-coverage-2.schema.json",
  "title": "Verifier Standard package-variant contract coverage assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "through_tier", "registry_digest", "profile_registry_digest", "collection_digest", "source_census_digest", "verifier_id", "expected_instance_count", "observed_instance_count", "denominator_status", "finite_check_status", "status", "normative_coverage", "contracts", "findings", "claim_boundary", "assessment_digest"],
  "properties": {
    "schema_version": {"const": "verifier-package-contract-coverage-2"},
    "through_tier": {"type": "integer", "enum": [1, 2, 3]},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "profile_registry_digest": {"$ref": "#/$defs/digest"},
    "collection_digest": {"$ref": "#/$defs/digest"},
    "source_census_digest": {"$ref": "#/$defs/digest"},
    "verifier_id": {"$ref": "#/$defs/text"},
    "expected_instance_count": {"type": "integer", "minimum": 0},
    "observed_instance_count": {"type": "integer", "minimum": 0},
    "denominator_status": {"enum": ["PASS", "FAIL"]},
    "finite_check_status": {"$ref": "#/$defs/verdict"},
    "status": {"$ref": "#/$defs/verdict"},
    "normative_coverage": {"enum": ["PASS", "NOT_ESTABLISHED"]},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "claim_boundary": {"$ref": "#/$defs/text"},
    "assessment_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "denominator_status": {"const": "PASS"},
          "finite_check_status": {"const": "PASS"},
          "normative_coverage": {"const": "PASS"},
          "findings": {"maxItems": 0},
          "contracts": {
            "minItems": 1,
            "items": {"$ref": "#/$defs/passContract"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"normative_coverage": {"const": "PASS"}},
        "required": ["normative_coverage"]
      },
      "then": {"properties": {"status": {"const": "PASS"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "argv": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 6},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classification", "assessment_required", "reason"],
      "properties": {
        "status": {"type": ["string", "null"]},
        "classification": {"type": ["string", "null"]},
        "assessment_required": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "coordinate", "tier", "semantic_version", "proposition_digest", "reason", "exact_claim", "checking_mechanism", "status", "result_digest", "rerun_argv", "checker_status", "applicability", "fulfillment_required", "condition", "condition_status", "evidence_origin", "selected_check_digest", "closure_status"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/text"},
        "coordinate": {"$ref": "#/$defs/text"},
        "tier": {"type": "integer", "enum": [1, 2, 3]},
        "semantic_version": {"$ref": "#/$defs/text"},
        "proposition_digest": {"$ref": "#/$defs/digest"},
        "reason": {"$ref": "#/$defs/text"},
        "exact_claim": {"$ref": "#/$defs/text"},
        "checking_mechanism": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/verdict"},
        "result_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "rerun_argv": {"$ref": "#/$defs/argv"},
        "checker_status": {"type": ["string", "null"]},
        "applicability": {"$ref": "#/$defs/applicability"},
        "fulfillment_required": {"type": ["boolean", "null"]},
        "condition": {"type": ["string", "null"]},
        "condition_status": {"type": ["string", "null"]},
        "evidence_origin": {"type": ["string", "null"]},
        "selected_check_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "closure_status": {"$ref": "#/$defs/verdict"}
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_id", "reason", "status", "question", "mechanism", "boundary", "tier", "next_action"],
      "properties": {
        "source": {"enum": ["installed-package-variant-profile", "installed-kind-contract", "native-slot-planning-context", "admission-contract-semantic-remainder"]},
        "source_id": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "status": {"const": "UNKNOWN"},
        "question": {"$ref": "#/$defs/text"},
        "mechanism": {"type": ["string", "null"]},
        "boundary": {"$ref": "#/$defs/text"},
        "tier": {"type": "integer", "enum": [1, 2, 3]},
        "next_action": {"$ref": "#/$defs/argv"}
      }
    },
    "kindRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "declared", "necessity", "reasons", "source_census_digest"],
      "properties": {
        "kind": {"$ref": "#/$defs/text"},
        "declared": {"type": "boolean"},
        "necessity": {"enum": ["NECESSARY", "CONDITIONAL_UNRESOLVED"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "source_census_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_digest", "kind", "kind_requirement", "profile_version", "profile_digest", "profile_status", "bounded_exclusions", "finite_check_status", "clauses", "residual_requirements", "status"],
      "properties": {
        "object_id": {"$ref": "#/$defs/text"},
        "object_digest": {"$ref": "#/$defs/digest"},
        "kind": {"$ref": "#/$defs/text"},
        "kind_requirement": {"$ref": "#/$defs/kindRequirement"},
        "profile_version": {"type": ["string", "null"]},
        "profile_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "profile_status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_PROFILED"]},
        "bounded_exclusions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "finite_check_status": {"$ref": "#/$defs/verdict"},
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/clause"}},
        "residual_requirements": {"type": "array", "items": {"$ref": "#/$defs/residual"}},
        "status": {"$ref": "#/$defs/verdict"}
      }
    },
    "passClause": {
      "allOf": [
        {"$ref": "#/$defs/clause"},
        {"properties": {"status": {"const": "PASS"}, "closure_status": {"const": "PASS"}}}
      ]
    },
    "passContract": {
      "allOf": [
        {"$ref": "#/$defs/contract"},
        {
          "properties": {
            "profile_version": {"$ref": "#/$defs/text"},
            "profile_digest": {"$ref": "#/$defs/digest"},
            "profile_status": {"const": "PASS"},
            "finite_check_status": {"const": "PASS"},
            "clauses": {"minItems": 1, "items": {"$ref": "#/$defs/passClause"}},
            "residual_requirements": {"maxItems": 0},
            "status": {"const": "PASS"}
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "object_id", "coordinate", "obligation_id", "explanation", "rerun_argv"],
      "properties": {
        "code": {"$ref": "#/$defs/text"},
        "status": {"const": "FAIL"},
        "object_id": {"$ref": "#/$defs/text"},
        "coordinate": {"$ref": "#/$defs/text"},
        "obligation_id": {"type": ["string", "null"]},
        "explanation": {"$ref": "#/$defs/text"},
        "rerun_argv": {"anyOf": [
          {"type": "null"},
          {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 6}
        ]}
      }
    }
  }
}
