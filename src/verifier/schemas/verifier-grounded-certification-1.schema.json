              "5.11"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/obligation_result"
          }
        }
      },
      "required": [
        "status",
        "certification_status",
        "certified_profile_depth",
        "failed_obligations",
        "profiles",
        "obligations"
      ]
    }
  }
}
