            ]
          },
          "uniqueItems": true
        },
        "missing_prerequisite_profiles": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "obligation_count",
        "established_prefix",
        "coordinate_established",
        "cumulative_established",
        "blocking_obligations",
        "missing_prerequisite_profiles"
      ]
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "expected": {},
        "mechanism_id": {
          "type": "string",
          "minLength": 1
        },
        "mechanism_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "trust_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_evidence_items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "max_evidence_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            }
          },
          "required": [
            "max_evidence_items",
            "max_evidence_bytes"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "expected",
        "mechanism_id",
        "mechanism_digest",
        "evidence_refs",
        "trust_roots",
        "bounds",
        "parameters"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "verifier-grounded-request-1"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/claim_binding"
        },
        "target_profile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "obligations": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "1.1",
              "1.2",
              "1.3",
              "1.4",
              "1.5",
              "1.6",
              "1.7",
              "2.1",
              "2.2",
              "2.3",
              "2.4",
              "2.5",
              "2.6",
              "2.7",
              "3.1",
              "3.2",
              "3.3",
              "3.4",
              "3.5",
              "3.6",
              "3.7",
              "3.8",
              "4.1",
              "4.2",
              "4.3",
              "4.4",
              "4.5",
              "4.6",
              "4.7",
              "4.8",
              "4.9",
              "4.10",
              "4.11",
              "4.12",
              "4.13",
              "4.14",
              "5.1",
              "5.2",
              "5.3",
              "5.4",
              "5.5",
              "5.6",
              "5.7",
              "5.8",
              "5.9",
              "5.10",
              "5.11"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/proposition"
          }
        }
      },
      "required": [
        "schema_version",
        "claim_id",
        "binding",
        "target_profile",
        "obligations"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "certification_status": {
          "enum": [
            "ESTABLISHED",
            "NOT_ESTABLISHED"
          ]
        },
        "certified_profile_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "failed_obligations": {
          "type": "array",
          "items": {
            "enum": [
              "1.1",
              "1.2",
              "1.3",
              "1.4",
              "1.5",
              "1.6",
              "1.7",
              "2.1",
              "2.2",
