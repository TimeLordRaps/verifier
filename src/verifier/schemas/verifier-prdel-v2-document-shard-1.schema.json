{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-prdel-v2-document-shard-1.schema.json",
  "title": "Private PRDEL v2 document shard",
  "description": "A contiguous transport fragment with no independent semantic status or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding", "index", "start", "source_obligations", "records"],
  "properties": {
    "schema_version": {"const": "verifier-prdel-v2-document-shard-1"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "source_digest", "requirements_digest"],
      "properties": {
        "base": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "head": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirements_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "index": {"type": "integer", "minimum": 0},
    "start": {"type": "integer", "minimum": 0},
    "source_obligations": {"type": "array", "minItems": 1, "maxItems": 40000, "items": {"type": "object", "required": ["id"]}},
    "records": {"type": "array", "minItems": 1, "maxItems": 40000, "items": {"type": "object", "required": ["id"]}}
  }
}
