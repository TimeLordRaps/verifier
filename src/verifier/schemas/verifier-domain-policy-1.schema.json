{
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-domain-policy-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural envelope only. Domain evaluators check retained contract semantics; certificate replay requires external intent and policy.",
  "properties": {
    "max_evidence_bytes": {
      "maximum": 8388608,
      "minimum": 1,
      "type": "integer"
    },
    "max_items": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "max_operations": {
      "maximum": 10000000,
      "minimum": 1,
      "type": "integer"
    },
    "max_tolerance": {
      "maximum": 0.0001,
      "minimum": 0,
      "type": "number"
    },
    "mechanism_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "verifier-domain-policy-1"
    },
    "trust_roots": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "witness_keys": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "mechanism_digest",
    "trust_roots",
    "witness_keys",
    "max_operations",
    "max_items",
    "max_evidence_bytes",
    "max_tolerance"
  ],
  "title": "Verifier Standard domain policy version 1",
  "type": "object"
}
