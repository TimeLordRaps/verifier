{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-prdel-compilation-1.schema.json",
  "title": "Pull Request Domain Explanation Language (PRDEL) compilation, version 1",
  "description": "Deterministic explanation compilation only. Schema conformance or compilation success supplies no gate clearance, execution evidence or behavioral correctness. Every rule and input must be replayed independently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "binding", "definitions", "definition_digest", "rule_catalogue", "rule_results", "residuals", "status", "operation_status", "gate_status", "scope", "counters", "limits"],
  "properties": {
    "schema_version": {"const": "verifier-prdel-compilation-1"},
    "document": {"anyOf": [{"type": "null"}, {"$ref": "verifier-prdel-1.schema.json"}]},
    "binding": {"anyOf": [{"type": "null"}, {"$ref": "verifier-prdel-1.schema.json#/$defs/binding"}]},
    "definitions": {"anyOf": [{"type": "null"}, {"$ref": "verifier-explanation-definitions-1.schema.json"}]},
    "definition_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "rule_catalogue": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/rule"}},
    "rule_results": {"type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/result"}},
    "residuals": {"type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/residual"}},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "operation_status": {"enum": ["GENERATED", "BLOCKED"]},
    "gate_status": {"const": "NOT_ASSESSED"},
    "scope": {"const": "EXPLANATION_COMPILATION_ONLY"},
    "counters": {"type": "object", "additionalProperties": false, "required": ["operations", "explanatory_text_bytes"], "properties": {"operations": {"type": "integer", "minimum": 0}, "explanatory_text_bytes": {"type": "integer", "minimum": 0}}},
    "limits": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}
  },
  "$defs": {
    "ruleId": {"enum": ["exact-region", "empty-diff", "syntactic-relationship", "selected-association", "finite-cases", "explicit-exclusions", "unresolved-frontier", "authored-intent"]},
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "mechanism", "support", "assumptions", "bounds", "counterexamples"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"}, "version": {"const": "1"},
        "mechanism": {"type": "string", "minLength": 1}, "support": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "counterexamples": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bounds": {"type": "object", "additionalProperties": false, "required": ["max_operations", "max_document_bytes", "max_claims_per_record"], "properties": {"max_operations": {"type": "integer", "minimum": 1}, "max_document_bytes": {"type": "integer", "minimum": 1}, "max_claims_per_record": {"type": "integer", "minimum": 1}}}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "rule_version", "status", "obligation_id", "support_role"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/ruleId"}, "rule_version": {"const": "1"},
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_SELECTED"]},
        "obligation_id": {"type": ["string", "null"]}, "requirement_id": {"type": "string"},
        "support_role": {"enum": ["INDEPENDENTLY_SELECTED_FINITE_EXPECTATIONS", "RETAINED_UNRESOLVED_BOUNDARY", "AUTHORED_OR_SELECTED_ASSOCIATION", "SUPPORTED_SOURCE_PREDICATE", "LIMITATION", "AUTHORED_INTENT_ONLY"]},
        "claim": {"$ref": "verifier-prdel-1.schema.json#/$defs/claim"},
        "exclusion_ids": {"type": "array", "items": {"type": "string"}},
        "definition_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "residual": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "status", "required", "obligation_id", "requirement_id", "reason", "question"],
      "properties": {
        "code": {"type": "string"}, "status": {"enum": ["FAIL", "UNKNOWN"]},
        "required": {"type": "boolean"}, "obligation_id": {"type": ["string", "null"]},
        "requirement_id": {"type": ["string", "null"]}, "reason": {"type": "string"}, "question": {"type": "string"}
      }
    }
  }
}
