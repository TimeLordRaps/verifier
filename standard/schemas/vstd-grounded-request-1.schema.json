{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-grounded-request-1.schema.json",
  "title": "Verifier Standard grounded request version 1",
  "description": "Structural contract only. Replay under an external policy and exact expected request is required for certification.",
  "$ref": "#/$defs/request",
  "$defs": {
    "claim_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "coordinate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "subject",
            "predicate",
            "parameters"
          ]
        },
        "policy_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "specification_hash": {
              "type": "string",
              "minLength": 1
            },
            "implementation_hash": {
              "type": "string",
              "minLength": 1
            },
            "parser_hash": {
              "type": "string",
              "minLength": 1
            },
            "certificate_format": {
              "type": "string",
              "minLength": 1
            },
            "format_fragment": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deterministic": {
              "type": "boolean"
            }
          },
          "required": [
            "specification_hash",
            "implementation_hash",
            "parser_hash",
            "certificate_format",
            "format_fragment",
            "dependencies",
            "deterministic"
          ]
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verification_cost_bound": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "memory_bound": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "certificate_size_bound": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "verification_cost_bound",
            "memory_bound",
            "certificate_size_bound"
          ]
        },
        "prior_commitment": {
          "type": "string"
        }
      },
      "required": [
        "claim",
        "coordinate",
        "policy_root",
        "evidence_root",
        "verifier",
        "bounds",
        "prior_commitment"
      ]
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "expected": {},
        "mechanism_id": {
          "type": "string",
          "minLength": 1
        },
        "mechanism_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "trust_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_evidence_items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "max_evidence_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            }
          },
          "required": [
            "max_evidence_items",
            "max_evidence_bytes"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "expected",
        "mechanism_id",
        "mechanism_digest",
        "evidence_refs",
        "trust_roots",
        "bounds",
        "parameters"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "VSTD-GROUNDED-REQUEST-1"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/claim_binding"
        },
        "target_profile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "obligations": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "1.1",
              "1.2",
              "1.3",
              "1.4",
              "1.5",
              "1.6",
              "1.7",
              "2.1",
              "2.2",
              "2.3",
              "2.4",
              "2.5",
              "2.6",
              "2.7",
              "3.1",
              "3.2",
              "3.3",
              "3.4",
              "3.5",
              "3.6",
              "3.7",
              "3.8",
              "4.1",
              "4.2",
              "4.3",
              "4.4",
              "4.5",
              "4.6",
              "4.7",
              "4.8",
              "4.9",
              "4.10",
              "4.11",
              "4.12",
              "4.13",
              "4.14",
              "5.1",
              "5.2",
              "5.3",
              "5.4",
              "5.5",
              "5.6",
              "5.7",
              "5.8",
              "5.9",
              "5.10",
              "5.11"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/proposition"
          }
        }
      },
      "required": [
        "schema_version",
        "claim_id",
        "binding",
        "target_profile",
        "obligations"
      ]
    }
  }
}
