{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/verifier-global-cycle-assessment-1.schema.json",
  "title": "Verifier Standard experimental global-cycle assessment records",
  "description": "Structural validation only for Verifier Standard (VSTD). Secure Hash Algorithm 256-bit (SHA-256) byte binding, canonical JavaScript Object Notation (JSON), source grounding, relation replay, role separation, graph solving, semantic completeness, and receipt reproduction require the direct-module mechanism.",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/semantic_source" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71 },
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_digest", "proposition_id"],
      "properties": { "artifact_digest": { "$ref": "#/$defs/digest" }, "proposition_id": { "$ref": "#/$defs/text" } }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["grounding_declaration_digest", "grounding_receipt_digest", "relation_declaration_digest", "relation_id", "receipt_digest", "semantic_source_digest"],
      "properties": {
        "grounding_declaration_digest": { "$ref": "#/$defs/digest" },
        "grounding_receipt_digest": { "$ref": "#/$defs/digest" },
        "relation_declaration_digest": { "$ref": "#/$defs/digest" },
        "relation_id": { "$ref": "#/$defs/text" },
        "receipt_digest": { "$ref": "#/$defs/digest" },
        "semantic_source_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["relations", "schema_version"],
      "properties": {
        "schema_version": { "const": "verifier-global-cycle-assessment-1" },
        "relations": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/relation" } }
      }
    },
    "semantic_common": {
      "type": "object",
      "required": ["relation_declaration_digest", "relation_receipt_digest", "schema_version", "source_endpoint", "target_endpoint"],
      "properties": {
        "schema_version": { "const": "verifier-cycle-relation-semantics-1" },
        "relation_declaration_digest": { "$ref": "#/$defs/digest" },
        "relation_receipt_digest": { "$ref": "#/$defs/digest" },
        "source_endpoint": { "$ref": "#/$defs/endpoint" },
        "target_endpoint": { "$ref": "#/$defs/endpoint" }
      }
    },
    "semantic_body": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/semantic_common" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["relation_declaration_digest", "relation_receipt_digest", "schema_version", "source_endpoint", "support", "target_endpoint"],
              "properties": {
                "schema_version": { "const": "verifier-cycle-relation-semantics-1" },
                "relation_declaration_digest": { "$ref": "#/$defs/digest" },
                "relation_receipt_digest": { "$ref": "#/$defs/digest" },
                "source_endpoint": { "$ref": "#/$defs/endpoint" },
                "target_endpoint": { "$ref": "#/$defs/endpoint" },
                "support": {
                  "type": "object", "additionalProperties": false,
                  "required": ["direction", "relation"],
                  "properties": { "direction": { "const": "SOURCE_TO_TARGET" }, "relation": { "const": "DEPENDENCY" } }
                }
              }
            }
          ]
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["constraint", "relation_declaration_digest", "relation_receipt_digest", "schema_version", "source_endpoint", "target_endpoint"],
          "properties": {
            "schema_version": { "const": "verifier-cycle-relation-semantics-1" },
            "relation_declaration_digest": { "$ref": "#/$defs/digest" },
            "relation_receipt_digest": { "$ref": "#/$defs/digest" },
            "source_endpoint": { "$ref": "#/$defs/endpoint" },
            "target_endpoint": { "$ref": "#/$defs/endpoint" },
            "constraint": { "type": "object", "additionalProperties": false, "required": ["polarity"], "properties": { "polarity": { "enum": ["SAME", "INVERTED"] } } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["relation_declaration_digest", "relation_receipt_digest", "schema_version", "source_endpoint", "target_endpoint", "temporal"],
          "properties": {
            "schema_version": { "const": "verifier-cycle-relation-semantics-1" },
            "relation_declaration_digest": { "$ref": "#/$defs/digest" },
            "relation_receipt_digest": { "$ref": "#/$defs/digest" },
            "source_endpoint": { "$ref": "#/$defs/endpoint" },
            "target_endpoint": { "$ref": "#/$defs/endpoint" },
            "temporal": {
              "type": "object", "additionalProperties": false,
              "required": ["clock_id", "offset", "unit"],
              "properties": { "clock_id": { "$ref": "#/$defs/text" }, "offset": { "type": "integer" }, "unit": { "enum": ["tick", "nanosecond"] } }
            }
          }
        }
      ]
    },
    "semantic_source": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle_relation_semantics"],
      "properties": { "cycle_relation_semantics": { "$ref": "#/$defs/semantic_body" } }
    },
    "checker": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate_kind", "implementation_ref", "source_digest", "version"],
      "properties": {
        "coordinate_kind": { "const": "LOCAL_SOURCE_BYTES_NOT_RUNTIME_ATTESTATION" },
        "implementation_ref": { "$ref": "#/$defs/text" },
        "source_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "const": "UNAVAILABLE" }] },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "support_facet": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle_groups", "relation_ids", "status"],
      "properties": {
        "cycle_groups": { "type": "array", "items": { "$ref": "#/$defs/strings" } },
        "relation_ids": { "$ref": "#/$defs/strings" },
        "status": { "type": "string" }
      }
    },
    "constraint_facet": {
      "type": "object", "additionalProperties": false,
      "required": ["conflicting_relation_ids", "loop_closing_relation_ids", "relation_ids", "status"],
      "properties": {
        "conflicting_relation_ids": { "$ref": "#/$defs/strings" },
        "loop_closing_relation_ids": { "$ref": "#/$defs/strings" },
        "relation_ids": { "$ref": "#/$defs/strings" },
        "status": { "type": "string" }
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["clock_id", "conflicting_relation_ids", "loop_closing_relation_ids", "relation_ids", "status", "unit"],
      "properties": {
        "clock_id": { "$ref": "#/$defs/text" },
        "conflicting_relation_ids": { "$ref": "#/$defs/strings" },
        "loop_closing_relation_ids": { "$ref": "#/$defs/strings" },
        "relation_ids": { "$ref": "#/$defs/strings" },
        "status": { "type": "string" },
        "unit": { "enum": ["tick", "nanosecond"] }
      }
    },
    "temporal_facet": {
      "type": "object", "additionalProperties": false,
      "required": ["backward_time_relation_ids", "clocks", "status"],
      "properties": {
        "backward_time_relation_ids": { "$ref": "#/$defs/strings" },
        "clocks": { "type": "array", "items": { "$ref": "#/$defs/clock" } },
        "status": { "type": "string" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment_complete", "assessment_state", "checker_coordinate", "declaration_digest", "limits", "reason_codes", "relation_results", "residual_obligations", "schema_version", "semantics", "simultaneous_constraints", "support_dependencies", "temporal_relations"],
      "properties": {
        "schema_version": { "const": "verifier-global-cycle-assessment-receipt-1" },
        "assessment_complete": { "type": "boolean" },
        "assessment_state": { "enum": ["ASSESSED", "CONFLICTED", "UNKNOWN", "INVALID"] },
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "declaration_digest": { "$ref": "#/$defs/digest" },
        "limits": { "type": "object" },
        "reason_codes": { "$ref": "#/$defs/strings" },
        "relation_results": { "type": "array", "maxItems": 512, "items": { "type": "object" } },
        "residual_obligations": { "$ref": "#/$defs/strings" },
        "semantics": { "type": "object" },
        "simultaneous_constraints": { "$ref": "#/$defs/constraint_facet" },
        "support_dependencies": { "$ref": "#/$defs/support_facet" },
        "temporal_relations": { "$ref": "#/$defs/temporal_facet" }
      }
    }
  }
}
