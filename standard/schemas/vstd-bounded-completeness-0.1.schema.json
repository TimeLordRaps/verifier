{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-bounded-completeness-0.1.schema.json",
  "title": "Verifier Standard experimental bounded-completeness records",
  "description": "Structural validation only for Verifier Standard (VSTD). Canonical JavaScript Object Notation (JSON) bytes, Secure Hash Algorithm 256-bit (SHA-256) binding, external source grounding, denominator authority, member disposition, effectiveness, and receipt reproduction require the direct-module mechanism.",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/denominator" },
    { "$ref": "#/$defs/observations" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/profile" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71 },
    "text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" }, "description": "The mechanism additionally checks Unicode Transformation Format, 8-bit (UTF-8) byte ordering." },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "size_bytes"],
      "properties": { "digest": { "$ref": "#/$defs/digest" }, "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 } }
    },
    "grounding_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["declaration_digest", "ground_proposition_digest", "receipt_digest"],
      "properties": {
        "declaration_digest": { "$ref": "#/$defs/digest" },
        "ground_proposition_digest": { "$ref": "#/$defs/digest" },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "checker": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_id", "implementation_version", "mechanism_profile_digest"],
      "properties": {
        "implementation_id": { "$ref": "#/$defs/text" },
        "implementation_version": { "$ref": "#/$defs/text" },
        "mechanism_profile_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["declarer_coordinate", "denominator", "denominator_grounding", "observations", "profile_id", "schema_version"],
      "properties": {
        "schema_version": { "const": "VSTD-BOUNDED-COMPLETENESS-0.1" },
        "profile_id": { "$ref": "#/$defs/text" },
        "denominator": { "$ref": "#/$defs/reference" },
        "denominator_grounding": { "$ref": "#/$defs/grounding_reference" },
        "observations": { "$ref": "#/$defs/reference" },
        "declarer_coordinate": { "$ref": "#/$defs/text" }
      }
    },
    "denominator_member": {
      "type": "object", "additionalProperties": false,
      "required": ["ground_proposition_digest", "grounding_declaration_digest", "member_id"],
      "properties": {
        "ground_proposition_digest": { "$ref": "#/$defs/digest" },
        "grounding_declaration_digest": { "$ref": "#/$defs/digest" },
        "member_id": { "$ref": "#/$defs/text" }
      }
    },
    "denominator": {
      "type": "object", "additionalProperties": false,
      "required": ["members", "profile_id", "schema_version", "subject_id"],
      "properties": {
        "schema_version": { "const": "VSTD-BOUNDED-COMPLETENESS-DENOMINATOR-0.1" },
        "profile_id": { "$ref": "#/$defs/text" },
        "subject_id": { "$ref": "#/$defs/text" },
        "members": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/denominator_member" } }
      }
    },
    "observation_member": {
      "type": "object", "additionalProperties": false,
      "required": ["grounding_declaration_digest", "grounding_receipt_digest", "member_id"],
      "properties": {
        "grounding_declaration_digest": { "$ref": "#/$defs/digest" },
        "grounding_receipt_digest": { "$ref": "#/$defs/digest" },
        "member_id": { "$ref": "#/$defs/text" }
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["denominator_digest", "members", "procedure_id", "profile_id", "schema_version"],
      "properties": {
        "schema_version": { "const": "VSTD-BOUNDED-COMPLETENESS-OBSERVATIONS-0.1" },
        "profile_id": { "$ref": "#/$defs/text" },
        "denominator_digest": { "$ref": "#/$defs/digest" },
        "procedure_id": { "const": "source-grounding-replay-v1" },
        "members": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/observation_member" } }
      }
    },
    "member_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "ground_proposition_digest", "grounding_result", "member_id"],
      "properties": {
        "disposition": { "enum": ["DISPOSED", "NOT_CHECKED", "INVALID"] },
        "ground_proposition_digest": { "$ref": "#/$defs/digest" },
        "grounding_result": { "enum": ["ESTABLISHED", "REFUTED", "UNKNOWN", "INVALID"] },
        "member_id": { "$ref": "#/$defs/text" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["checker_coordinate", "checks", "declaration_digest", "denominator_digest", "effectiveness", "member_assessments", "observations_digest", "profile_id", "reason_codes", "residual_obligations", "result", "schema_version"],
      "properties": {
        "schema_version": { "const": "VSTD-BOUNDED-COMPLETENESS-RECEIPT-0.1" },
        "declaration_digest": { "$ref": "#/$defs/digest" },
        "denominator_digest": { "$ref": "#/$defs/digest" },
        "observations_digest": { "$ref": "#/$defs/digest" },
        "profile_id": { "$ref": "#/$defs/text" },
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "result": { "enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN", "INVALID"] },
        "checks": {
          "type": "object", "additionalProperties": false,
          "required": ["denominator_binding", "denominator_grounding", "member_binding", "member_recheck", "observation_binding", "profile_support"],
          "properties": {
            "denominator_binding": { "type": "string" },
            "denominator_grounding": { "type": "string" },
            "member_binding": { "type": "string" },
            "member_recheck": { "type": "string" },
            "observation_binding": { "type": "string" },
            "profile_support": { "type": "string" }
          }
        },
        "member_assessments": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/member_assessment" } },
        "effectiveness": {
          "type": "object", "additionalProperties": false,
          "required": ["byte_limit", "bytes_retained", "member_limit", "members_examined", "object_byte_limit", "procedure_id", "termination"],
          "properties": {
            "byte_limit": { "const": 8388608 },
            "bytes_retained": { "type": "integer", "minimum": 0, "maximum": 8388608 },
            "member_limit": { "const": 256 },
            "members_examined": { "type": "integer", "minimum": 0, "maximum": 256 },
            "object_byte_limit": { "const": 1048576 },
            "procedure_id": { "const": "bounded-direct-replay-v1" },
            "termination": { "const": "TERMINATED" }
          }
        },
        "reason_codes": { "$ref": "#/$defs/strings" },
        "residual_obligations": { "$ref": "#/$defs/strings" }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["decisive_grounding_results", "denominator_kind", "max_evidence_bytes", "max_json_depth", "max_json_nodes", "max_members", "max_object_bytes", "max_record_bytes", "profile_id", "schema_version"],
      "properties": {
        "schema_version": { "const": "VSTD-BOUNDED-COMPLETENESS-MECHANISM-PROFILE-0.1" },
        "decisive_grounding_results": { "const": ["ESTABLISHED", "REFUTED"] },
        "denominator_kind": { "const": "EXACT_EXTERNALLY_SOURCE_GROUNDED_FINITE_SET" },
        "max_evidence_bytes": { "const": 8388608 },
        "max_json_depth": { "const": 24 },
        "max_json_nodes": { "const": 16384 },
        "max_members": { "const": 256 },
        "max_object_bytes": { "const": 1048576 },
        "max_record_bytes": { "const": 262144 },
        "profile_id": { "const": "source-grounded-finite-disposition-coverage-v1" }
      }
    }
  }
}
