{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-silo-composition-assessment-receipt-0.1.schema.json",
  "title": "Verifier Standard (VSTD) experimental silo composition assessment receipt",
  "description": "Binds a composition declaration, reference mechanism, independently computed member receipts, optional composite receipt, and computed composition result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "declaration_digest", "composition_mechanism_digest", "member_assessment_receipts", "composite_assessment_receipt", "assessment"],
  "properties": {
    "schema_version": {"const": "VSTD-SILO-COMPOSITION-ASSESSMENT-RECEIPT-0.1"},
    "declaration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composition_mechanism_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "member_assessment_receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "vstd-silo-assessment-receipt-0.1.schema.json"}
    },
    "composite_assessment_receipt": {
      "oneOf": [
        {"$ref": "vstd-silo-assessment-receipt-0.1.schema.json"},
        {"type": "null"}
      ]
    },
    "assessment": {"$ref": "vstd-silo-composition-assessment-0.1.schema.json"}
  }
}
