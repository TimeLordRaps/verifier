{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-actor-binding-1.schema.json",
  "title": "Verifier Standard (VSTD) zero-identity actor binding",
  "description": "Mutually-signed edge binding an actor to a publisher or operator as an adjacent proposition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "kind",
    "actor_id",
    "subject_id",
    "bound_proposition",
    "actor_key_id",
    "subject_key_id",
    "issued_at",
    "actor_signature_base64url",
    "subject_signature_base64url"
  ],
  "properties": {
    "schema_version": {
      "const": "VSTD-ACTOR-BINDING-1"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "PUBLISHER_CONTROL",
        "PIPELINE_OPERATION"
      ]
    },
    "actor_id": {
      "type": "string",
      "pattern": "^actor:sha256:[0-9a-f]{64}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bound_proposition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "actor_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actor_signature_base64url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "subject_signature_base64url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
