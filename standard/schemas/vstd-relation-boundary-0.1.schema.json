{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelordraps.github.io/verifier/schemas/vstd-relation-boundary-0.1.schema.json",
  "title": "Verifier Standard experimental relation-boundary records",
  "description": "Structural validation only for Verifier Standard (VSTD). Canonical JavaScript Object Notation (JSON) bytes, Secure Hash Algorithm 256-bit (SHA-256) binding, facet partitioning, semantic-frame compatibility, mechanism execution, information preservation, and receipt reproduction require the direct-module mechanism.",
  "oneOf": [
    { "$ref": "#/$defs/declaration" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/profile" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71 },
    "text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "strings": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/text" }, "description": "The mechanism additionally checks Unicode Transformation Format, 8-bit (UTF-8) byte ordering." },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "size_bytes"],
      "properties": { "digest": { "$ref": "#/$defs/digest" }, "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 } }
    },
    "checker": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_id", "implementation_version", "mechanism_profile_digest"],
      "properties": {
        "implementation_id": { "$ref": "#/$defs/text" },
        "implementation_version": { "$ref": "#/$defs/text" },
        "mechanism_profile_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["facets", "frame_id", "proposition_language", "vocabulary_digest"],
      "properties": {
        "facets": { "$ref": "#/$defs/strings" },
        "frame_id": { "$ref": "#/$defs/text" },
        "proposition_language": { "$ref": "#/$defs/text" },
        "vocabulary_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "proposition_id", "semantic_frame"],
      "properties": {
        "artifact": { "$ref": "#/$defs/reference" },
        "proposition_id": { "$ref": "#/$defs/text" },
        "semantic_frame": { "$ref": "#/$defs/frame" }
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["source_facet", "target_facet"],
      "properties": { "source_facet": { "$ref": "#/$defs/text" }, "target_facet": { "$ref": "#/$defs/text" } }
    },
    "mappings": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/mapping" } },
    "translation": {
      "type": "object", "additionalProperties": false,
      "required": ["checker_coordinate", "mechanism_id", "mechanism_profile_digest"],
      "properties": {
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "mechanism_id": { "$ref": "#/$defs/text" },
        "mechanism_profile_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["assumptions", "consumed_facets", "evidence", "loss_map", "preservation_map", "schema_version", "source", "target", "translation"],
      "properties": {
        "schema_version": { "const": "VSTD-RELATION-BOUNDARY-0.1" },
        "source": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" },
        "translation": { "$ref": "#/$defs/translation" },
        "evidence": { "$ref": "#/$defs/reference" },
        "consumed_facets": { "$ref": "#/$defs/strings" },
        "preservation_map": { "$ref": "#/$defs/mappings" },
        "loss_map": { "$ref": "#/$defs/strings" },
        "assumptions": { "$ref": "#/$defs/strings" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["equal", "source_facet", "source_value_digest", "target_facet", "target_value_digest"],
      "properties": {
        "equal": { "type": "boolean" },
        "source_facet": { "$ref": "#/$defs/text" },
        "source_value_digest": { "$ref": "#/$defs/digest" },
        "target_facet": { "$ref": "#/$defs/text" },
        "target_value_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["checker_coordinate", "consumed_facets", "evidence_origin", "information_loss", "loss_map", "mechanism_id", "mechanism_profile_digest", "observations", "preservation_map", "producer_coordinate", "result", "schema_version", "source_digest", "source_frame_digest", "target_digest", "target_frame_digest", "translation_digest"],
      "properties": {
        "schema_version": { "const": "VSTD-RELATION-BOUNDARY-EVIDENCE-0.1" },
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "consumed_facets": { "$ref": "#/$defs/strings" },
        "evidence_origin": { "const": "MECHANISM_EXECUTION" },
        "information_loss": { "enum": ["NONE", "PRESENT"] },
        "loss_map": { "$ref": "#/$defs/strings" },
        "mechanism_id": { "$ref": "#/$defs/text" },
        "mechanism_profile_digest": { "$ref": "#/$defs/digest" },
        "observations": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/observation" } },
        "preservation_map": { "$ref": "#/$defs/mappings" },
        "producer_coordinate": { "$ref": "#/$defs/text" },
        "result": { "enum": ["ESTABLISHED", "REFUTED"] },
        "source_digest": { "$ref": "#/$defs/digest" },
        "source_frame_digest": { "$ref": "#/$defs/digest" },
        "target_digest": { "$ref": "#/$defs/digest" },
        "target_frame_digest": { "$ref": "#/$defs/digest" },
        "translation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["assumptions", "checker_coordinate", "checks", "consumed_facets", "declaration_digest", "evidence_digest", "information_loss", "loss_map", "mechanism_profile_digest", "preservation_map", "reason_codes", "residual_obligations", "result", "schema_version", "source_digest", "target_digest"],
      "properties": {
        "schema_version": { "const": "VSTD-RELATION-BOUNDARY-RECEIPT-0.1" },
        "declaration_digest": { "$ref": "#/$defs/digest" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "target_digest": { "$ref": "#/$defs/digest" },
        "evidence_digest": { "$ref": "#/$defs/digest" },
        "mechanism_profile_digest": { "$ref": "#/$defs/digest" },
        "checker_coordinate": { "$ref": "#/$defs/checker" },
        "result": { "enum": ["ESTABLISHED", "REFUTED", "UNKNOWN", "INVALID"] },
        "information_loss": { "enum": ["NONE", "PRESENT"] },
        "checks": { "type": "object" },
        "consumed_facets": { "$ref": "#/$defs/strings" },
        "preservation_map": { "$ref": "#/$defs/mappings" },
        "loss_map": { "$ref": "#/$defs/strings" },
        "reason_codes": { "$ref": "#/$defs/strings" },
        "residual_obligations": { "$ref": "#/$defs/strings" },
        "assumptions": { "$ref": "#/$defs/strings" }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_frame_id", "accepted_language", "canonical_records_required", "evidence_replay_required", "explicit_loss_required", "max_facets", "max_relation_artifact_bytes", "mechanism_id", "schema_version"],
      "properties": {
        "schema_version": { "const": "VSTD-RELATION-BOUNDARY-MECHANISM-PROFILE-0.1" },
        "accepted_frame_id": { "const": "CANONICAL-JSON-OBJECT-0.1" },
        "accepted_language": { "const": "CANONICAL_JSON_OBJECT" },
        "canonical_records_required": { "const": true },
        "evidence_replay_required": { "const": true },
        "explicit_loss_required": { "const": true },
        "max_facets": { "const": 64 },
        "max_relation_artifact_bytes": { "const": 1048576 },
        "mechanism_id": { "const": "canonical-json-facet-map-v1" }
      }
    }
  }
}
