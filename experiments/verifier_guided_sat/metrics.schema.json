{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Metrics for one trial of the verifier-guided Boolean satisfiability problem (SAT) experiment; status uses SAT, unsatisfiable (UNSAT), or UNKNOWN.",
  "properties": {
    "accepted": {"type": "boolean"},
    "candidate": {"type": ["object", "null"]},
    "clauses": {"type": ["integer", "null"], "minimum": 0},
    "conflicts": {"type": ["integer", "null"], "minimum": 0},
    "decisions": {"type": ["integer", "null"], "minimum": 0},
    "elapsed_ns": {"type": ["integer", "null"], "minimum": 0},
    "error": {"type": ["string", "null"]},
    "failed_routes": {"type": "integer", "minimum": 0},
    "false_acceptance": {"type": "boolean"},
    "final_unknown": {"type": "boolean"},
    "generate_and_check_equivalent": {"type": "boolean"},
    "lm_tokens_input": {"type": ["integer", "null"], "minimum": 0},
    "lm_tokens_output": {"type": ["integer", "null"], "minimum": 0},
    "native_verifier_calls": {"type": "integer", "minimum": 0},
    "propagations": {"type": ["integer", "null"], "minimum": 0},
    "repeated_routes": {"type": "integer", "minimum": 0},
    "routes": {"type": "integer", "minimum": 0},
    "status": {"enum": ["SAT", "UNSAT", "UNKNOWN", null]},
    "total_time_to_outcome_ns": {"type": "integer", "minimum": 0},
    "unsat_certificate_available": {"type": ["boolean", "null"]},
    "unsat_certificate_size": {"type": ["integer", "null"], "minimum": 0},
    "variables": {"type": ["integer", "null"], "minimum": 0},
    "vstd_reverification_errors": {"type": "array", "items": {"type": "string"}},
    "vstd_reverification_ns": {"type": "integer", "minimum": 0},
    "witness_size": {"type": ["integer", "null"], "minimum": 0}
  },
  "required": [
    "accepted",
    "failed_routes",
    "false_acceptance",
    "final_unknown",
    "generate_and_check_equivalent",
    "lm_tokens_input",
    "lm_tokens_output",
    "native_verifier_calls",
    "repeated_routes",
    "routes",
    "total_time_to_outcome_ns",
    "vstd_reverification_errors",
    "vstd_reverification_ns"
  ],
  "title": "Verifier-guided SAT experimental trial metrics",
  "type": "object"
}
